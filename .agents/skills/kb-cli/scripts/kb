    parser.add_argument("--lang", choices=LANG_CHOICES, help=argparse.SUPPRESS)
    parser.add_argument("--auto-commit", choices=AUTO_COMMIT_CHOICES, help=argparse.SUPPRESS)
    parser.add_argument("--auto-screen", choices=AUTO_SCREEN_CHOICES, help=argparse.SUPPRESS)
    parser.add_argument(
        "--auto-ingest-mode",
        dest="auto_ingest_mode",
        choices=LINK_AUTODRIVE_CHOICES,
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--discussion-style",
        dest="discussion_style",
        choices=DISCUSSION_STYLE_CHOICES,
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--persona-focus", help=argparse.SUPPRESS)
    parser.add_argument("--persona-resources", help=argparse.SUPPRESS)
    parser.add_argument("--persona-report", help=argparse.SUPPRESS)
    parser.add_argument("--persona-boundaries", help=argparse.SUPPRESS)
    parser.add_argument("--persona-term", choices=PERSONA_TERM_CHOICES, help=argparse.SUPPRESS)
    parser.add_argument("--quick-resource", help=argparse.SUPPRESS)
    parser.add_argument("--quick-constraint", dest="quick_constraints", action="append", help=argparse.SUPPRESS)
    parser.add_argument("--git-init", action="store_true", help=argparse.SUPPRESS)
    parser.set_defaults(handler=handle_init)


