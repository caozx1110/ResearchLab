@dataclass(frozen=True)
class CommandResult:
    argv: tuple[str, ...]
    returncode: int
    stdout: str = ""
    stderr: str = ""


@dataclass
class AgentProtocol:
    """Private, structured hand-off from the pseudo CLI to the runtime agent.

    Human stdout is deliberately not a transport for commands.  The protocol is
    written below ``kb/.runtime`` so owner-script diagnostics and exact next-step
    arguments remain available to the agent without leaking into the user surface.
    """

    verb: str
    status: str = "completed"
    exit_code: int = 0
    child_results: list[dict[str, object]] | None = None
    next_actions: list[dict[str, object]] | None = None
    details: dict[str, object] | None = None

    def as_dict(self) -> dict[str, object]:
        return {
            "schema": "kb-agent-protocol/v1",
            "verb": self.verb,
            "status": self.status,
            "exit_code": self.exit_code,
            "child_results": list(self.child_results or []),
            "next_actions": list(self.next_actions or []),
            "details": dict(self.details or {}),
        }


_ACTIVE_PROTOCOL: AgentProtocol | None = None
_ACTIVE_PUBLIC_VERB = ""

_DIAGNOSTIC_MODES = frozenset({"off", "errors-only", "developer"})
