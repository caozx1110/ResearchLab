def register_update(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("update", help="检查并在确认后更新 research skill")
    parser.add_argument("--apply", action="store_true", help=argparse.SUPPRESS)
    parser.set_defaults(handler=handle_update)


def register_resume(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("resume", help="恢复崩溃后未完成的知识库操作")
    parser.set_defaults(handler=handle_resume)


def register_restore(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("restore", help="恢复到指定操作之前的状态")
    parser.add_argument("op_id", metavar="<操作编号>", help="希望回到其之前状态的操作编号")
    parser.set_defaults(handler=handle_restore)


def register_reject(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser(
        "reject",
        help="把误建或不采纳的知识单元标记为已拒绝",
    )
    parser.add_argument("id", metavar="<单元编号>", help="要拒绝的知识单元编号")
    parser.add_argument("--reason", default="", help=argparse.SUPPRESS)
    parser.set_defaults(handler=handle_reject)


VERB_REGISTRARS: tuple[Callable[[argparse._SubParsersAction[argparse.ArgumentParser]], None], ...] = (
    register_help,
    register_init,
    register_doctor,
    register_update,
    register_add,
    register_ingest,
    register_review,
    register_status,
    register_next,
    register_find,
    register_recall,
    register_resume,
    register_undo,
    register_restore,
    register_reject,
)


def build_parser() -> argparse.ArgumentParser:
    parser = ConversationalArgumentParser(
        prog="kb",
        description="使用 kb 动词管理研究知识库；查看示例可使用 kb help。",
    )
    parser.add_argument("--root", default="", help=argparse.SUPPRESS)
    parser.add_argument("--agent-protocol", default="", help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest="command", required=True, metavar="<动词>")
    for register in VERB_REGISTRARS:
        register(subparsers)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    global _ACTIVE_PROTOCOL
    parser = build_parser()
    args = parser.parse_args(argv)
    root = find_project_root(DEFAULT_PROJECT_ROOT, explicit_root=args.root)
    handler: Handler = args.handler
    protocol = AgentProtocol(args.command) if str(args.agent_protocol or "").strip() else None
    _ACTIVE_PROTOCOL = protocol
    try:
        exit_code = handler(args, root)
    finally:
        _ACTIVE_PROTOCOL = None
    if protocol is not None:
        protocol.exit_code = int(exit_code)
        if exit_code != 0 and protocol.status == "completed":
            protocol.status = "error"
        write_agent_protocol(root, str(args.agent_protocol), protocol)
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
