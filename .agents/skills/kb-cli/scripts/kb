def research_python() -> str:
    return os.environ.get("RESEARCH_PYTHON") or sys.executable or "python3"


def agent_protocol_path(root: Path, requested: str) -> Path:
    runtime_root = (root / "kb" / ".runtime").resolve()
    candidate = Path(requested).expanduser()
    if not candidate.is_absolute():
        candidate = runtime_root / candidate
    candidate = candidate.resolve()
    try:
        candidate.relative_to(runtime_root)
    except ValueError as exc:
        raise SystemExit("Agent protocol destination must stay inside the KB runtime area.") from exc
    return candidate


def _record_protocol_child(result: CommandResult, relative_script: str, args: Sequence[str]) -> None:
    protocol = _ACTIVE_PROTOCOL
    if protocol is None:
        return
    if protocol.child_results is None:
        protocol.child_results = []
    protocol.child_results.append(
        {
            "owner": relative_script,
            "arguments": list(args),
            "returncode": result.returncode,
            "stdout": result.stdout,
            "stderr": result.stderr,
        }
    )


def _record_private_diagnostic_event(code: str, *, skill: str = "", operation: str = "") -> None:
    protocol = _ACTIVE_PROTOCOL
    if protocol is None:
        return
    if protocol.details is None:
        protocol.details = {}
    existing = protocol.details.get("diagnostic_events")
    events = existing if isinstance(existing, list) else []
    event: dict[str, str] = {"code": code}
    if skill:
        event["skill"] = skill
    if operation:
        event["operation"] = operation
    events.append(event)
    protocol.details["diagnostic_events"] = events


def _owner_skill(relative_script: str) -> str:
    parts = tuple(part for part in relative_script.replace("\\", "/").split("/") if part)
    if len(parts) >= 3 and parts[0:2] == (".agents", "skills"):
        candidate = parts[2]
        if re.fullmatch(r"[a-z0-9][a-z0-9-]*", candidate):
            return candidate
    return "unknown-owner"


def _capture_owner_failure(root: Path, relative_script: str, returncode: int) -> None:
    """Best-effort D1 capture with a deliberately narrow, redacted payload."""
    skill = _owner_skill(relative_script)
    operation = _ACTIVE_PUBLIC_VERB if _ACTIVE_PUBLIC_VERB in _PUBLIC_KB_VERB_ARITY else "owner-operation"
    capture = _capture_runtime_failure
    if capture is None:
        _record_private_diagnostic_event(
            "runtime-failure-capture-unavailable",
            skill=skill,
            operation=operation,
        )
        return
    try:
        capture(
            root,
            skill=skill,
            operation=operation,
            returncode=int(returncode),
            public_summary=_RUNTIME_FAILURE_PUBLIC_SUMMARY,
        )
    except Exception:  # noqa: BLE001 - diagnostics must never mask the owner result
        _record_private_diagnostic_event(
            "runtime-failure-capture-failed",
            skill=skill,
            operation=operation,
        )


def add_agent_action(action: str, **payload: object) -> None:
    protocol = _ACTIVE_PROTOCOL
    if protocol is None:
        return
    if protocol.next_actions is None:
        protocol.next_actions = []
    protocol.next_actions.append({"action": action, **payload})


def set_protocol_status(status: str, **details: object) -> None:
    protocol = _ACTIVE_PROTOCOL
    if protocol is None:
        return
    protocol.status = status
    if details:
        if protocol.details is None:
            protocol.details = {}
        protocol.details.update(details)


def write_agent_protocol(root: Path, requested: str, protocol: AgentProtocol) -> None:
    path = agent_protocol_path(root, requested)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(protocol.as_dict(), ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temporary, path)


