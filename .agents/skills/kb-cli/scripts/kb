def _public_operation_label(op_type: str) -> str:
    """Safe Chinese description of one journaled operation (never a path)."""
    normalized = str(op_type or "").strip()
    label = _OP_TYPE_PUBLIC_LABELS.get(normalized)
    if label:
        return label
    for prefix, prefix_label in _OP_TYPE_PREFIX_LABELS:
        if normalized.startswith(prefix):
            return prefix_label
    if normalized.endswith("-survey"):
        return "综述整理"
    return "知识库操作"


def _restorable_journal_entry(entry: Mapping[str, object]) -> bool:
    """Public projection of the journal's own root-business-operation rule."""
    op_id = str(entry.get("op_id") or "")
    if not op_id or str(entry.get("parent_op_id") or "") or str(entry.get("undone_by") or ""):
        return False
    if str(entry.get("root_op_id") or op_id) != op_id:
        return False
    if "undoable" in entry:
        return entry.get("undoable") is True
    targets = {str(path) for path in entry.get("target_paths", []) if str(path)}
    if targets and targets <= {".runtime/versioning-state.yaml"}:
        return False
    op_type = str(entry.get("op_type") or "")
    if op_type == "write_versioning_state" or op_type.startswith(("undo:", "restore:", "resume:")):
        return False
    return bool(entry.get("before_snapshots")) or bool(entry.get("before_digests"))


def _restore_catalog_entries(root: Path) -> list[dict]:
    entries = [entry for entry in committed_ops(root) if _restorable_journal_entry(entry)]
    entries.reverse()
    return entries[:_RESTORE_CATALOG_LIMIT]


def _public_operation_time(entry: Mapping[str, object]) -> str:
    try:
        epoch = int(entry.get("sequence_ns") or 0) / 1_000_000_000
    except (TypeError, ValueError):
        epoch = 0.0
    if epoch <= 0:
        return "时间未知"
    return time.strftime("%m-%d %H:%M", time.localtime(epoch))


def _journal_operation_label(root: Path, op_id: str) -> str:
    """Best-effort label lookup; never let a diagnostics read break recovery."""
    if not op_id:
        return ""
    try:
        for entry in committed_ops(root):
            if str(entry.get("op_id") or "") == op_id:
                return _public_operation_label(str(entry.get("op_type") or ""))
    except (SystemExit, OSError, RuntimeError, TypeError, ValueError):
        return ""
    return ""


_UNDO_OWNER_STDOUT_RE = re.compile(r"已撤销最近一次操作\s+(\S+)。")
_RESTORE_OWNER_STDOUT_RE = re.compile(r"已恢复到操作\s+(\S+)\s+之前的状态。")

# Owner recovery refusals that are already safe public Chinese one-liners
# (no paths, no ids, no flags). Anything else stays private.
_RECOVERY_SAFE_REFUSALS = (
    "目标在该操作完成后又被修改；为避免覆盖后续改动，已停止恢复。",
    "检测到未完成的知识库操作；请先使用 kb resume 完成恢复。",
    "只有已完成的操作可恢复；未完成操作只能通过 kb resume 自愈。",
    "未完成操作必须按从新到旧的顺序恢复；已停止恢复。",
    "恢复来源操作日志在执行前发生变化；已停止恢复。",
)


def _run_public_recovery(root: Path, action: str, action_args: Sequence[str]) -> int:
    result = forward_command(
        root,
        SCRIPT_BY_VERB["recovery"],
        [action, *action_args],
        stream=False,
    )
    if result.returncode != 0:
        private_diagnostic = f"{result.stdout}\n{result.stderr}"
        safe_refusal = next(
            (line for line in _RECOVERY_SAFE_REFUSALS if line in private_diagnostic),
            "",
        )
        if action == "restore" and (
            "Unknown operation:" in private_diagnostic or "找不到指定的操作日志" in private_diagnostic
        ):
            message = "没有找到对应的知识库操作；请检查编号后重试。"
        elif action == "undo" and "没有可撤销的已提交操作" in private_diagnostic:
            message = "目前没有可撤销的知识库操作。"
        elif safe_refusal:
            message = safe_refusal
        elif action == "undo":
            message = "知识库撤销未完成；详细诊断已保留给 Agent。"
        else:
            message = "知识库恢复未完成；详细诊断已保留给 Agent。"
        print(message, file=sys.stderr)
        return result.returncode

    if action == "resume":
        if "没有未完成操作需要恢复" in result.stdout:
            print("目前没有未完成操作需要恢复。")
        else:
            print("未完成的知识库操作已安全恢复。")
    elif action == "undo":
        matched = _UNDO_OWNER_STDOUT_RE.search(result.stdout)
        undone_op_id = matched.group(1) if matched else ""
        label = _journal_operation_label(root, undone_op_id)
        set_protocol_status(
            "completed",
            undone_op_id=undone_op_id,
            undone_operation_label=label or "知识库操作",
        )
        if label:
            print(f"已撤销：{label}。若还需要，可再次使用 kb undo 撤销更早的操作。")
        else:
            print("最近一次知识库操作已撤销。若还需要，可再次使用 kb undo 撤销更早的操作。")
    else:
        matched = _RESTORE_OWNER_STDOUT_RE.search(result.stdout)
        restored_op_id = matched.group(1) if matched else ""
        label = _journal_operation_label(root, restored_op_id)
        set_protocol_status(
            "completed",
            restored_op_id=restored_op_id,
            restored_operation_label=label or "知识库操作",
        )
        if label:
            print(f"知识库已恢复到「{label}」这次操作之前的状态。")
        else:
            print("知识库已恢复到指定操作之前的状态。")
    return 0


def handle_undo(args: argparse.Namespace, root: Path) -> int:
    del args
    return _run_public_recovery(root, "undo", [])


def handle_resume(args: argparse.Namespace, root: Path) -> int:
    del args
    return _run_public_recovery(root, "resume", [])


def _print_restore_catalog(root: Path) -> int:
    """Read-only public listing of recent restorable operations."""
    try:
        entries = _restore_catalog_entries(root)
    except SystemExit as exc:
        set_protocol_status("agent_action_required", restore_catalog_error=str(exc.code or "unavailable"))
        print("知识库操作清单暂时无法读取；详细诊断已保留给 Agent。", file=sys.stderr)
        return 1
    if not entries:
        set_protocol_status("completed", restorable_operation_count=0)
        print("目前没有可恢复的知识库操作。")
        return 0
    catalog: list[dict[str, object]] = []
    print("最近可恢复的知识库操作（最新在前）：")
    for index, entry in enumerate(entries, start=1):
        label = _public_operation_label(str(entry.get("op_type") or ""))
        moment = _public_operation_time(entry)
        print(f"{index}. {moment} · {label}")
        catalog.append(
            {
                "public_index": index,
                "op_id": str(entry.get("op_id") or ""),
                "op_type": str(entry.get("op_type") or ""),
                "label": label,
                "started_at": str(entry.get("started_at") or ""),
            }
        )
    print("需要恢复时请说：kb restore <编号>，会回到该操作之前的状态；编号以本清单为准。")
    set_protocol_status("completed", restorable_operation_count=len(catalog))
    add_agent_action(
        "present_restore_catalog",
        operations=catalog,
        apply={"verb": "restore", "input": "public_index_or_op_id"},
    )
    return 0


def handle_restore(args: argparse.Namespace, root: Path) -> int:
    requested = str(getattr(args, "op_id", "") or "").strip()
    if not requested:
        return _print_restore_catalog(root)
    if re.fullmatch(r"\d{1,3}", requested):
        try:
            entries = _restore_catalog_entries(root)
        except SystemExit as exc:
            set_protocol_status("agent_action_required", restore_catalog_error=str(exc.code or "unavailable"))
            print("知识库操作清单暂时无法读取；详细诊断已保留给 Agent。", file=sys.stderr)
            return 1
        index = int(requested)
        if index < 1 or index > len(entries):
            set_protocol_status(
                "agent_action_required",
                restore_index_error="out_of_range",
                restorable_operation_count=len(entries),
            )
            print("没有找到对应的知识库操作；可先运行不带编号的 kb restore 查看当前清单。", file=sys.stderr)
            return 1
        requested = str(entries[index - 1].get("op_id") or "")
    return _run_public_recovery(root, "restore", [requested])


def handle_reject(args: argparse.Namespace, root: Path) -> int:
    """Mark a mis-created / not-adopted unit as rejected (F1 cleanup exit).

    Pure dispatch: forwards to knowledge-base-manager's existing
    `promote --confirmation-status rejected` (the same reject path `kb review`
    uses). No reject logic is reimplemented here.
    """
    reject_args = ["promote", "--id", args.id, "--confirmation-status", "rejected"]
    reason = str(getattr(args, "reason", "") or "").strip()
    if reason:
        reject_args.extend(["--evidence", reason])
    result = forward_command(root, SCRIPT_BY_VERB["review"], reject_args, stream=False)
    public_id = _public_display_text(args.id, root, "编号已隐藏", 100)
    if result.returncode != 0:
        print(f"未能拒绝知识条目「{public_id}」；请检查编号后重试。", file=sys.stderr)
        return result.returncode
    set_protocol_status("completed", rejected_id=args.id)
    add_agent_action("undo_rejection", apply={"verb": "undo"})
    print(f"知识条目「{public_id}」已拒绝。若这是误操作，可使用 kb undo 撤销。")
    return 0


def _looks_like_repo_dir(path: Path) -> bool:
    """A local directory is a code checkout (repo), not a blog.

    Treat any directory as a repo; strengthen the signal when it carries a `.git`
    marker or a README alongside a source/config structure. The mere fact that a
    local reference resolves to a directory is enough to prefer `repo` over the
    `blog` fallback (F1: a cloned repo dir was mis-created as a blog unit).
    """
    try:
        if not path.is_dir():
            return False
    except OSError:
        return False
    return True


def infer_add_kind(source: str, root: Path | None = None) -> str:
    normalized = source.strip()
    lowered = normalized.lower()
    path_part = lowered.split("#", 1)[0].split("?", 1)[0]
    # Remote URLs / git refs: decide from the URL shape, never touch the filesystem.
    if lowered.startswith(("http://", "https://")):
        if "arxiv.org" in lowered or path_part.endswith(".pdf"):
            return "paper"
        if "huggingface.co/datasets/" in lowered:
            return "dataset"
        if "github.com" in lowered or "gitlab.com" in lowered or "bitbucket.org" in lowered:
            return "repo"
        return "blog"
    if lowered.startswith("git@") or lowered.endswith(".git"):
        return "repo"
    # Local reference: a directory (git checkout / source tree) is a repo, not a blog.
    candidate = Path(normalized).expanduser()
    probes = [candidate]
    if root is not None and not candidate.is_absolute():
        probes.insert(0, root / candidate)
    for probe in probes:
        if _looks_like_repo_dir(probe):
            return "repo"
        try:
            if probe.is_file():
                return "paper" if probe.suffix.lower() == ".pdf" else "blog"
        except OSError:
            continue
    # Unresolved local string: fall back to arxiv/pdf hints, else blog.
    if "arxiv.org" in lowered or path_part.endswith(".pdf"):
        return "paper"
    return "blog"


def _unsafe_local_source_result(source: str, root: Path) -> int | None:
    """Fail closed before an owner process can create identities or snapshots."""
    if source.strip().lower().startswith(("http://", "https://", "git@")):
        return None
    try:
        validate_local_source(root, source)
    except UnsafeLocalSourceError as exc:
        print("这份本地资料包含不安全的链接或文件类型，已停止入库；请改用不含符号链接的普通文件或目录。", file=sys.stderr)
        set_protocol_status("rejected_unsafe_source", reason=str(exc), source=source)
        return 2
    return None


def _remote_repo_snapshot_result(source: str, kind: str, *, verb: str) -> int | None:
    lowered = source.strip().lower()
    if kind != "repo" or not lowered.startswith(("http://", "https://", "git@")):
        return None
    print(
        "远程代码仓需要先建立安全的本地只读快照才能入库；当前没有创建知识条目。"
        "请让 AI 继续，它会获取快照后重试。",
        file=sys.stderr,
    )
    set_protocol_status("needs_local_repo_snapshot", source_kind="repo", source=source)
    add_agent_action(
        "localize_repo_source",
        source=source,
        retry_verb=verb,
    )
    return 1


def handle_add(args: argparse.Namespace, root: Path) -> int:
    unsafe_result = _unsafe_local_source_result(args.source, root)
    if unsafe_result is not None:
        return unsafe_result
    kind = args.kind or infer_add_kind(args.source, root)
    snapshot_result = _remote_repo_snapshot_result(args.source, kind, verb="add")
    if snapshot_result is not None:
        return snapshot_result
    result = forward_command(
        root,
        SCRIPT_BY_VERB["add"],
        ["add", "--kind", kind, "--source", args.source],
        stream=False,
    )
    if result.returncode != 0:
        print("资料未能加入知识库；详细诊断已保留给 Agent。", file=sys.stderr)
        return result.returncode
    emitted = emit_public_output(result.stdout, root)
    emitted = emit_public_output(result.stderr, root, error=True) or emitted
    if not emitted:
        print("资料已加入知识库。")
    return 0


# --------------------------------------------------------------------------- #
# ingest: chain the scriptable prefix of the ingestion pipeline (SSOT §7).      #
#                                                                              #
# `kb ingest <src>` runs intake add -> first analyzer prepare and STOPS there.  #
# For papers that first prepare is screening: the session agent must verify the #
# agent-authored paper_type before preparing the type-specific note. Scripts     #
# never auto-run verify because they cannot fill understanding.                  #
# --------------------------------------------------------------------------- #

# Governance ceiling for ingest safe auto-steps, mirroring research-orchestrator's
# GOVERNANCE_MAX_AUTO_STEPS. runtime-preferences.autonomy.auto_execute_scope may
# NARROW this but can never widen it; verify/confirm are never in the set.
INGEST_GOVERNANCE_MAX_AUTO_STEPS = frozenset({"screen", "build-index", "refresh", "generate-note"})

# Ordered ingest chain: (step, gating scope token). intake landing is a
# "screen"-class safe step; prepare (fillable skeleton) is a "generate-note"-class
# safe step. Walk in order; a narrowed scope stops the chain at the first gap.
INGEST_ANALYZER: dict[str, tuple[str, str, str]] = {
    "paper": (".agents/skills/paper-analyst/scripts/paper.py", "screen", "--paper-id"),
    "repo": (".agents/skills/repo-analyst/scripts/repo.py", "map-capability", "--repo-id"),
    "dataset": (".agents/skills/dataset-analyst/scripts/dataset.py", "profile", "--dataset-id"),
    "blog": (".agents/skills/blog-analyst/scripts/blog.py", "complete-note", "--blog-id"),
}


def effective_ingest_scope(root: Path) -> set[str]:
    """Configured auto_execute_scope intersected with the governance ceiling."""
    try:
        configured = load_runtime_preferences(root).get("autonomy", {}).get("auto_execute_scope", [])
    except Exception:  # noqa: BLE001
        configured = sorted(INGEST_GOVERNANCE_MAX_AUTO_STEPS)
    if not isinstance(configured, list):
        configured = sorted(INGEST_GOVERNANCE_MAX_AUTO_STEPS)
    return {str(item).strip() for item in configured if str(item).strip()} & set(INGEST_GOVERNANCE_MAX_AUTO_STEPS)


def _extract_ingest_unit_id(stdout: str) -> tuple[str, str]:
    """Parse (unit_id, status) from intake add stdout.

    status is "created" | "duplicate" | "unknown". Duplicate handling is
    state-aware: a source-only unit may continue to prepare, while an existing
    fill is preserved and resumed through the private AgentProtocol.
    """
    created = re.search(r"\[ok\] created\s+.*?/([^/\s]+)/record\.yaml", stdout)
    if created:
        return created.group(1), "created"
    duplicate = re.search(r"\[ok\] duplicate detected:\s*(\S+)", stdout)
    if duplicate:
        return duplicate.group(1), "duplicate"
    return "", "unknown"


_INGEST_FILL_ARTIFACTS = {
    "paper": "screening.yaml",
    "repo": "capability-fill.yaml",
    "dataset": "dataset-fill.yaml",
    "blog": "blog-fill.yaml",
}


def _duplicate_ingest_state(root: Path, kind: str, unit_id: str) -> tuple[str, Path | None]:
    """Return canonical workflow state and the expected current fill artifact."""
    path = record_path(root, kind, unit_id)
    record = load_yaml(path, default={})
    if not isinstance(record, dict) or not record:
        return "unknown", None
    state = record_workflow_state(record)
    unit_root = path.parent
    fill_path = unit_root / _INGEST_FILL_ARTIFACTS[kind]
    if kind == "paper":
        screening = load_yaml(fill_path, default={}) if fill_path.exists() else {}
        screening_status = str(screening.get("status") or "").strip().lower() if isinstance(screening, dict) else ""
        if screening_status == "verified":
            fill_path = unit_root / "note-fill.yaml"
    return state, fill_path


def _resume_duplicate_ingest(
    root: Path,
    *,
    kind: str,
    unit_id: str,
    public_unit_id: str,
) -> tuple[bool, tuple[str, str, str] | None]:
    """Preserve existing work and describe the safe continuation.

    Returns ``(handled, prepare_spec)``. ``prepare_spec`` is non-None only when
    no fill artifact exists and it is safe for the caller to create one.
    """
    state, fill_path = _duplicate_ingest_state(root, kind, unit_id)
    relative_script, verb, id_flag = INGEST_ANALYZER[kind]
    if state in {"source_ready", "awaiting_agent_fill"} and fill_path is not None and not fill_path.exists():
        if kind == "paper" and fill_path.name == "note-fill.yaml":
            return False, (relative_script, "complete-note", id_flag)
        return False, (relative_script, verb, id_flag)

    if state == "ready_for_review":
        print(f"知识条目 {public_unit_id} 已完成核验，现有内容保持不变；接下来只需你确认判断。")
        set_protocol_status("ready_for_review", unit_id=unit_id, source_kind=kind)
        add_agent_action("request_user_confirmation", unit_id=unit_id, source_kind=kind)
        return True, None
    if state == "done":
        print(f"知识条目 {public_unit_id} 已存在且流程已经完成，本次没有改动。")
        set_protocol_status("already_complete", unit_id=unit_id, source_kind=kind)
        return True, None
    if state == "failed_retryable":
        print(f"知识条目 {public_unit_id} 已存在，但上次处理尚未完成；现有内容保持不变，Agent 会检查后续恢复。")
        set_protocol_status("failed_retryable", unit_id=unit_id, source_kind=kind)
        add_agent_action("diagnose_retryable_ingest", unit_id=unit_id, source_kind=kind)
        return True, None

    if fill_path is not None and fill_path.exists():
        next_verb = "complete-note" if kind == "paper" and fill_path.name == "note-fill.yaml" else verb
        print(f"知识条目 {public_unit_id} 已有待补全或待核验内容，现有填写已保留；Agent 会从当前阶段继续。")
        set_protocol_status("agent_action_required", unit_id=unit_id, source_kind=kind, workflow_state=state)
        add_agent_action(
            "continue_existing_fill",
            unit_id=unit_id,
            source_kind=kind,
            owner=relative_script,
            arguments=[next_verb, id_flag, unit_id, "--phase", "verify"],
        )
        return True, None

    print(f"知识条目 {public_unit_id} 已存在；现有内容保持不变，Agent 会检查当前阶段后继续。")
    set_protocol_status("duplicate_needs_inspection", unit_id=unit_id, source_kind=kind, workflow_state=state)
    add_agent_action("inspect_existing_unit", unit_id=unit_id, source_kind=kind)
    return True, None


def handle_ingest(args: argparse.Namespace, root: Path) -> int:
    unsafe_result = _unsafe_local_source_result(args.source, root)
    if unsafe_result is not None:
        return unsafe_result
    kind = args.kind or infer_add_kind(args.source, root)
    snapshot_result = _remote_repo_snapshot_result(args.source, kind, verb="ingest")
    if snapshot_result is not None:
        return snapshot_result
    if kind not in INGEST_ANALYZER:
        print("暂时无法判断资料类型；请告诉我是论文、代码仓还是技术文章。")
        set_protocol_status("needs_user_input", inferred_kind=kind)
        add_agent_action("choose_source_kind", choices=list(INGEST_ANALYZER))
        return 2
    scope = effective_ingest_scope(root)

    # Step 1: intake add (safe step gated by "screen") — the scriptable half before
    # the agent fills. RESEARCH_INGEST_CHAIN tells intake the chain auto-continues.
    if "screen" not in scope:
        print("当前自动化偏好暂停了这次入库；如果你愿意，我可以继续。")
        set_protocol_status("paused_by_autonomy", source_kind=kind)
        add_agent_action(
            "run_owner_step_after_authorization",
            owner=SCRIPT_BY_VERB["add"],
            arguments=["add", "--kind", kind, "--source", args.source],
        )
        return 0

    intake = forward_command(
        root,
        SCRIPT_BY_VERB["add"],
        ["add", "--kind", kind, "--source", args.source],
        stream=False,
        extra_env={"RESEARCH_INGEST_CHAIN": "1"},
    )
    if intake.returncode != 0:
        print("资料未能加入知识库；详细诊断已保留给 Agent。", file=sys.stderr)
        return intake.returncode

    unit_id, status = _extract_ingest_unit_id(intake.stdout)
    public_unit_id = _public_display_text(unit_id, root, "编号已隐藏", 100) if unit_id else ""
    duplicate_prepare: tuple[str, str, str] | None = None
    if status == "duplicate":
        handled, duplicate_prepare = _resume_duplicate_ingest(
            root,
            kind=kind,
            unit_id=unit_id,
            public_unit_id=public_unit_id,
        )
        if handled:
            return 0
    if not unit_id:
        print("资料已交给入库流程，但暂时无法确认新条目编号；Agent 会检查详细结果。")
        set_protocol_status("error", source_kind=kind, reason="created unit id was not returned")
        return 1

    # Step 2: analyzer prepare (safe step gated by "generate-note") — produces the
    # fillable skeleton. NEVER verify (a script cannot fill understanding).
    if "generate-note" not in scope:
        paused_stage = "初筛准备" if kind == "paper" else "深读准备"
        print(f"资料已入库为 {public_unit_id}；当前自动化偏好暂停了{paused_stage}。")
        relative_script, verb, id_flag = INGEST_ANALYZER[kind]
        set_protocol_status("paused_by_autonomy", unit_id=unit_id, source_kind=kind)
        add_agent_action(
            "prepare_unit_after_authorization",
            owner=relative_script,
            arguments=[verb, id_flag, unit_id, "--phase", "prepare"],
        )
        return 0

    relative_script, verb, id_flag = duplicate_prepare or INGEST_ANALYZER[kind]
    prepare = forward_command(
        root,
        relative_script,
        [verb, id_flag, unit_id, "--phase", "prepare"],
        stream=False,
    )
    if prepare.returncode != 0:
        failed_stage = "初筛准备" if kind == "paper" else "深读准备"
        print(f"资料已入库，但{failed_stage}未完成；详细诊断已保留给 Agent。")
        set_protocol_status("error", unit_id=unit_id, source_kind=kind, stage="prepare")
        return prepare.returncode

    if kind == "paper" and verb == "screen":
        print(
            f"资料已入库并备好初筛骨架，条目编号是 {public_unit_id}。"
            "Agent 接下来会先用逐字证据确定论文类型，再生成对应的深读笔记；需要判断时再请你拍板。"
        )
    elif kind == "paper":
        print(
            f"已有资料已备好类型专属深读骨架，条目编号是 {public_unit_id}。"
            "Agent 接下来会补全逐字证据并校验；需要判断时再请你拍板。"
        )
    else:
        print(f"资料已入库并备好深读骨架，条目编号是 {public_unit_id}。Agent 接下来会补全逐字证据并校验；需要判断时再请你拍板。")
    verify_arguments = [verb, id_flag, unit_id, "--phase", "verify"]
    if kind == "paper" and verb == "screen":
        note_prepare_arguments = ["complete-note", id_flag, unit_id, "--phase", "prepare"]
        note_verify_arguments = ["complete-note", id_flag, unit_id, "--phase", "verify"]
        remaining_steps: list[dict[str, object]] = [
            {
                "step": "fill_grounded_screening",
                "source": "parse_cache",
                "requirements": [
                    "paper_type",
                    "worth_deep_reading",
                    "judgement_reason",
                    "relevance_to_current_research",
                    "verbatim_quote",
                    "locator",
                ],
            },
            {"step": "verify_screening", "owner": relative_script, "arguments": verify_arguments},
            {
                "step": "prepare_type_specific_note",
                "owner": relative_script,
                "arguments": note_prepare_arguments,
                "requires": "verified_screening",
            },
            {
                "step": "fill_grounded_elements",
                "source": "parse_cache",
                "element_set_source": "verified_screening.paper_type_or_method_system_fallback",
                "requirements": ["verbatim_quote", "locator"],
            },
            {
                "step": "verify_note",
                "owner": relative_script,
                "arguments": note_verify_arguments,
                "includes_configured_post_note_actions": True,
            },
        ]
    else:
        remaining_steps = [
            {
                "step": "fill_grounded_elements",
                "source": "parse_cache",
                "requirements": ["verbatim_quote", "locator"],
            },
            {"step": "verify", "owner": relative_script, "arguments": verify_arguments},
        ]
    remaining_steps.append(
        {
            "step": "request_user_confirmation",
            "fields": ["user_authorization", "authorization_source", "evidence"],
            "authorization_source": "user_message",
        }
    )
    set_protocol_status("agent_action_required", unit_id=unit_id, source_kind=kind)
    add_agent_action(
        "complete_grounded_ingest",
        unit_id=unit_id,
        source_kind=kind,
        prepare_output=prepare.stdout,
        steps=remaining_steps,
    )
    return 0


def bool_text(value: object, default: str = "true") -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    text = str(value or "").strip().lower()
    return text if text in AUTO_SCREEN_CHOICES else default


def language_text(value: object, default: str = "zh") -> str:
    text = str(value or "").strip().lower()
    if text.startswith("zh"):
        return "zh"
    if text.startswith("en"):
        return "en"
    return default


def runtime_pref_defaults(root: Path) -> dict[str, object]:
    preferences = load_runtime_preferences(root)
    identity = preferences.get("identity", {}) if isinstance(preferences.get("identity"), dict) else {}
    paper = preferences.get("paper", {}) if isinstance(preferences.get("paper"), dict) else {}
    versioning = preferences.get("versioning", {}) if isinstance(preferences.get("versioning"), dict) else {}
    autonomy = preferences.get("autonomy", {}) if isinstance(preferences.get("autonomy"), dict) else {}
    profile = load_yaml(config_root(root) / "user-profile.yaml", default={})
    profile_preferences = profile.get("preferences", {}) if isinstance(profile, dict) and isinstance(profile.get("preferences"), dict) else {}
    personalization = profile.get("personalization", {}) if isinstance(profile, dict) and isinstance(profile.get("personalization"), dict) else {}
    profile_resources = profile.get("resources", {}) if isinstance(profile, dict) else {}
    resources = dict(profile_resources) if isinstance(profile_resources, dict) else {}
    raw_constraints = profile.get("constraints", []) if isinstance(profile, dict) else []
    constraints = list(raw_constraints) if isinstance(raw_constraints, list) else []
    terminology_style = str(
        personalization.get("term_style")
        or profile_preferences.get("terminology_style")
        or "keep-en"
    ).strip()
    research_focus = str(
        personalization.get("research_focus")
        or profile_preferences.get("research_focus")
        or ""
    ).strip()
    resource_statement = str(
        resources.get("quick_setup")
        or personalization.get("resources")
        or ""
    ).strip()
    link_autodrive = str(autonomy.get("link_autodrive") or "ask_first").strip().lower()
    if link_autodrive not in LINK_AUTODRIVE_CHOICES:
        link_autodrive = "ask_first"
    discussion_style = str(personalization.get("discussion_style") or "adaptive").strip().lower()
    if discussion_style not in DISCUSSION_STYLE_CHOICES:
        discussion_style = "adaptive"
    return {
        "name": str(identity.get("default_confirmed_by") or "").strip(),
        "lang": language_text(profile_preferences.get("language_preference", "zh")),
        "terminology_style": terminology_style,
        "research_focus": research_focus,
        "resource_statement": resource_statement,
        "resources": resources,
        "constraints": constraints,
        "resources_and_constraints": {
            "resource_statement": resource_statement,
            "resources": resources,
            "constraints": constraints,
        },
        "auto_commit": str(versioning.get("auto_commit_mode") or "milestone").strip().lower(),
        "auto_screen": bool_text(paper.get("auto_screen_on_intake", True)),
        "link_autodrive": link_autodrive,
        "discussion_style": discussion_style,
    }


def public_init_defaults_summary(defaults: Mapping[str, object]) -> str:
    """Describe only allowlisted init defaults; never echo configuration text."""
    language_label = {
        "zh": "中文",
        "en": "英文",
    }.get(str(defaults.get("lang") or "").strip().lower(), "保留现有语言设置")
    commit_label = {
        "manual": "手动版本记录",
        "milestone": "里程碑版本记录",
        "aggressive": "高频版本记录",
    }.get(str(defaults.get("auto_commit") or "").strip().lower(), "保留现有版本记录设置")
    screening_label = {
        "true": "论文自动初筛开启",
        "false": "论文自动初筛关闭",
    }.get(str(defaults.get("auto_screen") or "").strip().lower(), "保留现有论文初筛设置")
    autodrive_label = {
        "ask_first": "丢链接后先轻量入库再询问是否深读",
        "auto_deep_read": "丢链接后自动深读到待确认笔记",
    }.get(str(defaults.get("link_autodrive") or "").strip().lower(), "保留现有链接处理档位")
    discussion_label = {
        "challenge": "讨论风格偏挑战",
        "refine": "讨论风格偏打磨",
        "adaptive": "讨论风格自适应",
    }.get(str(defaults.get("discussion_style") or "").strip().lower(), "保留现有讨论风格")
    return (
        "选择“默认即可”会保留当前设置："
        f"{language_label}、{commit_label}、{screening_label}、{autodrive_label}、{discussion_label}。"
    )


def config_set_profile_command(key: str, value: str) -> tuple[str, Sequence[str]]:
    return (SCRIPT_BY_VERB["init_config"], ["set", "--key", key, "--value", value])


def config_set_runtime_pref_command(section: str, key: str, value: str) -> tuple[str, Sequence[str]]:
    return (
        SCRIPT_BY_VERB["init_config"],
        ["set-runtime-pref", "--section", section, "--key", key, "--value", value],
    )


_MISSING_CONFIG_VALUE = object()


def _nested_config_value(payload: object, dotted_key: str) -> object:
    current = payload
    for key in (part for part in dotted_key.split(".") if part):
        if not isinstance(current, dict) or key not in current:
            return _MISSING_CONFIG_VALUE
        current = current[key]
    return current


def _parsed_config_value(raw: object) -> object:
    text = str(raw).strip()
    if text.lower() in {"true", "false"}:
        return text.lower() == "true"
    if text.lower() == "null":
        return None
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return raw


def _append_profile_update(
    commands: list[tuple[str, Sequence[str]]],
    profile: object,
    key: str,
    value: object,
) -> None:
    if _nested_config_value(profile, key) != _parsed_config_value(value):
        commands.append(config_set_profile_command(key, str(value)))


def _append_runtime_update(
    commands: list[tuple[str, Sequence[str]]],
    preferences: object,
    section: str,
    key: str,
    value: object,
) -> None:
    if _nested_config_value(preferences, f"{section}.{key}") != _parsed_config_value(value):
        commands.append(config_set_runtime_pref_command(section, key, str(value)))


def build_init_pref_commands(*, name: str, lang: str, auto_commit: str, auto_screen: str) -> list[tuple[str, Sequence[str]]]:
    return [
        config_set_runtime_pref_command("identity", "default_confirmed_by", name),
        config_set_profile_command("preferences.language_preference", lang),
        config_set_runtime_pref_command("versioning", "auto_commit_mode", auto_commit),
        config_set_runtime_pref_command("paper", "auto_screen_on_intake", auto_screen),
    ]


def build_headless_init_pref_commands(
    args: argparse.Namespace,
    root: Path,
) -> list[tuple[str, Sequence[str]]] | None:
    persona_values = [
        ("personalization.research_focus", getattr(args, "persona_focus", None)),
        ("personalization.resources", getattr(args, "persona_resources", None)),
        ("personalization.reporting_style", getattr(args, "persona_report", None)),
        ("personalization.collaboration_boundaries", getattr(args, "persona_boundaries", None)),
        ("personalization.term_style", getattr(args, "persona_term", None)),
    ]
    if (
        args.name is None
        and args.lang is None
        and args.auto_commit is None
        and args.auto_screen is None
        and getattr(args, "auto_ingest_mode", None) is None
        and getattr(args, "discussion_style", None) is None
        and getattr(args, "quick_resource", None) is None
        and getattr(args, "quick_constraints", None) is None
        and all(value is None for _, value in persona_values)
    ):
        return None
    commands: list[tuple[str, Sequence[str]]] = []
    profile = load_yaml(config_root(root) / "user-profile.yaml", default={})
    preferences = load_runtime_preferences(root)
    if args.name is not None:
        name = str(args.name or "").strip()
        if not name:
            raise SystemExit("确认人姓名不能为空。")
        if is_ai_signer(name):
            raise SystemExit("确认人必须是真实用户，不能使用 AI 工具名称。")
        _append_runtime_update(commands, preferences, "identity", "default_confirmed_by", name)
    if args.lang is not None:
        _append_profile_update(commands, profile, "preferences.language_preference", args.lang)
    if args.auto_commit is not None:
        _append_runtime_update(commands, preferences, "versioning", "auto_commit_mode", args.auto_commit)
    if args.auto_screen is not None:
        _append_runtime_update(commands, preferences, "paper", "auto_screen_on_intake", args.auto_screen)
    # Both interaction fields share research-config-manager's canonical
    # `set-interaction` write path (I4): autonomy.link_autodrive lives in the
    # runtime preferences, personalization.discussion_style in the profile.
    interaction_flags: list[str] = []
    auto_ingest_mode = getattr(args, "auto_ingest_mode", None)
    if auto_ingest_mode is not None and _nested_config_value(
        preferences, "autonomy.link_autodrive"
    ) != _parsed_config_value(auto_ingest_mode):
        interaction_flags.extend(["--auto-ingest-mode", str(auto_ingest_mode)])
    discussion_style = getattr(args, "discussion_style", None)
    if discussion_style is not None and _nested_config_value(
        profile, "personalization.discussion_style"
    ) != _parsed_config_value(discussion_style):
        interaction_flags.extend(["--discussion-style", str(discussion_style)])
    if interaction_flags:
        commands.append((SCRIPT_BY_VERB["init_config"], ["set-interaction", *interaction_flags]))
    if getattr(args, "quick_resource", None) is not None:
        resource_statement = str(args.quick_resource or "").strip()
        if not resource_statement:
            raise SystemExit("资源说明不能为空。")
        _append_profile_update(commands, profile, "resources.quick_setup", resource_statement)
    quick_constraints = getattr(args, "quick_constraints", None)
    if quick_constraints is not None:
        profile = load_yaml(config_root(root) / "user-profile.yaml", default={})
        raw_existing = profile.get("constraints", []) if isinstance(profile, dict) else []
        existing = list(raw_existing) if isinstance(raw_existing, list) else []
        merged = list(existing)
        seen = {
            str(value).strip()
            for value in existing
            if isinstance(value, str) and str(value).strip()
        }
        for raw_constraint in quick_constraints:
            constraint = str(raw_constraint or "").strip()
            if not constraint:
                raise SystemExit("重要约束不能为空。")
            if constraint not in seen:
                merged.append(constraint)
                seen.add(constraint)
        if merged != existing:
            _append_profile_update(
                commands,
                profile,
                "constraints",
                json.dumps(merged, ensure_ascii=False),
            )
    for key, value in persona_values:
        if value is not None:
            _append_profile_update(commands, profile, key, value)
    return commands


def _mapping_has_shape(payload: object, required: object) -> bool:
    if not isinstance(payload, dict) or not isinstance(required, dict):
        return False
    return all(
        key in payload
        and (
            not isinstance(required_value, dict)
            or _mapping_has_shape(payload[key], required_value)
        )
        for key, required_value in required.items()
    )


def _readable_mapping(path: Path) -> dict[str, object] | None:
    try:
        payload = load_yaml(path, default=None)
    except Exception:  # noqa: BLE001 - malformed config means init must repair
        return None
    return payload if isinstance(payload, dict) and payload else None


def _readable_text(path: Path) -> bool:
    try:
        return path.is_file() and bool(path.read_text(encoding="utf-8").strip())
    except (OSError, UnicodeError):
        return False


def workspace_init_complete(root: Path) -> bool:
    """Return whether plain ``kb init`` can be a strict no-churn no-op."""
    kb = kb_root(root)
    required_directories = [
        kb / "units" / unit_dir
        for unit_dir in ("papers", "repos", "datasets", "blogs", "ideas", "experiments")
    ] + [
        kb / "programs",
        kb / "user" / "reading-lists",
        kb / "user" / "report-materials",
        kb / "config",
        kb / "synthesis" / "source-search",
        kb / "raw",
        kb / "output",
        kb / ".runtime",
    ]
    if not all(path.is_dir() for path in required_directories):
        return False

    required_text_files = [
        kb / ".gitignore",
        kb / "index.md",
        kb / "config" / "research-settings.md",
        kb / "user" / "navigation.md",
        kb / "user" / "current-state.md",
    ]
    if not all(_readable_text(path) for path in required_text_files):
        return False

    index_payload = _readable_mapping(kb / "index.yaml")
    taxonomy = _readable_mapping(kb / "config" / "topic-taxonomy.yaml")
    pools = _readable_mapping(kb / "config" / "candidate-pools.yaml")
    runtime = _readable_mapping(kb / "config" / "runtime-preferences.yaml")
    profile = _readable_mapping(kb / "config" / "user-profile.yaml")
    if None in (index_payload, taxonomy, pools, runtime, profile):
        return False
    if not _mapping_has_shape(runtime, default_runtime_preferences()):
        return False
    required_profile_shape = {
        "id": None,
        "status": None,
        "generated_by": None,
        "generated_at": None,
        "inputs": None,
        "confidence": None,
        "preferences": {"language_preference": None},
        "resources": None,
        "constraints": None,
        "governance": {
            "default_candidate_pools": None,
            "topic_overrides": None,
            "tag_overrides": None,
        },
        "history": None,
    }
    return _mapping_has_shape(profile, required_profile_shape)


def run_init_prerequisites(root: Path) -> int:
    return run_forwarded(
        root,
        [
            (SCRIPT_BY_VERB["init_kb"], ["init"]),
            (SCRIPT_BY_VERB["init_config"], ["init"]),
        ],
        stream=False,
    )


def handle_init(args: argparse.Namespace, root: Path) -> int:
    commands = build_headless_init_pref_commands(args, root)
    initialized = 0 if workspace_init_complete(root) else run_init_prerequisites(root)
    if initialized != 0:
        print("知识库初始化未完成；详细诊断已保留给 Agent。", file=sys.stderr)
        return initialized

    if commands is not None:
        written = run_forwarded(root, commands, stream=False)
        if written != 0:
            print("基础偏好未能保存；详细诊断已保留给 Agent。", file=sys.stderr)
            return written

    if args.git_init:
        git_initialized = run_forwarded(
            root,
            [(SCRIPT_BY_VERB["init_kb"], ["git-init"])],
            stream=False,
        )
        if git_initialized != 0:
            print("版本记录未能启用；详细诊断已保留给 Agent。", file=sys.stderr)
            return git_initialized

    defaults = runtime_pref_defaults(root)
    if not defaults["name"] or is_ai_signer(defaults["name"]):
        print(
            "知识库基础结构已准备好，现在可以开始使用。是否花约 1 分钟完成快速设置？"
            "选“现在设置”会在同一回合一起确认：真实署名、语言与术语、研究方向、资源与约束，"
            "以及丢链接后的处理档位（先询问再深读 / 自动深读）和讨论风格（挑战 / 打磨 / 自适应）。"
            "请回复“现在设置”（推荐）或“先跳过”；以后也可以直接说“补充我的研究偏好”。"
            f"{public_init_defaults_summary(defaults)}"
            "第一次确认研究判断前仍会询问真实署名。"
        )
        set_protocol_status("ready_with_optional_setup", initialized=True)
        add_agent_action(
            "offer_init_preferences",
            choices=[
                {"id": "configure_now", "label": "现在设置", "recommended": True},
                {"id": "defer", "label": "先跳过", "writes_preferences": False},
            ],
            quick_fields=[
                "human_name",
                "language_and_terminology",
                "research_focus",
                "resources_and_constraints",
                "link_autodrive",
                "discussion_style",
            ],
            defaults=defaults,
            required_before={"judgement_confirmation": ["human_name"]},
            apply={
                "verb": "init",
                "mode": "headless",
                "field_inputs": {
                    "human_name": {"input": "--name"},
                    "language": {"input": "--lang", "choices": list(LANG_CHOICES)},
                    "terminology_style": {
                        "input": "--persona-term",
                        "choices": list(PERSONA_TERM_CHOICES),
                    },
                    "research_focus": {"input": "--persona-focus"},
                    "resource_statement": {"input": "--quick-resource"},
                    "constraints": {
                        "input": "--quick-constraint",
                        "repeatable": True,
                        "merge": "append_deduplicate",
                    },
                    "link_autodrive": {
                        "input": "--auto-ingest-mode",
                        "choices": list(LINK_AUTODRIVE_CHOICES),
                        "default": "ask_first",
                        "canonical": {
                            "owner": "research-config-manager",
                            "command": "set-interaction",
                            "store": "runtime-preferences",
                            "key": "autonomy.link_autodrive",
                        },
                    },
                    "discussion_style": {
                        "input": "--discussion-style",
                        "choices": list(DISCUSSION_STYLE_CHOICES),
                        "default": "adaptive",
                        "canonical": {
                            "owner": "research-config-manager",
                            "command": "set-interaction",
                            "store": "user-profile",
                            "key": "personalization.discussion_style",
                        },
                    },
                },
            },
            defer={
                "continue_with_defaults": True,
                "writes_preferences": False,
                "resume_phrases": ["补充我的研究偏好", "kb init"],
            },
        )
    else:
        print("知识库和基础偏好已准备好。")
        set_protocol_status("completed", initialized=True, preferences=defaults)
    if not args.git_init:
        add_agent_action("offer_version_history", apply={"verb": "init", "git_init": True})
    return 0


def build_review_list_args(fuzzy: str | None) -> list[str]:
    fuzzy_text = (fuzzy or "").strip()
    fuzzy_kind = REVIEW_KIND_ALIASES.get(fuzzy_text.casefold(), "")
    if not fuzzy_text:
        return ["review-queue"]
    if fuzzy_kind:
        return ["review-queue", "--kind", fuzzy_kind]
    return ["query", "--query", fuzzy_text, "--confirmation-status", "pending_user_confirmation"]


def _review_unit_records(root: Path) -> dict[tuple[str, str], dict]:
    records: dict[tuple[str, str], dict] = {}
    duplicates: set[tuple[str, str]] = set()
    for record in iter_records(root):
        key = (str(record.get("kind") or ""), str(record.get("id") or ""))
        if not all(key):
            continue
        if key in records:
            duplicates.add(key)
            continue
        records[key] = record
    for key in duplicates:
        records.pop(key, None)
    return records


def _review_unit_titles(root: Path) -> dict[tuple[str, str], str]:
    return {
        key: str(record.get("title") or "")
        for key, record in _review_unit_records(root).items()
    }


def load_review_records(root: Path, fuzzy: str | None) -> list[dict]:
    """Compatibility projection of only the canonical ready unit-card set."""
    titles = _review_unit_titles(root)
    records: list[dict] = []
    for card in discover_pending_judgements(root):
        subject = card.get("subject") if isinstance(card.get("subject"), Mapping) else {}
        kind = str(subject.get("kind") or "")
        subject_id = str(subject.get("id") or "")
        if kind not in PUBLIC_KIND_LABELS:
            continue
        title = titles.get((kind, subject_id), "")
        matched, _reason = _review_card_match(card, fuzzy, title=title)
        if matched:
            records.append(_review_card_record(card, title=title))
    return records


_PUBLIC_CLAIM_TYPE_LABELS = {
    "fact": "事实",
    "inference": "推断",
    "evaluation": "评价",
    "user_opinion": "用户观点",
}

_PUBLIC_REVIEW_LIMIT = 3
_REVIEW_SNAPSHOT_SCHEMA = "kb-review-snapshot/v2"
_REVIEW_SNAPSHOT_TTL_SECONDS = 24 * 60 * 60
_REVIEW_SNAPSHOT_TOMBSTONE_GRACE_SECONDS = 24 * 60 * 60
_REVIEW_SNAPSHOT_GC_SCAN_LIMIT = 256
_REVIEW_SNAPSHOT_TOKEN_RE = re.compile(r"[0-9a-f]{32}")
_SIDE_JUDGEMENT_KIND_LABELS = {
    "program_decision": "研究决策",
    "idea_discussion_conclusion": "想法讨论结论",
    "method_selection": "方法仓库选择",
    "survey_judgement": "文献综述",
}
_REVIEW_PRIORITY = {"critical": 4, "high": 3, "normal": 2, "low": 1}


class ReviewSnapshotError(ValueError):
    """Stable internal failure class for the one-time public review adapter."""

    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code


@dataclass(frozen=True)
class ReviewSnapshotLease:
    """Pure-read binding for one displayed review decision set."""

    token: str
    protocol_relative_path: str
    review_items: tuple[dict[str, object], ...]
    registry_path: Path


def _review_card_record(card: Mapping[str, object], *, title: str = "") -> dict[str, object]:
    """Project an internal side-artifact card into the existing review renderer."""
    subject = card.get("subject")
    subject = subject if isinstance(subject, Mapping) else {}
    kind = str(subject.get("kind") or "")
    claims = card.get("claims")
    claims = claims if isinstance(claims, list) else []
    information_types = sorted(
        {
            str(claim.get("claim_type") or "")
            for claim in claims
            if isinstance(claim, Mapping) and str(claim.get("claim_type") or "")
        }
    )
    substance = card.get("substance")
    substance = dict(substance) if isinstance(substance, Mapping) else {}
    return {
        "id": str(subject.get("id") or ""),
        "kind": kind,
        "title": title or _SIDE_JUDGEMENT_KIND_LABELS.get(kind, "跨流程判断"),
        "priority": str(card.get("priority") or "normal"),
        "updated_at": str(card.get("updated_at") or ""),
        "confirmation_status": "pending_user_confirmation",
        "needs_human_confirmation": True,
        "information_types": [*information_types, "unverified"],
        "source": {"kind": "ai"},
        "payload": {**substance, "claims": claims, "verification": dict(card.get("verification") or {})},
    }


def _review_card_match(
    card: Mapping[str, object],
    fuzzy: str | None,
    *,
    title: str = "",
) -> tuple[bool, str]:
    query = str(fuzzy or "").strip().casefold()
    if not query:
        return True, ""
    subject = card.get("subject")
    subject = subject if isinstance(subject, Mapping) else {}
    kind = str(subject.get("kind") or "").casefold()
    kind_filter = REVIEW_KIND_ALIASES.get(query)
    if kind_filter:
        return kind == kind_filter, "kind_alias" if kind == kind_filter else ""
    if query in str(title or "").casefold():
        return True, "title"
    if query in str(subject.get("id") or "").casefold():
        return True, "public_id"
    claims = card.get("claims")
    claims = claims if isinstance(claims, list) else []
    if any(
        query in str(claim.get("text") or "").casefold()
        for claim in claims
        if isinstance(claim, Mapping)
    ):
        return True, "confirmable_claim"
    return False, ""


def _review_match_public_reason(reason: str) -> str:
    return {
        "kind_alias": "资料类型",
        "title": "标题",
        "public_id": "公开编号",
        "confirmable_claim": "可确认判断正文",
    }.get(reason, "")


def _review_sort_key(record: Mapping[str, object]) -> tuple[object, ...]:
    priority = str(record.get("priority") or "normal").strip().casefold()
    updated_at = str(record.get("updated_at") or record.get("timestamp") or "").strip()
    return (
        -_REVIEW_PRIORITY.get(priority, _REVIEW_PRIORITY["normal"]),
        updated_at or "9999-12-31T23:59:59Z",
        str(record.get("id") or ""),
    )


def _review_decision_routes(
    record: Mapping[str, object],
    card: Mapping[str, object] | None,
) -> dict[str, object]:
    kind = str(record.get("kind") or "")
    subject_id = str(record.get("id") or "")
    display = {
        "kind": kind,
        "title": str(record.get("title") or ""),
    }
    if kind in PUBLIC_KIND_LABELS:
        routes = {
            "subject": {"kind": kind, "id": subject_id, "owner": "knowledge-base-manager"},
            "display": display,
            "confirm_route": {
                "owner": "knowledge-base-manager",
                "action": "confirm",
                "id": subject_id,
            },
            "reject_route": {
                "owner": "knowledge-base-manager",
                "action": "promote",
                "id": subject_id,
                "confirmation_status": "rejected",
            },
        }
        routes["snapshot_binding"] = judgement_snapshot_binding(
            dict(record),
            owner="knowledge-base-manager",
            path=record_path(Path("."), kind, subject_id).as_posix(),
        )
        return routes
    raw_subject = card.get("subject") if isinstance(card, Mapping) else {}
    subject = dict(raw_subject) if isinstance(raw_subject, Mapping) else {"kind": kind, "id": subject_id}
    raw_confirm = card.get("confirm_route") if isinstance(card, Mapping) else {}
    raw_confirm = raw_confirm if isinstance(raw_confirm, Mapping) else {}
    owner = str(raw_confirm.get("owner") or subject.get("owner") or "")
    if kind == "program_decision":
        program_id = str(raw_confirm.get("program_id") or "")
        confirm_route = {
            "owner": owner or "research-orchestrator",
            "action": "confirm-decision",
            "program_id": program_id,
            "decision_id": subject_id,
        }
        reject_route = {
            "owner": owner or "research-orchestrator",
            "action": "reject-decision",
            "program_id": program_id,
            "decision_id": subject_id,
        }
    elif kind == "idea_discussion_conclusion":
        idea_id = str(raw_confirm.get("idea_id") or "")
        confirm_route = {
            "owner": owner or "idea-workbench",
            "action": "discuss",
            "phase": "confirm",
            "idea_id": idea_id,
            "conclusion_id": subject_id,
        }
        reject_route = {
            "owner": owner or "idea-workbench",
            "action": "discuss",
            "phase": "reject",
            "idea_id": idea_id,
            "conclusion_id": subject_id,
        }
    elif kind == "method_selection":
        program_id = str(raw_confirm.get("program_id") or "")
        idea_id = str(raw_confirm.get("idea_id") or "")
        confirm_route = {
            "owner": owner or "method-designer",
            "action": "confirm-selection",
            "program_id": program_id,
            "idea_id": idea_id,
        }
        reject_route = {
            "owner": owner or "method-designer",
            "action": "reject-selection",
            "program_id": program_id,
            "idea_id": idea_id,
        }
    else:
        confirm_route = dict(raw_confirm)
        reject_route = {**confirm_route, "action": "reject"}
    snapshot_binding = card.get("snapshot_binding") if isinstance(card, Mapping) else {}
    snapshot_binding = dict(snapshot_binding) if isinstance(snapshot_binding, Mapping) else {}
    return {
        "subject": subject,
        "display": display,
        "confirm_route": confirm_route,
        "reject_route": reject_route,
        "snapshot_binding": snapshot_binding,
    }


_SIDE_SUBSTANCE_FIELDS = {
    "program_decision": (
        ("decision", "text", "决策内容"),
        ("decision", "rationale", "决策理由"),
        ("decision", "stage", "适用阶段"),
        ("decision", "alternatives", "备选方案"),
    ),
    "idea_discussion_conclusion": (
        ("discussion_conclusion", "text", "讨论结论"),
        ("discussion_conclusion", "reviewer", "结论撰写者"),
    ),
    "method_selection": (
        ("method_selection", "proposed_repo_id", "拟选代码仓"),
        ("method_selection", "selected_repo_id", "确认后代码仓"),
        ("method_selection", "selection_reason", "选择理由"),
    ),
}


def _public_side_substance(record: Mapping[str, object], root: Path) -> tuple[str, list[dict[str, str]]]:
    kind = str(record.get("kind") or "")
    fields = _SIDE_SUBSTANCE_FIELDS.get(kind)
    if fields is None:
        return "ready", []
    payload = record.get("payload")
    payload = payload if isinstance(payload, Mapping) else {}
    rows: list[dict[str, str]] = []
    for section, field, label in fields:
        section_value = payload.get(section)
        if not isinstance(section_value, Mapping):
            continue
        value = section_value.get(field)
        if value in (None, "", [], {}):
            continue
        if isinstance(value, list) and all(not isinstance(item, (dict, list, tuple, set)) for item in value):
            raw_text = "；".join(str(item) for item in value)
        elif isinstance(value, (str, int, float, bool)):
            raw_text = str(value)
        else:
            return "unsafe", []
        text = _render_public_claim_text(raw_text, root)
        if text is None or len(text) > _PUBLIC_CLAIM_TEXT_HARD_CAP:
            return "unsafe", []
        rows.append({"label": label, "text": text})
    if not rows:
        return "invalid", []
    return "ready", rows


def public_review_projection(record: dict, root: Path) -> dict[str, object]:
    """Project the full confirmation receipt scope, classifying any block."""
    payload = record.get("payload")
    payload = payload if isinstance(payload, dict) else {}
    raw_claims = payload.get("claims")
    track = confirmation_track(record)
    fact_track = track == "fact"
    if raw_claims in (None, []):
        if not fact_track:
            return {"status": "invalid", "track": track, "claims": []}
        kind = PUBLIC_KIND_LABELS.get(str(record.get("kind") or ""), "知识资料")
        raw_summary = str(record.get("summary") or "").strip()
        if raw_summary:
            fallback = "该事实信息需由 Agent 安全解释"
            fact_summary = _public_display_text(raw_summary, root, fallback, 240)
            if fact_summary == fallback:
                return {"status": "unsafe", "track": "fact", "claims": []}
        else:
            fallback = "该事实信息需由 Agent 安全解释"
            title = _public_display_text(record.get("title") or "", root, fallback, 160)
            if title == fallback:
                return {"status": "unsafe", "track": "fact", "claims": []}
            fact_summary = f"资料标题为「{title}」，类型为{kind}。"
        return {
            "status": "ready",
            "track": "fact",
            "claims": [],
            "fact_summary": fact_summary,
        }
    if not isinstance(raw_claims, list) or any(not isinstance(item, dict) for item in raw_claims):
        return {"status": "invalid", "track": "judgement", "claims": []}

    canonical_claims = confirmation_claims(record)
    if len(canonical_claims) != len(raw_claims):
        return {"status": "invalid", "track": track, "claims": []}
    if validate_claims(canonical_claims):
        return {"status": "invalid", "track": track, "claims": []}
    judgement_track = track == "judgement"
    projected: list[dict[str, object]] = []
    unsafe_placeholder = "该内容需由 Agent 安全解释"
    structurally_invalid = False
    unsafe = False
    for claim in canonical_claims:
        status = str(claim.get("confirmation_status") or "").strip().lower()
        claim_id = str(claim.get("id") or "").strip()
        claim_type = str(claim.get("claim_type") or "").strip()
        raw_text = str(claim.get("text") or "").strip()
        refs = claim.get("evidence_refs")
        if (
            status not in CLAIM_CONFIRMATION_VALUES
            or not claim_id
            or claim_type not in _PUBLIC_CLAIM_TYPE_LABELS
            or not raw_text
            or not isinstance(refs, list)
            or any(not isinstance(ref, dict) for ref in refs)
        ):
            structurally_invalid = True
            continue
        quotes = [str(ref.get("quote") or "").strip() for ref in refs]
        if (judgement_track and not quotes) or any(not quote for quote in quotes):
            structurally_invalid = True
            continue
        text = _render_public_claim_text(raw_text, root)
        evidence_text = _sanitize_public_text(quotes[0], root) if quotes else ""
        if (
            text is None
            or len(text) > _PUBLIC_CLAIM_TEXT_HARD_CAP
            or (quotes and evidence_text is None)
        ):
            unsafe = True
            continue
        evidence = _bounded_public_text(evidence_text, 160) if evidence_text else ""
        projected.append(
            {
                "type_label": _PUBLIC_CLAIM_TYPE_LABELS[claim_type],
                "text": text,
                "evidence": evidence,
                "extra_evidence_count": len(quotes) - 1,
            }
        )
    if structurally_invalid:
        return {"status": "invalid", "track": track, "claims": []}
    if unsafe:
        return {"status": "unsafe", "track": track, "claims": []}
    if len(projected) != len(canonical_claims):
        return {"status": "invalid", "track": track, "claims": []}
    substance_status, substance = _public_side_substance(record, root)
    if substance_status != "ready":
        return {"status": substance_status, "track": track, "claims": []}
    return {
        "status": "ready",
        "track": track,
        "claims": projected,
        "fact_summary": "",
        "substance": substance,
    }


def review_display_preference_context(review_items: Sequence[Mapping[str, object]]) -> dict[str, object]:
    """Canonical, content-bound inputs for the optional review display receipt."""
    serialized = json.dumps(
        list(review_items),
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return {
        "review_snapshot_digest": hashlib.sha256(serialized).hexdigest(),
        "displayed_count": len(review_items),
        "hard_display_cap": _PUBLIC_REVIEW_LIMIT,
    }


def review_display_density(preferences: Mapping[str, object]) -> str:
    """Map only an explicitly selected reporting style to display density."""
    values = preferences.get("values_by_path")
    values = values if isinstance(values, Mapping) else {}
    reporting_style = str(values.get("profile.personalization.reporting_style") or "").strip().casefold()
    if reporting_style in {"concise", "compact", "brief", "简洁", "精简"}:
        return "compact"
    if reporting_style in {"detailed", "expanded", "verbose", "详细", "展开"}:
        return "expanded"
    return "standard"


def print_review_item(
    record: dict,
    projection: Mapping[str, object],
    root: Path,
    *,
    density: str = "standard",
    match_reason: str = "",
) -> None:
    raw_unit_id = str(record.get("id") or "-")
    unit_id = _public_display_text(raw_unit_id, root, "编号已隐藏", 100)
    raw_kind = str(record.get("kind") or "")
    kind = PUBLIC_KIND_LABELS.get(raw_kind, _SIDE_JUDGEMENT_KIND_LABELS.get(raw_kind, "知识条目"))
    title = _public_display_text(record.get("title") or "-", root, "标题需由 Agent 安全解释", 160)
    print(f"- {kind}「{title}」（{unit_id}）")
    public_match_reason = _review_match_public_reason(match_reason)
    if public_match_reason:
        print(f"  匹配依据：{public_match_reason}。")
    fact_summary = str(projection.get("fact_summary") or "")
    if fact_summary:
        print(f"  待确认的事实信息：{fact_summary}")
    substance = projection.get("substance")
    substance = substance if isinstance(substance, list) else []
    if substance:
        print("  本次拍板同时绑定：")
        for item in substance:
            print(f"  - {item['label']}：{item['text']}")
    claims = projection.get("claims")
    claims = claims if isinstance(claims, list) else []
    if density == "expanded" and claims:
        evidence_count = sum(1 + _natural_count(claim.get("extra_evidence_count")) for claim in claims)
        print(f"  本项包含 {len(claims)} 条待确认判断，共绑定 {evidence_count} 条逐字证据。")
    if claims:
        print("  待确认内容：")
    for claim in claims:
        print(f"  - {claim['type_label']}：{claim['text']}")
        if claim.get("evidence"):
            print(f"    证据摘录（安全显示）：“{claim['evidence']}”")
        extra_count = _natural_count(claim.get("extra_evidence_count"))
        if extra_count and density != "compact":
            print(f"    另有 {extra_count} 条已核验证据。")


def _obsidian_review_display(
    record: Mapping[str, object],
    projection: Mapping[str, object],
    root: Path,
) -> dict[str, object]:
    """Build the already-sanitized, human-visible part of an editable sheet."""
    raw_kind = str(record.get("kind") or "")
    kind_label = PUBLIC_KIND_LABELS.get(raw_kind, _SIDE_JUDGEMENT_KIND_LABELS.get(raw_kind, "知识条目"))
    title = _public_display_text(record.get("title") or "-", root, "标题需由 Agent 安全解释", 160)
    subject_id = _public_display_text(record.get("id") or "-", root, "编号已隐藏", 100)
    source = record.get("source")
    source = source if isinstance(source, Mapping) else {}
    raw_location = (
        source.get("original_uri")
        or record.get("program_id")
        or record.get("idea_id")
        or f"{kind_label} · {subject_id}"
    )
    location_summary = _public_display_text(
        raw_location,
        root,
        f"{kind_label} · {subject_id}",
        240,
    )
    return {
        "kind_label": kind_label,
        "title": title,
        "subject_id": subject_id,
        "location_summary": location_summary,
        "fact_summary": str(projection.get("fact_summary") or ""),
        "substance": list(projection.get("substance") or []),
        "claims": list(projection.get("claims") or []),
    }


def build_review_apply_commands(
    root: Path,
    confirm_ids: Sequence[str],
    reject_ids: Sequence[str],
    evidence: str,
    *,
    allowed_ids: Sequence[str],
    user_authorization: str = "",
    authorization_source: str = "user_message",
) -> list[tuple[str, Sequence[str]]]:
    allowed = {str(item) for item in allowed_ids}
    requested = {str(item) for item in [*confirm_ids, *reject_ids]}
    outside_snapshot = sorted(requested - allowed)
    if outside_snapshot:
        raise ValueError(
            "review decision includes subjects outside the displayed review snapshot: "
            + ", ".join(outside_snapshot)
        )
    commands: list[tuple[str, Sequence[str]]] = []
    if confirm_ids:
        confirm_args: list[str] = ["confirm"]
        for unit_id in confirm_ids:
            confirm_args.extend(["--id", unit_id])
        actor = default_confirmed_by(root)
        if actor:
            confirm_args.extend(["--confirmed-by", actor])
        confirm_args.extend(["--evidence", evidence])
        if user_authorization:
            confirm_args.extend(["--user-authorization", user_authorization])
            confirm_args.extend(["--authorization-source", authorization_source])
        commands.append((SCRIPT_BY_VERB["review"], confirm_args))
    for unit_id in reject_ids:
        commands.append((SCRIPT_BY_VERB["review"], ["promote", "--id", unit_id, "--confirmation-status", "rejected"]))
    return commands


def _review_subject_ref(subject: Mapping[str, object]) -> str:
    return f"{str(subject.get('kind') or '')}:{str(subject.get('id') or '')}"


def _review_now_epoch() -> float:
    """Clock seam for deterministic TTL tests."""
    return time.time()


def _review_timestamp(epoch: float) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def _review_timestamp_epoch(value: object) -> float | None:
    text = str(value or "").strip()
    if not text:
        return None
    try:
        return float(calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ")))
    except (OverflowError, ValueError):
        return None


def _review_snapshot_paths(root: Path, *, create: bool = True) -> tuple[Path, Path, Path] | None:
    project_root = root.resolve()
    kb_path = project_root / "kb"
    runtime_path = kb_path / ".runtime"
    for container in (kb_path, runtime_path):
        if container.is_symlink() or (container.exists() and not container.is_dir()):
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot runtime has an unsafe symlink")
    if not runtime_path.exists() and not create:
        return None
    if create:
        try:
            runtime_path.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot runtime is unavailable") from exc
    runtime_root = runtime_path.resolve()
    try:
        runtime_root.relative_to(project_root)
    except ValueError as exc:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot runtime escaped the workspace") from exc
    snapshot_root = runtime_root / "review-snapshots"
    lock_path = runtime_root / "review-snapshots.lock"
    if snapshot_root.is_symlink() or (snapshot_root.exists() and not snapshot_root.is_dir()):
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot registry is not a safe directory")
    if not snapshot_root.exists() and not create:
        return None
    if create:
        snapshot_root.mkdir(parents=True, exist_ok=True)
    if snapshot_root.is_symlink() or snapshot_root.resolve() != snapshot_root:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot registry escaped its runtime root")
    if lock_path.is_symlink() or (lock_path.exists() and not lock_path.is_file()):
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot registry lock is unsafe")
    return runtime_root, snapshot_root, lock_path


def _atomic_write_review_snapshot(path: Path, payload: Mapping[str, object]) -> None:
    parent = path.parent
    try:
        path.relative_to(parent)
    except ValueError as exc:  # pragma: no cover - defensive invariant
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot path escaped its registry") from exc
    temporary = parent / f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = -1
            handle.write(json.dumps(dict(payload), ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _regular_review_snapshot_payload(path: Path) -> dict[str, object] | None:
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError:
        return None
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            return None
        with os.fdopen(descriptor, "r", encoding="utf-8") as handle:
            descriptor = -1
            payload = json.load(handle)
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if not isinstance(payload, dict) or payload.get("schema") != _REVIEW_SNAPSHOT_SCHEMA:
        return None
    return payload


def _gc_review_snapshots_locked(snapshot_root: Path, *, now: float) -> None:
    """Bounded, non-recursive GC over immediate regular registry entries only."""
    try:
        children = snapshot_root.iterdir()
    except OSError:
        return
    scanned = 0
    for path in children:
        if scanned >= _REVIEW_SNAPSHOT_GC_SCAN_LIMIT:
            break
        scanned += 1
        if _REVIEW_SNAPSHOT_TOKEN_RE.fullmatch(path.stem) is None or path.suffix != ".json":
            continue
        payload = _regular_review_snapshot_payload(path)
        if payload is None:
            continue
        status_value = str(payload.get("status") or "")
        expires_at = _review_timestamp_epoch(payload.get("expires_at"))
        if status_value == "unused" and expires_at is not None and now >= expires_at:
            tombstone = {
                "schema": _REVIEW_SNAPSHOT_SCHEMA,
                "created_at": str(payload.get("created_at") or ""),
                "expires_at": str(payload.get("expires_at") or ""),
                "status": "expired",
                "expired_at": _review_timestamp(expires_at),
            }
            _atomic_write_review_snapshot(path, tombstone)
            payload = tombstone
            status_value = "expired"
        terminal_at = None
        if status_value == "consumed":
            terminal_at = _review_timestamp_epoch(payload.get("consumed_at"))
        elif status_value == "expired":
            terminal_at = _review_timestamp_epoch(payload.get("expired_at"))
        if terminal_at is not None and now >= terminal_at + _REVIEW_SNAPSHOT_TOMBSTONE_GRACE_SECONDS:
            try:
                metadata = path.lstat()
                if stat.S_ISREG(metadata.st_mode):
                    path.unlink()
            except OSError:
                continue


def _gc_review_snapshots(root: Path) -> None:
    paths = _review_snapshot_paths(root, create=False)
    if paths is None:
        return
    _runtime_root, snapshot_root, lock_path = paths
    with exclusive_file_lock(lock_path):
        _gc_review_snapshots_locked(snapshot_root, now=_review_now_epoch())


def _store_review_snapshot(
    root: Path,
    protocol_name: str,
    items: Sequence[Mapping[str, object]],
) -> str:
    protocol_path = agent_protocol_path(root, protocol_name)
    paths = _review_snapshot_paths(root)
    if paths is None:  # pragma: no cover - create=True invariant
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot registry is unavailable")
    runtime_root, snapshot_root, lock_path = paths
    token = uuid.uuid4().hex
    path = snapshot_root / f"{token}.json"
    now = _review_now_epoch()
    payload = {
        "schema": _REVIEW_SNAPSHOT_SCHEMA,
        "created_at": _review_timestamp(now),
        "expires_at": _review_timestamp(now + _REVIEW_SNAPSHOT_TTL_SECONDS),
        "status": "unused",
        "protocol_path": protocol_path.relative_to(runtime_root).as_posix(),
        "review_items": [dict(item) for item in items],
    }
    with exclusive_file_lock(lock_path):
        _gc_review_snapshots_locked(snapshot_root, now=now)
        _atomic_write_review_snapshot(path, payload)
    return token


def _load_review_snapshot(root: Path, requested: str) -> ReviewSnapshotLease:
    """Validate a displayed snapshot without changing its lifecycle state."""
    path = agent_protocol_path(root, requested)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot is missing or invalid") from exc
    if payload.get("schema") != "kb-agent-protocol/v1" or payload.get("verb") != "review":
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot has the wrong protocol type")
    actions = payload.get("next_actions")
    actions = actions if isinstance(actions, list) else []
    present = next(
        (item for item in actions if isinstance(item, dict) and item.get("action") == "present_review_items"),
        None,
    )
    items = present.get("review_items") if isinstance(present, dict) else None
    apply_contract = present.get("apply") if isinstance(present, dict) else None
    apply_contract = apply_contract if isinstance(apply_contract, dict) else {}
    token = str(apply_contract.get("snapshot_token") or "")
    if not isinstance(items, list) or not items or len(items) > _PUBLIC_REVIEW_LIMIT:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot has no displayed decision items")
    normalized = [dict(item) for item in items if isinstance(item, dict)]
    refs = [_review_subject_ref(item.get("subject", {})) for item in normalized]
    if len(normalized) != len(items) or len(set(refs)) != len(refs) or any(ref == ":" for ref in refs):
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot contains ambiguous subjects")
    if _REVIEW_SNAPSHOT_TOKEN_RE.fullmatch(token) is None:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot has no valid one-time token")
    paths = _review_snapshot_paths(root, create=False)
    if paths is None:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot token is unknown or invalid")
    runtime_root, snapshot_root, lock_path = paths
    stored_path = snapshot_root / f"{token}.json"
    now = _review_now_epoch()
    with exclusive_file_lock(lock_path):
        stored = _regular_review_snapshot_payload(stored_path)
        if stored is None:
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot token is unknown or invalid")
        status_value = str(stored.get("status") or "")
        if status_value == "consumed":
            raise ReviewSnapshotError("already_applied", "review snapshot token was already applied")
        if status_value == "expired":
            raise ReviewSnapshotError("expired", "review snapshot token expired")
        expires_at = _review_timestamp_epoch(stored.get("expires_at"))
        if status_value != "unused" or expires_at is None:
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot lifecycle is invalid")
        if now >= expires_at:
            raise ReviewSnapshotError("expired", "review snapshot token expired")
        protocol_relative_path = path.relative_to(runtime_root).as_posix()
        if (
            stored.get("protocol_path") != protocol_relative_path
            or stored.get("review_items") != normalized
        ):
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot does not match the displayed one-time decision set")
    return ReviewSnapshotLease(
        token=token,
        protocol_relative_path=protocol_relative_path,
        review_items=tuple(normalized),
        registry_path=stored_path,
    )


def _consume_review_snapshot(root: Path, lease: ReviewSnapshotLease) -> Path:
    """Consume a revalidated lease inside the caller's root transaction."""
    if not current_operation_id(root):
        raise ReviewSnapshotError("tampered_or_unknown", "snapshot consumption requires a root transaction")
    paths = _review_snapshot_paths(root, create=False)
    if paths is None:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot token is unknown or invalid")
    _runtime_root, snapshot_root, lock_path = paths
    stored_path = snapshot_root / f"{lease.token}.json"
    if stored_path != lease.registry_path:
        raise ReviewSnapshotError("tampered_or_unknown", "review snapshot registry changed")
    with exclusive_file_lock(lock_path):
        stored = _regular_review_snapshot_payload(stored_path)
        if stored is None:
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot token is unknown or invalid")
        status_value = str(stored.get("status") or "")
        if status_value == "consumed":
            raise ReviewSnapshotError("already_applied", "review snapshot token was already applied")
        if status_value == "expired":
            raise ReviewSnapshotError("expired", "review snapshot token expired")
        expires_at = _review_timestamp_epoch(stored.get("expires_at"))
        now = _review_now_epoch()
        if status_value != "unused" or expires_at is None:
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot lifecycle is invalid")
        if now >= expires_at:
            raise ReviewSnapshotError("expired", "review snapshot token expired")
        if (
            stored.get("protocol_path") != lease.protocol_relative_path
            or stored.get("review_items") != list(lease.review_items)
        ):
            raise ReviewSnapshotError("tampered_or_unknown", "review snapshot changed during apply")
        consumed = dict(stored)
        consumed["status"] = "consumed"
        consumed["consumed_at"] = _review_timestamp(now)
        _atomic_write_review_snapshot(stored_path, consumed)
    return stored_path


def _current_review_item(root: Path, subject: Mapping[str, object]) -> dict[str, object]:
    kind = str(subject.get("kind") or "")
    subject_id = str(subject.get("id") or "")
    matches = [
        card
        for card in discover_pending_judgements(root)
        if str(card.get("subject", {}).get("kind") or "") == kind
        and str(card.get("subject", {}).get("id") or "") == subject_id
    ]
    if len(matches) != 1:
        raise ValueError("displayed judgement is no longer uniquely ready")
    canonical_units = _review_unit_records(root) if kind in PUBLIC_KIND_LABELS else {}
    canonical = canonical_units.get((kind, subject_id))
    if kind in PUBLIC_KIND_LABELS and canonical is None:
        raise ValueError("displayed knowledge judgement is no longer uniquely ready")
    title = str(canonical.get("title") or "") if isinstance(canonical, Mapping) else ""
    display_record = _review_card_record(matches[0], title=title)
    if public_review_projection(display_record, root).get("status") != "ready":
        raise ValueError("displayed judgement is no longer safe to confirm")
    return _review_decision_routes(canonical or display_record, matches[0])


def _review_owner_command(
    item: Mapping[str, object],
    decision: str,
    *,
    actor: str,
    evidence: Sequence[str],
    user_authorization: str,
    rejection_reason: str,
) -> tuple[str, list[str]]:
    route_key = "confirm_route" if decision == "confirm" else "reject_route"
    route = item.get(route_key)
    route = route if isinstance(route, Mapping) else {}
    owner = str(route.get("owner") or "")
    action = str(route.get("action") or "")
    script = REVIEW_OWNER_SCRIPTS.get(owner)
    if script is None:
        raise ValueError("review route owner is unsupported")
    snapshot = item.get("snapshot_binding")
    if not isinstance(snapshot, Mapping):
        raise ValueError("review route has no snapshot binding")
    expected_snapshot = json.dumps(snapshot, ensure_ascii=False, sort_keys=True, separators=(",", ":"))

    if owner == "knowledge-base-manager":
        if decision == "confirm" and action == "confirm":
            arguments = ["confirm", "--id", str(route.get("id") or "")]
        elif decision == "reject" and action == "promote":
            arguments = ["promote", "--id", str(route.get("id") or ""), "--confirmation-status", "rejected"]
        else:
            raise ValueError("knowledge review route is invalid")
    elif owner == "research-orchestrator" and action in {"confirm-decision", "reject-decision"}:
        arguments = [
            action,
            "--program-id",
            str(route.get("program_id") or ""),
            "--decision-id",
            str(route.get("decision_id") or ""),
        ]
    elif owner == "idea-workbench" and action == "discuss":
        arguments = [
            "discuss",
            "--idea-id",
            str(route.get("idea_id") or ""),
            "--phase",
            str(route.get("phase") or ""),
            "--conclusion-id",
            str(route.get("conclusion_id") or ""),
        ]
    elif owner == "method-designer" and action in {"confirm-selection", "reject-selection"}:
        arguments = [
            action,
            "--program-id",
            str(route.get("program_id") or ""),
            "--idea-id",
            str(route.get("idea_id") or ""),
        ]
    elif owner == "literature-synthesizer" and action in {"confirm", "reject"}:
        arguments = [
            str(route.get("mode") or "survey"),
            action,
            "--expected-snapshot",
            expected_snapshot,
        ]
    else:
        raise ValueError("review route action is invalid")

    if owner != "literature-synthesizer":
        arguments.extend(["--expected-snapshot", expected_snapshot])
    if decision == "confirm":
        arguments.extend(["--confirmed-by", actor])
        for item_evidence in evidence:
            arguments.extend(["--evidence", str(item_evidence)])
        arguments.extend(
            [
                "--user-authorization",
                user_authorization,
                "--authorization-source",
                "user_message",
            ]
        )
    elif rejection_reason:
        if owner == "knowledge-base-manager":
            arguments.extend(["--evidence", rejection_reason])
        else:
            arguments.extend(["--reason", rejection_reason])
    return script, arguments


def _review_apply_failure_message(code: str) -> str:
    messages = {
        "already_applied": "这条拍板已经应用过；请重新运行 kb review 查看剩余内容。",
        "expired": "这份待确认清单已经过期；请重新运行 kb review 获取当前内容。",
        "stale_content": "待确认内容已经更新，这次拍板没有应用；请重新运行 kb review 查看最新内容。",
        "authorization_stale": "Obsidian 勾选与刚才展示的预览已经不同；没有应用任何决定，请重新预览后再授权。",
        "tampered_or_unknown": "无法验证这份待确认清单；请重新运行 kb review 获取新的安全清单。",
        "invalid_decision": "这次拍板不在刚才展示的范围内；没有应用任何决定。请回到 Agent 对话修正后用同一清单重试。",
        "missing_confirmation_context": "拍板所需的真实署名、当前授权或证据还不完整；没有应用任何决定。补充后请回到 Agent 对话用同一清单重试。",
        "sheet_tampered": "Obsidian 待确认表除勾选框外发生了变化；没有应用任何决定，请重新生成待确认表。",
        "unsafe_display": "有内容不适合安全写入 Obsidian 待确认表；请先让 Agent 安全解释。",
        "invalid_batch": "这份 Obsidian 待确认表不完整；请重新运行 kb review。",
    }
    return messages.get(code, "这次拍板没有完整应用；请重新运行 kb review 查看当前状态。")


_REVIEW_APPLY_SNAPSHOT_HINT = (
    "--apply-snapshot expects the protocol FILE NAME used with --agent-protocol when "
    "kb review displayed these items (e.g. r1.json under kb/.runtime/), NOT the snapshot token."
)
_REVIEW_APPLY_SYNTAX = (
    "kb --agent-protocol <new>.json review --apply-snapshot <display-protocol>.json "
    "--confirm-ref <kind>:<id> [--reject-ref <kind>:<id>] [--defer-ref <kind>:<id>] "
    "--user-authorization <用户原话> --decision-evidence <证据>"
)


def _review_registry_expected_snapshots(root: Path) -> list[dict[str, object]]:
    """Best-effort read-only view of currently valid displayed review snapshots.

    Used only to enrich the private protocol after an apply failure, so the
    runtime agent can self-correct instead of guessing. Never raises.
    """
    try:
        paths = _review_snapshot_paths(root, create=False)
    except (ReviewSnapshotError, OSError):
        return []
    if paths is None:
        return []
    _runtime_root, snapshot_root, _lock_path = paths
    now = _review_now_epoch()
    expected: list[dict[str, object]] = []
    try:
        children = sorted(snapshot_root.iterdir())
    except OSError:
        return []
    for path in children[:_REVIEW_SNAPSHOT_GC_SCAN_LIMIT]:
        if _REVIEW_SNAPSHOT_TOKEN_RE.fullmatch(path.stem) is None or path.suffix != ".json":
            continue
        payload = _regular_review_snapshot_payload(path)
        if payload is None or str(payload.get("status") or "") != "unused":
            continue
        expires_at = _review_timestamp_epoch(payload.get("expires_at"))
        if expires_at is None or now >= expires_at:
            continue
        items = payload.get("review_items")
        items = items if isinstance(items, list) else []
        refs = [
            _review_subject_ref(item.get("subject", {}))
            for item in items
            if isinstance(item, Mapping)
        ]
        expected.append(
            {
                "apply_snapshot": str(payload.get("protocol_path") or ""),
                "valid_confirm_refs": refs,
                "expires_at": str(payload.get("expires_at") or ""),
            }
        )
    return expected


def _review_apply_failure_details(
    root: Path,
    args: argparse.Namespace,
    code: str,
    *,
    lease: "ReviewSnapshotLease | None",
    reason_detail: str = "",
) -> dict[str, object]:
    """Structured, private-only expectations for a failed review apply."""
    requested_refs = [
        str(item)
        for item in [
            *getattr(args, "confirm_ref", []),
            *getattr(args, "reject_ref", []),
            *getattr(args, "defer_ref", []),
        ]
    ]
    malformed_refs = [
        ref
        for ref in requested_refs
        if ":" not in ref or not ref.split(":", 1)[0] or not ref.split(":", 1)[1]
    ]
    valid_refs: list[str] = []
    snapshot_name = ""
    displayed_snapshots: list[dict[str, object]] = []
    if lease is not None:
        valid_refs = [_review_subject_ref(item.get("subject", {})) for item in lease.review_items]
        snapshot_name = lease.protocol_relative_path
    else:
        displayed_snapshots = _review_registry_expected_snapshots(root)
        if len(displayed_snapshots) == 1:
            only = displayed_snapshots[0]
            refs = only.get("valid_confirm_refs")
            valid_refs = [str(ref) for ref in refs] if isinstance(refs, list) else []
            snapshot_name = str(only.get("apply_snapshot") or "")
    outside_refs = sorted(set(requested_refs) - set(valid_refs)) if valid_refs else []
    ref_suggestions: dict[str, str] = {}
    by_bare_id = {ref.split(":", 1)[1]: ref for ref in valid_refs if ":" in ref}
    for ref in requested_refs:
        if ref in valid_refs:
            continue
        bare = ref.split(":", 1)[1] if ":" in ref else ref
        suggestion = by_bare_id.get(bare)
        if suggestion:
            ref_suggestions[ref] = suggestion
    requested_snapshot = str(getattr(args, "apply_snapshot", "") or "").strip()
    reason_code = code
    if code == "tampered_or_unknown" and _REVIEW_SNAPSHOT_TOKEN_RE.fullmatch(requested_snapshot):
        reason_code = "apply_snapshot_looks_like_token"
    elif code == "invalid_decision" and malformed_refs:
        reason_code = "confirm_ref_format_invalid"
    elif code == "invalid_decision":
        reason_code = "outside_displayed_snapshot"
    expected: dict[str, object] = {
        "confirm_ref_format": "<kind>:<id>",
        "valid_confirm_refs": valid_refs,
        "apply_snapshot": snapshot_name,
        "apply_snapshot_expects": _REVIEW_APPLY_SNAPSHOT_HINT,
        "apply_syntax": _REVIEW_APPLY_SYNTAX,
    }
    if displayed_snapshots:
        expected["displayed_snapshots"] = displayed_snapshots
    failure: dict[str, object] = {
        "code": code,
        "reason_code": reason_code,
        "requested_apply_snapshot": requested_snapshot,
        "requested_refs": requested_refs,
        "expected": expected,
    }
    if reason_detail:
        failure["reason_detail"] = reason_detail
    if malformed_refs:
        failure["malformed_refs"] = malformed_refs
    if outside_refs:
        failure["outside_snapshot_refs"] = outside_refs
    if ref_suggestions:
        failure["ref_suggestions"] = ref_suggestions
    return failure


def _record_review_apply_failure(
    root: Path,
    args: argparse.Namespace,
    code: str,
    *,
    lease: "ReviewSnapshotLease | None",
    reason_detail: str = "",
) -> None:
    set_protocol_status(
        "agent_action_required",
        review_apply_error=code,
        review_apply_failure=_review_apply_failure_details(
            root,
            args,
            code,
            lease=lease,
            reason_detail=reason_detail,
        ),
    )


def _obsidian_batch_decision_summary(
    root: Path,
    review_items: Sequence[Mapping[str, object]],
    decisions: Sequence[Mapping[str, object]],
) -> list[dict[str, str]]:
    by_ref = {
        _review_subject_ref(item.get("subject", {})): item
        for item in review_items
    }
    summaries: list[dict[str, str]] = []
    labels = {"confirm": "确认", "reject": "拒绝", "defer": "暂缓"}
    for decision in decisions:
        subject = decision.get("subject") if isinstance(decision, Mapping) else {}
        subject = subject if isinstance(subject, Mapping) else {}
        item = by_ref.get(_review_subject_ref(subject), {})
        display = item.get("display") if isinstance(item, Mapping) else {}
        display = display if isinstance(display, Mapping) else {}
        raw_kind = str(display.get("kind") or subject.get("kind") or "")
        summaries.append(
            {
                "decision": str(decision.get("decision") or ""),
                "decision_label": labels.get(str(decision.get("decision") or ""), "暂缓"),
                "kind_label": PUBLIC_KIND_LABELS.get(
                    raw_kind,
                    _SIDE_JUDGEMENT_KIND_LABELS.get(raw_kind, "判断"),
                ),
                "title": _public_display_text(
                    display.get("title") or "",
                    root,
                    "标题需由 Agent 安全解释",
                    160,
                ),
            }
        )
    return summaries


def handle_obsidian_review_preview(args: argparse.Namespace, root: Path) -> int:
    try:
        preview = preview_obsidian_review_batch(root, str(args.preview_obsidian_batch or ""))
    except ReviewBatchError as exc:
        set_protocol_status("agent_action_required", review_apply_error=exc.code)
        print(_review_apply_failure_message(exc.code), file=sys.stderr)
        return 2
    summaries = _obsidian_batch_decision_summary(root, preview.review_items, preview.decisions)
    set_protocol_status(
        "needs_user_authorization",
        obsidian_review_count=len(summaries),
        obsidian_review_confirm_count=sum(item["decision"] == "confirm" for item in summaries),
        obsidian_review_reject_count=sum(item["decision"] == "reject" for item in summaries),
        obsidian_review_defer_count=sum(item["decision"] == "defer" for item in summaries),
    )
    add_agent_action(
        "present_obsidian_review_diff",
        decisions=summaries,
        apply={
            "verb": "review",
            "mode": "obsidian-batch-atomic",
            "batch_ref": preview.batch_ref,
            "expected_preview_digest": preview.decision_digest,
            "requires_current_user_authorization": True,
        },
    )
    print("已读取 Obsidian 中的勾选；下面是准备同步的决定草稿：")
    for item in summaries:
        print(f"- {item['decision_label']}{item['kind_label']}「{item['title']}」")
    print("这些勾选尚未修改知识库。请核对后用自然语言明确授权 Agent 按以上决定同步。")
    return 0


def _review_owner_module(root: Path, owner: str) -> object:
    cached = _REVIEW_OWNER_MODULES.get(owner)
    if cached is not None:
        return cached
    relative = REVIEW_OWNER_SCRIPTS.get(owner)
    if relative is None:
        raise ValueError("review owner is unsupported")
    script_path = (DEFAULT_PROJECT_ROOT / relative).resolve()
    expected_root = (DEFAULT_PROJECT_ROOT / ".agents" / "skills").resolve()
    try:
        script_path.relative_to(expected_root)
    except ValueError as exc:
        raise ValueError("review owner script escaped the skill tree") from exc
    path_digest = hashlib.sha256(os.fsencode(script_path)).hexdigest()
    module_name = f"kb_review_owner_{owner.replace('-', '_')}_{path_digest}"
    spec = importlib.util.spec_from_file_location(module_name, script_path)
    if spec is None or spec.loader is None:
        raise ValueError("review owner integration is unavailable")
    module = importlib.util.module_from_spec(spec)
    registered_name = spec.name
    sys.modules[registered_name] = module
    try:
        spec.loader.exec_module(module)
        if not callable(getattr(module, "prepare_review_batch_decision", None)) or not callable(
            getattr(module, "apply_review_batch_decision", None)
        ):
            raise ValueError("review owner integration is incomplete")
    except BaseException:
        if sys.modules.get(registered_name) is module:
            del sys.modules[registered_name]
        raise
    _REVIEW_OWNER_MODULES[owner] = module
    return module


def _review_batch_owner_plan(
    root: Path,
    item: Mapping[str, object],
    decision: str,
    *,
    actor: str,
    evidence: list[str],
    user_authorization: str,
    authorization_source: str,
    rejection_reason: str,
) -> tuple[object, dict[str, object]]:
    route = item.get("confirm_route" if decision == "confirm" else "reject_route")
    route = route if isinstance(route, Mapping) else {}
    owner = str(route.get("owner") or "")
    module = _review_owner_module(root, owner)
    plan = module.prepare_review_batch_decision(
        root,
        dict(item),
        decision,
        actor=actor,
        evidence=evidence,
        user_authorization=user_authorization,
        authorization_source=authorization_source,
        rejection_reason=rejection_reason,
    )
    if not isinstance(plan, dict) or plan.get("owner") != owner or plan.get("decision") != decision:
        raise ValueError("review owner returned an invalid plan")
    raw_targets = plan.get("target_paths")
    if not isinstance(raw_targets, list) or not raw_targets:
        raise ValueError("review owner returned no exact targets")
    kb = (root / "kb").resolve()
    targets: list[Path] = []
    for raw_target in raw_targets:
        target = Path(raw_target).resolve()
        try:
            target.relative_to(kb)
        except ValueError as exc:
            raise ValueError("review owner target escaped kb") from exc
        targets.append(target)
    plan["target_paths"] = sorted(set(targets), key=lambda path: path.as_posix())
    return module, plan


def _review_plan_identity(plan: Mapping[str, object]) -> tuple[tuple[str, str], ...]:
    normalized: list[tuple[str, str]] = []
    for key, value in plan.items():
        if key == "target_paths":
            normalized.append((key, "|".join(Path(path).as_posix() for path in value)))
        else:
            normalized.append((str(key), json.dumps(value, ensure_ascii=False, sort_keys=True)))
    return tuple(sorted(normalized))


def _review_batch_owner_plans(
    root: Path,
    current_items: Sequence[Mapping[str, object]],
    decisions: Sequence[Mapping[str, object]],
    *,
    actor: str,
    evidence: list[str],
    user_authorization: str,
    rejection_reason: str,
) -> tuple[list[tuple[object, dict[str, object], dict[str, object], str]], list[Path]]:
    if len(current_items) != len(decisions):
        raise ReviewBatchError("invalid_decision", "review decisions do not match the validated subjects")
    planned: list[tuple[object, dict[str, object], dict[str, object], str]] = []
    canonical_targets: list[Path] = []
    for current_item, chosen in zip(current_items, decisions):
        decision = str(chosen.get("decision") or "")
        if decision == "defer":
            continue
        if decision not in {"confirm", "reject"}:
            raise ReviewBatchError("invalid_decision", "review decision is unsupported")
        module, plan = _review_batch_owner_plan(
            root,
            current_item,
            decision,
            actor=actor,
            evidence=evidence,
            user_authorization=user_authorization,
            authorization_source="user_message",
            rejection_reason=rejection_reason,
        )
        canonical_targets.extend(plan["target_paths"])
        planned.append((module, plan, dict(current_item), decision))
    return planned, canonical_targets


def _apply_review_atomic_batch(
    root: Path,
    *,
    op_type: str,
    current_items: Sequence[Mapping[str, object]],
    decisions: Sequence[Mapping[str, object]],
    runtime_targets: Sequence[Path],
    actor: str,
    evidence: list[str],
    user_authorization: str,
    rejection_reason: str,
    locked_preflight: Callable[
        [], tuple[Sequence[Mapping[str, object]], Sequence[Mapping[str, object]]]
    ],
    consume: Callable[[], object],
) -> tuple[list[Path], int]:
    """Apply dialogue or Obsidian decisions through one shared coordinator."""
    expected_decisions = tuple(dict(item) for item in decisions)
    planned, canonical_targets = _review_batch_owner_plans(
        root,
        current_items,
        expected_decisions,
        actor=actor,
        evidence=evidence,
        user_authorization=user_authorization,
        rejection_reason=rejection_reason,
    )
    all_targets = sorted(set([*canonical_targets, *runtime_targets]), key=lambda path: path.as_posix())
    with mutation_transaction(root, op_type, all_targets):
        locked_items, locked_decisions = locked_preflight()
        normalized_locked_decisions = tuple(dict(item) for item in locked_decisions)
        if normalized_locked_decisions != expected_decisions:
            raise ReviewBatchError("authorization_stale", "review decisions changed after authorization")
        locked_plans, locked_targets = _review_batch_owner_plans(
            root,
            locked_items,
            normalized_locked_decisions,
            actor=actor,
            evidence=evidence,
            user_authorization=user_authorization,
            rejection_reason=rejection_reason,
        )
        if sorted(set(locked_targets), key=lambda path: path.as_posix()) != sorted(
            set(canonical_targets), key=lambda path: path.as_posix()
        ) or [_review_plan_identity(item[1]) for item in locked_plans] != [
            _review_plan_identity(item[1]) for item in planned
        ]:
            raise ReviewBatchError("stale_content", "review owner targets changed while applying")
        for module, _plan, current_item, decision in locked_plans:
            module.apply_review_batch_decision(
                root,
                current_item,
                decision,
                actor=actor,
                evidence=evidence,
                user_authorization=user_authorization,
                authorization_source="user_message",
                rejection_reason=rejection_reason,
            )
        consume()
    return sorted(set(canonical_targets), key=lambda path: path.as_posix()), len(planned)


def handle_obsidian_review_apply(args: argparse.Namespace, root: Path) -> int:
    actor = default_confirmed_by(root)
    authorization = str(args.user_authorization or "").strip()
    expected_preview_digest = str(getattr(args, "expected_preview_digest", "") or "").strip()
    evidence = [str(item).strip() for item in args.decision_evidence if str(item).strip()]
    rejection_reason = str(args.rejection_reason or "").strip()
    try:
        preflight = preflight_obsidian_review_batch(
            root,
            str(args.apply_obsidian_batch or ""),
            current_item_resolver=lambda subject: _current_review_item(root, subject),
        )
        if not expected_preview_digest or preflight.preview.decision_digest != expected_preview_digest:
            raise ReviewBatchError(
                "authorization_stale",
                "the authorized preview no longer matches the review decisions",
            )
        if not authorization:
            raise ReviewBatchError(
                "missing_confirmation_context",
                "every review batch apply requires current-message user authorization",
            )
        confirm_count = sum(item.get("decision") == "confirm" for item in preflight.preview.decisions)
        if confirm_count:
            if not actor or is_ai_signer(actor) or not authorization or not evidence:
                raise ReviewBatchError(
                    "missing_confirmation_context",
                    "confirmation requires a real signer, current authorization, and evidence",
                )
        runtime_targets = list(obsidian_review_batch_runtime_targets(root, preflight.preview.batch_ref))
    except ReviewBatchError as exc:
        set_protocol_status("agent_action_required", review_apply_error=exc.code)
        print(_review_apply_failure_message(exc.code), file=sys.stderr)
        return 2
    except ValueError:
        set_protocol_status("agent_action_required", review_apply_error="stale_content")
        print(_review_apply_failure_message("stale_content"), file=sys.stderr)
        return 2
    except (OSError, RuntimeError, SystemExit, TypeError, ValueError):
        set_protocol_status("agent_action_required", review_apply_error="stale_content")
        print(_review_apply_failure_message("stale_content"), file=sys.stderr)
        return 2

    def locked_preflight() -> tuple[Sequence[Mapping[str, object]], Sequence[Mapping[str, object]]]:
        locked = preflight_obsidian_review_batch(
            root,
            preflight.preview.batch_ref,
            current_item_resolver=lambda subject: _current_review_item(root, subject),
        )
        if locked.preview.decision_digest != expected_preview_digest:
            raise ReviewBatchError("authorization_stale", "review decisions changed after authorization")
        return locked.current_items, locked.preview.decisions

    try:
        canonical_targets, applied_count = _apply_review_atomic_batch(
            root,
            op_type="kb-cli:obsidian-review-batch",
            current_items=preflight.current_items,
            decisions=preflight.preview.decisions,
            runtime_targets=runtime_targets,
            actor=actor,
            evidence=evidence,
            user_authorization=authorization,
            rejection_reason=rejection_reason,
            locked_preflight=locked_preflight,
            consume=lambda: consume_obsidian_review_batch(root, preflight.preview.batch_ref),
        )
    except ReviewBatchError as exc:
        set_protocol_status("agent_action_required", review_apply_error=exc.code)
        print(_review_apply_failure_message(exc.code), file=sys.stderr)
        return 2
    except (OSError, RuntimeError, SystemExit, TypeError, ValueError):
        set_protocol_status("agent_action_required", review_apply_error="stale_content")
        print(_review_apply_failure_message("stale_content"), file=sys.stderr)
        return 2

    exact_checkpoint_targets = sorted(set(canonical_targets), key=lambda path: path.as_posix())
    if exact_checkpoint_targets:
        # The commit id is an internal recovery detail.  This public owner path
        # reports only the atomic batch result.
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                checkpoint_and_report(
                    root,
                    trigger="milestone",
                    message=f"milestone: apply Obsidian review batch ({applied_count} decisions)",
                    target_paths=exact_checkpoint_targets,
                )
        except BaseException:
            set_protocol_status(
                "error",
                checkpoint_status="failed_after_business_apply",
                business_state="applied_before_checkpoint",
            )
            raise
    summaries = _obsidian_batch_decision_summary(root, preflight.preview.review_items, preflight.preview.decisions)
    set_protocol_status(
        "completed",
        obsidian_review_applied_count=applied_count,
        obsidian_review_deferred_count=sum(item["decision"] == "defer" for item in summaries),
    )
    print("Obsidian 中的决定已作为一个整体同步；所有项目均成功，待确认表已安全消费。")
    return 0


def handle_review_apply(args: argparse.Namespace, root: Path) -> int:
    def current_selection(
        lease: ReviewSnapshotLease,
        selected_decisions: Mapping[str, str],
    ) -> tuple[list[dict[str, object]], list[dict[str, object]]]:
        current_items: list[dict[str, object]] = []
        decisions: list[dict[str, object]] = []
        for snapshot_item in lease.review_items:
            subject = snapshot_item.get("subject", {})
            ref = _review_subject_ref(subject)
            decision = selected_decisions.get(ref)
            if decision is None:
                continue
            try:
                current = _current_review_item(root, subject)
            except ValueError as exc:
                raise ReviewSnapshotError("stale_content", "displayed judgement is no longer current") from exc
            if any(
                current.get(key) != snapshot_item.get(key)
                for key in ("subject", "snapshot_binding", "confirm_route", "reject_route")
            ):
                raise ReviewSnapshotError("stale_content", "review snapshot content is stale")
            current_items.append(current)
            decisions.append(
                {
                    "decision": decision,
                    "subject": dict(subject) if isinstance(subject, Mapping) else {},
                }
            )
        return current_items, decisions

    lease: ReviewSnapshotLease | None = None
    try:
        lease = _load_review_snapshot(root, args.apply_snapshot)
        snapshot_by_ref = {
            _review_subject_ref(item.get("subject", {})): item
            for item in lease.review_items
        }
        confirm_refs = [str(item) for item in args.confirm_ref]
        reject_refs = [str(item) for item in args.reject_ref]
        defer_refs = [str(item) for item in args.defer_ref]
        requested = [*confirm_refs, *reject_refs, *defer_refs]
        if not requested or len(requested) > _PUBLIC_REVIEW_LIMIT or len(set(requested)) != len(requested):
            raise ReviewSnapshotError("invalid_decision", "review decisions are empty or duplicated")
        outside = sorted(set(requested) - set(snapshot_by_ref))
        if outside:
            raise ReviewSnapshotError("invalid_decision", "review decision is outside the displayed Top 3 snapshot")
        selected_decisions = {
            **{ref: "confirm" for ref in confirm_refs},
            **{ref: "reject" for ref in reject_refs},
            **{ref: "defer" for ref in defer_refs},
        }
        actor = default_confirmed_by(root)
        if confirm_refs and (not actor or is_ai_signer(actor)):
            raise ReviewSnapshotError("missing_confirmation_context", "a real human confirmation identity is required")
        user_authorization = str(args.user_authorization or "").strip()
        evidence = [str(item).strip() for item in args.decision_evidence if str(item).strip()]
        if not user_authorization or (confirm_refs and not evidence):
            raise ReviewSnapshotError(
                "missing_confirmation_context",
                "review decisions require current authorization; confirmation also requires evidence",
            )
        current_items, decisions = current_selection(lease, selected_decisions)
    except ReviewSnapshotError as exc:
        _record_review_apply_failure(root, args, exc.code, lease=lease, reason_detail=str(exc))
        print(_review_apply_failure_message(exc.code), file=sys.stderr)
        return 2
    except ValueError as exc:
        _record_review_apply_failure(root, args, "tampered_or_unknown", lease=lease, reason_detail=str(exc))
        print(_review_apply_failure_message("tampered_or_unknown"), file=sys.stderr)
        return 2

    def locked_preflight() -> tuple[Sequence[Mapping[str, object]], Sequence[Mapping[str, object]]]:
        locked_lease = _load_review_snapshot(root, args.apply_snapshot)
        if locked_lease != lease:
            raise ReviewSnapshotError("stale_content", "review snapshot changed while applying")
        return current_selection(locked_lease, selected_decisions)

    try:
        canonical_targets, applied_count = _apply_review_atomic_batch(
            root,
            op_type="kb-cli:dialogue-review-batch",
            current_items=current_items,
            decisions=decisions,
            runtime_targets=[lease.registry_path],
            actor=actor,
            evidence=evidence,
            user_authorization=user_authorization,
            rejection_reason=str(args.rejection_reason or "").strip(),
            locked_preflight=locked_preflight,
            consume=lambda: _consume_review_snapshot(root, _load_review_snapshot(root, args.apply_snapshot)),
        )
    except (ReviewBatchError, ReviewSnapshotError) as exc:
        _record_review_apply_failure(root, args, exc.code, lease=lease, reason_detail=str(exc))
        print(_review_apply_failure_message(exc.code), file=sys.stderr)
        return 2
    except (OSError, RuntimeError, SystemExit, TypeError, ValueError):
        _record_review_apply_failure(root, args, "stale_content", lease=lease)
        print(_review_apply_failure_message("stale_content"), file=sys.stderr)
        return 2

    if canonical_targets:
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                checkpoint_and_report(
                    root,
                    trigger="milestone",
                    message=f"milestone: apply dialogue review batch ({applied_count} decisions)",
                    target_paths=canonical_targets,
                )
        except BaseException:
            set_protocol_status(
                "error",
                checkpoint_status="failed_after_business_apply",
                business_state="applied_before_checkpoint",
            )
            raise
    labels = {"confirm": "已确认", "reject": "已拒绝", "defer": "已暂缓"}
    set_protocol_status(
        "completed",
        applied_review_count=applied_count,
        deferred_review_count=len(defer_refs),
        decided_review_count=len(requested),
    )
    print(f"已应用 {len(requested)} 条拍板结果（原子批量）：")
    for current_item, decision in zip(current_items, decisions):
        display = current_item.get("display")
        display = display if isinstance(display, Mapping) else {}
        subject = current_item.get("subject")
        subject = subject if isinstance(subject, Mapping) else {}
        raw_kind = str(display.get("kind") or subject.get("kind") or "")
        kind_label = PUBLIC_KIND_LABELS.get(raw_kind, _SIDE_JUDGEMENT_KIND_LABELS.get(raw_kind, "判断"))
        title = _public_display_text(display.get("title") or "", root, "标题需由 Agent 安全解释", 160)
        print(f"- {labels[str(decision['decision'])]}{kind_label}「{title}」")
    print("这批决定已作为一个整体处理；可再次运行 kb review 查看剩余内容。")
    return 0


def handle_review(args: argparse.Namespace, root: Path) -> int:
    if str(getattr(args, "preview_obsidian_batch", "") or "").strip():
        return handle_obsidian_review_preview(args, root)
    if str(getattr(args, "apply_obsidian_batch", "") or "").strip():
        return handle_obsidian_review_apply(args, root)
    if str(getattr(args, "apply_snapshot", "") or "").strip():
        return handle_review_apply(args, root)
    try:
        _gc_review_snapshots(root)
    except ReviewSnapshotError as exc:
        set_protocol_status("agent_action_required", review_apply_error=exc.code)
        print(_review_apply_failure_message(exc.code), file=sys.stderr)
        return 2
    result = forward_command(
        root,
        SCRIPT_BY_VERB["review"],
        build_review_list_args(args.fuzzy),
        stream=False,
    )
    if result.returncode != 0:
        print("确认收件箱暂时无法读取；详细诊断已保留给 Agent。", file=sys.stderr)
        return result.returncode
    canonical_units = _review_unit_records(root)
    cards: list[dict[str, object]] = []
    match_reason_by_subject: dict[tuple[str, str], str] = {}
    for card in discover_pending_judgements(root):
        subject = card.get("subject") if isinstance(card.get("subject"), Mapping) else {}
        key = (str(subject.get("kind") or ""), str(subject.get("id") or ""))
        canonical = canonical_units.get(key)
        title = str(canonical.get("title") or "") if isinstance(canonical, Mapping) else ""
        matched, match_reason = _review_card_match(card, args.fuzzy, title=title)
        if matched:
            cards.append(card)
            match_reason_by_subject[key] = match_reason
    card_by_subject: dict[tuple[str, str], dict[str, object]] = {}
    for card in cards:
        subject = card.get("subject")
        subject = subject if isinstance(subject, Mapping) else {}
        card_by_subject[(str(subject.get("kind") or ""), str(subject.get("id") or ""))] = card
    records = [
        _review_card_record(
            card,
            title=str(canonical_units.get(key, {}).get("title") or ""),
        )
        for key, card in card_by_subject.items()
    ]
    pending: list[dict] = []
    projection_by_subject: dict[tuple[str, str], dict[str, object]] = {}
    structurally_blocked: list[dict] = []
    unsafe_blocked: list[dict] = []
    for record in records:
        key = (str(record.get("kind") or ""), str(record.get("id") or ""))
        if key[0] in PUBLIC_KIND_LABELS and key not in canonical_units:
            structurally_blocked.append(record)
            continue
        projection = public_review_projection(record, root)
        if projection.get("status") == "invalid":
            structurally_blocked.append(record)
            continue
        if projection.get("status") == "unsafe":
            unsafe_blocked.append(record)
            continue
        pending.append(record)
        projection_by_subject[key] = projection
    blocked = [*structurally_blocked, *unsafe_blocked]
    if pending:
        pending.sort(key=_review_sort_key)
        displayed = pending[:_PUBLIC_REVIEW_LIMIT]
        remaining_count = len(pending) - len(displayed)
        displayed_ids = [str(record.get("id") or "") for record in displayed]
        configured_actor = default_confirmed_by(root)
        confirmation_identity_required = not configured_actor or is_ai_signer(configured_actor)
        review_items = [
            _review_decision_routes(
                canonical_units.get(
                    (str(record.get("kind") or ""), str(record.get("id") or "")),
                    record,
                ),
                card_by_subject.get((str(record.get("kind") or ""), str(record.get("id") or ""))),
            )
            for record in displayed
        ]
        preference_task_context = review_display_preference_context(review_items)
        try:
            effective_preferences = resolve_operation_preferences(
                root,
                selection_id=str(getattr(args, "preference_selection_id", "") or ""),
                skill="kb-cli",
                operation="review-display",
                canonical_inputs=preference_task_context,
            )
        except ValueError:
            set_protocol_status("agent_action_required", review_preference_error="stale_or_invalid")
            print("这次显示偏好与当前待确认内容不一致；Agent 需要重新选择后再展示。", file=sys.stderr)
            return 2
        density = review_display_density(effective_preferences)
        selected_soft_paths = sorted(
            str(item.get("path") or "")
            for item in effective_preferences.get("soft_items", [])
            if isinstance(item, Mapping) and str(item.get("path") or "")
        )
        selection_binding = effective_preferences.get("binding")
        selection_binding = dict(selection_binding) if isinstance(selection_binding, Mapping) else {}
        set_protocol_status(
            "needs_user_authorization",
            review_count=len(pending),
            record_ids=displayed_ids,
            displayed_review_count=len(displayed),
            displayed_record_ids=displayed_ids,
            remaining_review_count=remaining_count,
            blocked_review_count=len(blocked),
            blocked_review_records=blocked,
            invalid_review_count=len(structurally_blocked),
            unsafe_review_count=len(unsafe_blocked),
            confirmation_identity_required=confirmation_identity_required,
            review_display_density=density,
            preference_selection_applied=bool(selection_binding),
        )
        snapshot_token = _store_review_snapshot(
            root,
            str(getattr(args, "agent_protocol", "") or ""),
            review_items,
        ) if _ACTIVE_PROTOCOL is not None else ""
        obsidian_batch: dict[str, object] | None = None
        if bool(getattr(args, "obsidian_export", False)):
            if not snapshot_token:
                set_protocol_status("agent_action_required", review_apply_error="invalid_batch")
                print("需要由 Agent 建立安全待确认表；请重新运行 kb review。", file=sys.stderr)
                return 2
            try:
                obsidian_batch = create_obsidian_review_batch(
                    root,
                    source_snapshot_token=snapshot_token,
                    review_items=review_items,
                    display_items=[
                        _obsidian_review_display(
                            record,
                            projection_by_subject[(str(record.get("kind") or ""), str(record.get("id") or ""))],
                            root,
                        )
                        for record in displayed
                    ],
                )
            except ReviewBatchError as exc:
                set_protocol_status("agent_action_required", review_apply_error=exc.code)
                print(_review_apply_failure_message(exc.code), file=sys.stderr)
                return 2
        add_agent_action(
            "present_review_items",
            records=displayed,
            review_items=review_items,
            decision_fields=["decision", "user_authorization", "authorization_source", "evidence"],
            authorization_source="user_message",
            effective_preferences={
                "skill": "kb-cli",
                "operation": "review-display",
                "task_context": preference_task_context,
                "task_context_digest": effective_preferences["task_context_digest"],
                "selection_binding": selection_binding,
                "selection_applied": bool(selection_binding),
                "selected_soft_paths": selected_soft_paths,
                "neutral_without_selection": True,
                "display_density": density,
                "allowed_effect": "explanation-density-only",
                "hard_display_cap": _PUBLIC_REVIEW_LIMIT,
            },
            apply={
                "verb": "review",
                "mode": "snapshot-bound",
                "snapshot_protocol": str(getattr(args, "agent_protocol", "") or ""),
                "scope": "displayed_review_items_only",
                "max_decisions_per_apply": _PUBLIC_REVIEW_LIMIT,
                "snapshot_token": snapshot_token,
            },
        )
        if obsidian_batch is not None:
            add_agent_action(
                "open_obsidian_review_sheet",
                sheet_path=obsidian_batch["sheet_relative_path"],
                batch_ref=obsidian_batch["batch_ref"],
                expires_at=obsidian_batch["expires_at"],
                then="preview_obsidian_review_diff",
            )
        if confirmation_identity_required:
            add_agent_action(
                "collect_confirmation_identity",
                when="user_confirms",
                required_fields=["human_name"],
                required_before="apply_confirmation",
                apply={
                    "verb": "init",
                    "mode": "headless",
                    "fields": ["human_name"],
                    "field_inputs": {"human_name": {"input": "--name"}},
                },
                then="apply_review_snapshot_decision",
            )
        if remaining_count:
            print(f"有 {len(pending)} 条待确认内容已经准备好；本次先显示最需要你拍板的 {len(displayed)} 条：")
        else:
            print(f"有 {len(pending)} 条待确认内容已经准备好：")
        for record in displayed:
            print_review_item(
                record,
                projection_by_subject[(str(record.get("kind") or ""), str(record.get("id") or ""))],
                root,
                density=density,
                match_reason=match_reason_by_subject.get(
                    (str(record.get("kind") or ""), str(record.get("id") or "")),
                    "",
                ),
            )
        if remaining_count:
            print(f"另有 {remaining_count} 条已准备好的内容暂未展开；处理这批后可继续查看。")
        print("以上待确认内容已经过当前流程核验；请回到 Agent 对话，用自然语言一次确认、拒绝或暂缓最多 3 项。在你拍板前不会写成已确认结论。")
        if obsidian_batch is not None:
            print("已在 Obsidian 的人工批注区生成可编辑待确认表；勾选后请回到对话中要求 Agent 同步。")
        if confirmation_identity_required:
            print("如果你选择确认，确认前还需要你的真实署名。")
        if structurally_blocked:
            add_agent_action("repair_review_claims", records=structurally_blocked)
            print("另有判断缺少可确认的文本或证据，Agent 会先补全。")
        if unsafe_blocked:
            add_agent_action("explain_review_items_safely", records=unsafe_blocked)
            print("另有已核验内容不适合直接显示，请先让 Agent 安全解释。")
    elif blocked:
        set_protocol_status(
            "agent_action_required",
            review_count=0,
            blocked_review_count=len(blocked),
            blocked_review_records=blocked,
            invalid_review_count=len(structurally_blocked),
            unsafe_review_count=len(unsafe_blocked),
        )
        if structurally_blocked:
            add_agent_action("repair_review_claims", records=structurally_blocked)
        if unsafe_blocked:
            add_agent_action("explain_review_items_safely", records=unsafe_blocked)
        if structurally_blocked and unsafe_blocked:
            print("目前没有可供你安全确认的判断；请先让 Agent 安全解释相关内容，并补全缺失的判断文本或证据。")
        elif unsafe_blocked:
            print("目前没有可供你安全确认的判断；请先让 Agent 安全解释这些已核验内容。")
        else:
            print("目前没有可供你安全确认的判断；Agent 需要先补全判断文本或证据。")
    else:
        set_protocol_status(
            "completed",
            review_count=0,
            blocked_review_count=0,
            blocked_review_records=[],
            invalid_review_count=0,
            unsafe_review_count=0,
        )
        print("目前没有需要你确认的判断。")
    return 0


class ConversationalArgumentParser(argparse.ArgumentParser):
    """Keep parser mechanics private while preserving discoverable ``kb`` verbs."""

    def __init__(self, *args: object, **kwargs: object) -> None:
        include_help = bool(kwargs.pop("add_help", True))
        kwargs.setdefault("usage", argparse.SUPPRESS)
        super().__init__(*args, add_help=False, **kwargs)
        if include_help:
            self.add_argument("-h", "--help", action="help", help=argparse.SUPPRESS)

    def error(self, message: str) -> None:
        del message
        self.exit(2, "我没能理解这条 kb 请求。请使用 kb help 查看可用动词和示例。\n")

    def format_help(self) -> str:
        return render_help_menu()


def register_help(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("help", help="打印分组能力菜单")
    parser.set_defaults(handler=handle_help)


def register_doctor(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("doctor", help="检查当前 runtime 能力")
    parser.set_defaults(handler=handle_doctor)


