    )
    parser.add_argument("id", metavar="<单元编号>", help="要拒绝的知识单元编号")
    parser.add_argument("--reason", default="", help=argparse.SUPPRESS)
    parser.set_defaults(handler=handle_reject)


VERB_REGISTRARS: tuple[Callable[[argparse._SubParsersAction[argparse.ArgumentParser]], None], ...] = (
    register_help,
    register_init,
    register_doctor,
    register_update,
    register_obsidian,
    register_add,
    register_ingest,
    register_review,
    register_status,
    register_next,
    register_find,
    register_recall,
    register_resume,
    register_undo,
    register_restore,
    register_reject,
)


def build_parser() -> argparse.ArgumentParser:
    parser = ConversationalArgumentParser(
        prog="kb",
        description="使用 kb 动词管理研究知识库；查看示例可使用 kb help。",
    )
    parser.add_argument("--root", default="", help=argparse.SUPPRESS)
    parser.add_argument("--agent-protocol", default="", help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest="command", required=True, metavar="<动词>")
    for register in VERB_REGISTRARS:
        register(subparsers)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    global _ACTIVE_PROTOCOL, _ACTIVE_PUBLIC_VERB
    parser = build_parser()
    args = parser.parse_args(argv)
    root = find_project_root(DEFAULT_PROJECT_ROOT, explicit_root=args.root)
    handler: Handler = args.handler
    protocol = AgentProtocol(args.command) if str(args.agent_protocol or "").strip() else None
    _ACTIVE_PROTOCOL = protocol
    _ACTIVE_PUBLIC_VERB = str(args.command or "")
    stopped: SystemExit | None = None
    raised: BaseException | None = None
    exit_code = 0
    try:
        try:
            exit_code = handler(args, root)
        except SystemExit as exc:
            stopped = exc
            exit_code = exc.code if isinstance(exc.code, int) else (1 if exc.code else 0)
            if protocol is not None:
                protocol.status = "error" if exit_code else "completed"
                if exc.code not in (None, 0):
                    if protocol.details is None:
                        protocol.details = {}
                    protocol.details["error"] = str(exc.code)
        except BaseException as exc:
            raised = exc
            exit_code = 1
            if protocol is not None:
                protocol.status = "error"
                if protocol.details is None:
                    protocol.details = {}
                protocol.details.setdefault("error_class", type(exc).__name__)
    finally:
        _ACTIVE_PROTOCOL = None
        _ACTIVE_PUBLIC_VERB = ""
        if protocol is not None:
            protocol.exit_code = int(exit_code)
            if exit_code != 0 and protocol.status == "completed":
                protocol.status = "error"
            write_agent_protocol(root, str(args.agent_protocol), protocol)
    if stopped is not None:
        raise stopped
    if raised is not None:
        if isinstance(raised, BrokenPipeError):
            # A closed public reader (e.g. `kb restore | head`) must never turn
            # into a traceback on the user surface. Detach stdout so interpreter
            # shutdown flushing stays quiet, then fail with a plain exit code.
            try:
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, sys.stdout.fileno())
            except OSError:
                pass
            return 1
        raise raised
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
