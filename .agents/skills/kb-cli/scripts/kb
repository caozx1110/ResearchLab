def _public_command_name(token: str) -> str:
    return token.replace("\\", "/").rsplit("/", 1)[-1]


def _public_normalized_command_name(token: str) -> str:
    return unicodedata.normalize("NFKC", _public_command_name(token))


def _public_argument_looks_executable(argument: str) -> bool:
    normalized = unicodedata.normalize("NFKC", argument)
    folded = normalized.casefold()
    return (
        normalized.startswith(("-", "/", "~", "./", "../"))
        or folded.startswith(("http://", "https://", "ssh://", "git@"))
        or folded.endswith(
            (
                ".app", ".bash", ".class", ".cjs", ".exe", ".jar", ".js", ".lua", ".mjs",
                ".php", ".pl", ".ps1", ".py", ".rb", ".sh", ".zsh",
            )
        )
    )


def _public_tokens_look_like_prose(command: str, arguments: Sequence[str]) -> bool:
    if command not in _PUBLIC_PROSE_AMBIGUOUS_COMMAND_HEADS or len(arguments) < 2:
        return False
    if not arguments[-1].endswith((".", "!", "?", "。", "！", "？")):
        return False
    if any(
        _public_argument_looks_executable(argument)
        or _PUBLIC_SHELL_ASSIGNMENT_RE.match(unicodedata.normalize("NFKC", argument))
        for argument in arguments
    ):
        return False
    predicate_words = {"are", "can", "could", "has", "have", "is", "may", "might", "should", "was", "were", "will", "would"}
    return any(
        (word := re.sub(r"[^A-Za-z]+$", "", argument).casefold()) in predicate_words
        or word.endswith(("ed", "ing", "s"))
        for argument in arguments
    )


def _public_ambiguous_tokens_have_command_shape(command: str, arguments: Sequence[str]) -> bool:
    if command == "go":
        return bool(arguments) and arguments[0] in _PUBLIC_GO_SUBCOMMANDS
    if command == "make":
        return bool(arguments) and (
            arguments[0].startswith("-")
            or arguments[0] in _PUBLIC_MAKE_TARGETS
            or bool(_PUBLIC_SHELL_ASSIGNMENT_RE.match(arguments[0]))
        )
    if command in {"python", "python2", "python3"}:
        return bool(arguments) and _public_argument_looks_executable(arguments[0])
    if command == "source":
        return bool(arguments) and (
            _public_argument_looks_executable(arguments[0])
            or bool(_PUBLIC_FILEISH_ARGUMENT_RE.search(arguments[0]))
        )
    if command == "set":
        return bool(arguments) and (
            arguments[0].startswith(("-", "+"))
            or any(_PUBLIC_SHELL_ASSIGNMENT_RE.match(argument) for argument in arguments)
        )
    if command == "test":
        return bool(arguments) and (
            arguments[0].startswith("-")
            or _public_argument_looks_executable(arguments[0])
            or any(argument in {"!=", "=", "-a", "-o"} for argument in arguments)
        )
    if command == "time":
        return bool(arguments) and (
            _public_argument_looks_executable(arguments[0])
            or _public_normalized_command_name(arguments[0]) in _PUBLIC_ALWAYS_COMMAND_HEADS
        )
    return False


def _public_tokens_have_command_shape(tokens: Sequence[str]) -> bool:
    if not tokens:
        return False
    command = _public_normalized_command_name(tokens[0])
    arguments = list(tokens[1:])
    if _public_ambiguous_tokens_have_command_shape(command, arguments):
        return True
    if command in _PUBLIC_ALWAYS_COMMAND_HEADS and any(
        _public_argument_looks_executable(argument)
        or _PUBLIC_FILEISH_ARGUMENT_RE.search(argument)
        or _PUBLIC_SHELL_ASSIGNMENT_RE.match(unicodedata.normalize("NFKC", argument))
        for argument in arguments
    ):
        return True
    if _public_tokens_look_like_prose(command, arguments):
        return False
    if command in _PUBLIC_ALWAYS_COMMAND_HEADS:
        return True
    if command == "git":
        return bool(arguments) and (
            arguments[0].startswith("-") or arguments[0].casefold() in _PUBLIC_GIT_SUBCOMMANDS
        )
    if command == "docker":
        return bool(arguments) and (
            arguments[0].startswith("-") or arguments[0].casefold() in _PUBLIC_DOCKER_SUBCOMMANDS
        )
    if command == "find":
        return bool(arguments) and (
            _public_argument_looks_executable(arguments[0])
            or arguments[0] in {".", ".."}
            or any(argument.startswith("-") for argument in arguments)
        )
    if command == "open":
        return bool(arguments) and any(
            _public_argument_looks_executable(argument) or _PUBLIC_FILEISH_ARGUMENT_RE.search(argument)
            for argument in arguments
        )
    return False


def _public_kb_pseudo_cli_is_safe(candidate: str, raw_head: str, tokens: Sequence[str]) -> bool:
    if raw_head != "kb" or not tokens or tokens[0] != "kb" or len(tokens) < 2:
        return False
    verb = tokens[1]
    raw_parts = candidate.split(maxsplit=2)
    if len(raw_parts) < 2 or raw_parts[1] != verb:
        return False
    arity = _PUBLIC_KB_VERB_ARITY.get(verb)
    if arity is None:
        return False
    arguments = list(tokens[2:])
    minimum, maximum = arity
    if len(arguments) < minimum or (maximum is not None and len(arguments) > maximum):
        return False
    return not any(_PUBLIC_KB_ARGUMENT_META_RE.search(argument) for argument in arguments)


def _public_shell_tokens(candidate: str, *, punctuation: bool = False) -> list[str] | None:
    """Parse shell quoting while preserving ordinary embedded apostrophes."""
    def parse(source: str) -> list[str]:
        if not punctuation:
            return shlex.split(source, comments=False, posix=True)
        lexer = shlex.shlex(source, posix=True, punctuation_chars=";&|")
        lexer.whitespace_split = True
        lexer.commenters = ""
        return list(lexer)

    try:
        return parse(candidate)
    except ValueError:
        prose_candidate = _PUBLIC_EMBEDDED_APOSTROPHE_RE.sub(r"\\'", candidate)
        if prose_candidate == candidate:
            return None
        try:
            return parse(prose_candidate)
        except ValueError:
            return None


def _public_line_has_shell_control_command(candidate: str) -> bool:
    tokens = _public_shell_tokens(candidate, punctuation=True)
    if tokens is None:
        return True
    operators = {";", "&", "&&", "|", "||"}
    command = _public_normalized_command_name(tokens[0]) if tokens else ""
    if command in _PUBLIC_SHELL_RESERVED_HEADS and (
        any(token in operators for token in tokens)
        or (command == "function" and "{" in tokens)
    ):
        return True
    for index, token in enumerate(tokens):
        if token not in operators:
            continue
        remaining = list(tokens[index + 1 :])
        while remaining and remaining[0] in {"do", "elif", "else", "then"}:
            remaining.pop(0)
        if not remaining or remaining[0] in {"done", "esac", "fi"}:
            continue
        head = _public_normalized_command_name(remaining[0])
        if (
            remaining[0].startswith(("/", "./", "../", "~"))
            or _PUBLIC_SHELL_ASSIGNMENT_RE.match(head)
            or _public_tokens_have_command_shape(remaining)
        ):
            return True
    return False


def _public_text_has_command_shape(text: str) -> bool:
    """Classify commands only at the start of each original logical line."""
    if "$(" in text:
        return True
    for logical_line in text.splitlines() or [text]:
        candidate = logical_line.lstrip()
        candidate = _PUBLIC_COMMAND_LINE_PREFIX_RE.sub("", candidate, count=1)
        if not candidate:
            continue
        tokens = _public_shell_tokens(candidate)
        if tokens is None:
            return True
        if not tokens:
            continue
        raw_head = candidate.split(maxsplit=1)[0]
        parsed_head = tokens[0]
        normalized_raw_head = unicodedata.normalize("NFKC", raw_head)
        normalized_head = unicodedata.normalize("NFKC", parsed_head)
        if _public_normalized_command_name(parsed_head) == "kb":
            if _public_kb_pseudo_cli_is_safe(candidate, raw_head, tokens):
                continue
            return True
        if normalized_head.startswith(("/", "./", "../", "~")):
            return True
        if _PUBLIC_SHELL_ASSIGNMENT_RE.match(normalized_head):
            return True
        if candidate.startswith(("(", "{", "!", "<", ">", "|", "&", ";")):
            return True
        if (
            _PUBLIC_SHELL_HEAD_ALWAYS_META_RE.search(normalized_raw_head)
            or _PUBLIC_SHELL_HEAD_ALWAYS_META_RE.search(normalized_head)
        ):
            return True
        if len(tokens) > 1 and (
            _PUBLIC_SHELL_HEAD_CONTEXT_META_RE.search(normalized_raw_head)
            or _PUBLIC_SHELL_HEAD_CONTEXT_META_RE.search(normalized_head)
            or _PUBLIC_SHELL_HEAD_OBFUSCATION_RE.search(normalized_raw_head)
            or _PUBLIC_SHELL_HEAD_OBFUSCATION_RE.search(normalized_head)
        ):
            return True
        if normalized_raw_head.count("`") >= 2 or normalized_head.count("`") >= 2:
            return True
        if _public_line_has_shell_control_command(candidate):
            return True
        if _public_tokens_have_command_shape(tokens):
            return True
    return False


def _public_line_is_safe(line: str, root: Path) -> bool:
    """Fail closed for owner output that belongs on the private protocol channel."""
    stripped = line.strip()
    if not stripped:
        return True
    folded = line.casefold()
    if "next for agent:" in folded or any(token.casefold() in folded for token in _PUBLIC_FORBIDDEN[1:]):
        return False
    if _public_text_has_command_shape(line):
        return False
    if re.search(r"(^|\s)--[A-Za-z][\w-]*", line, flags=re.IGNORECASE):
        return False
    if stripped.lower().startswith(("confirm:", "path:", "repo_path:", "project_root:", "skills_home:")):
        return False
    if stripped.startswith(("[source]", "[auto]", "[checkpoint]")):
        return False
    if stripped.startswith("[ok] git checkpoint:"):
        return False
    if any(field in stripped for field in ("backup_status=", "source_type=", "locator_kind=")):
        return False
    if " | confirm:" in line:
        return False
    for private_root in {str(root.resolve()), str(DEFAULT_PROJECT_ROOT.resolve())}:
        if private_root and private_root in line:
            return False
    if re.search(r"(?:^|\s)/(?:[^\s]|$)", line):
        return False
    if re.search(r"(?:^|\s)(?:kb|raw|output)/[^\s]+", line, flags=re.IGNORECASE):
        return False
    return True


def _sanitize_public_text(value: object, root: Path) -> str | None:
    """Return one inert line, classifying original logical lines before folding."""
    text = _ANSI_ESCAPE_RE.sub("", str(value or ""))
    characters: list[str] = []
    for character in text:
        codepoint = ord(character)
        category = unicodedata.category(character)
        if character in "\r\n\v\f\x1c\x1d\x1e\x85\u2028\u2029":
            characters.append("\n")
        elif character.isspace():
            characters.append(" ")
        elif codepoint in _BIDI_CONTROL_CODEPOINTS or category in {"Cc", "Cf", "Cs"}:
            continue
        else:
            characters.append(character)
    text = "".join(characters)
    if not text.strip() or not _public_line_is_safe(text, root):
        return None
    text = re.sub(r"\s+", " ", text).strip()
    text = text.translate(_MARKDOWN_NEUTRAL_TRANSLATION)
    return text or None


def _render_public_claim_text(value: object, root: Path) -> str | None:
    """Render canonical claim text injectively or fail closed.

    Whitespace folding matches confirmation digests.  Every other control or
    format character is unsafe, and Markdown syntax is escaped reversibly so
    distinct canonical claims cannot collapse to the same public projection.
    """
    text = str(value or "")
    if _ANSI_ESCAPE_RE.search(text):
        return None
    for character in text:
        category = unicodedata.category(character)
        if character.isspace():
            continue
        if ord(character) in _BIDI_CONTROL_CODEPOINTS or category in {"Cc", "Cf", "Cs"}:
            return None
    if not text.strip() or not _public_line_is_safe(text, root):
        return None
    text = re.sub(r"\s+", " ", text).strip()
    text = text.replace("\\", "\\\\")
    for marker in ("[", "]", "<", ">", "`"):
        text = text.replace(marker, f"\\{marker}")
    return text or None


def _bounded_public_text(text: str, limit: int) -> str:
    bounded_limit = max(1, int(limit))
    if len(text) > bounded_limit:
        return text[: bounded_limit - 1].rstrip() + "…"
    return text


def _public_display_text(value: object, root: Path, fallback: str, limit: int) -> str:
    """Return one bounded, inert public line while keeping the original private."""
    text = _sanitize_public_text(value, root)
    if text is None:
        return fallback
    return _bounded_public_text(text, limit)


def _record_is_rejected(record: Mapping[str, object]) -> bool:
    return str(record.get("confirmation_status") or "").strip().lower() == "rejected"


def _natural_count(value: object) -> int:
    try:
        return max(0, int(value or 0))
    except (TypeError, ValueError):
        return 0


def _humanize_owner_line(line: str) -> str | None:
    stripped = line.strip()
    if not stripped:
        return ""
    if stripped.startswith("[ok] created "):
        return None
    if stripped.startswith("[ok] duplicate detected:"):
        return "该资料已在知识库中，因此没有重复创建。"
    if stripped.startswith("[ok] initialized "):
        return "知识库基础结构已准备好。"
    if stripped.startswith("[ok] no matches"):
        return "没有找到匹配的知识条目。"
    if stripped.startswith("[ok] no pending confirmations"):
        return "目前没有需要你确认的判断。"
    if stripped.startswith(("[source]", "[auto]", "[checkpoint]", "[ok] git checkpoint:")):
        return None
    if any(field in stripped for field in ("backup_status=", "source_type=", "locator_kind=")):
        return None
    if stripped.startswith("[hint]") and "kb next" in stripped:
        return "资料已加入知识库。接下来可运行 kb next，Agent 会继续整理并判断下一步。"
    return None


def emit_public_output(text: str, root: Path, *, error: bool = False) -> bool:
    emitted = False
    destination = sys.stderr if error else sys.stdout
    for line in text.splitlines():
        human = _humanize_owner_line(line)
        if human is None:
            continue
        human = _public_display_text(human, root, "", 500)
        if not human:
            continue
        print(human, file=destination)
        emitted = emitted or bool(human.strip())
    return emitted


def render_help_menu() -> str:
    lines = ["# kb 快捷命令", ""]
    for group, items in HELP_MENU:
        lines.append(f"## {group}")
        for sentence, ai_phrase in items:
            lines.append(f"- {sentence} 也可以直接对 AI 说：\"{ai_phrase}\"。")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def script_path(root: Path, relative_path: str) -> Path:
    project_script = root / relative_path
    if project_script.exists():
        return project_script
    return DEFAULT_PROJECT_ROOT / relative_path


def build_child_argv(root: Path, relative_script: str, args: Sequence[str]) -> list[str]:
    return [research_python(), str(script_path(root, relative_script)), "--root", str(root), *args]


def forward_command(
    root: Path,
    relative_script: str,
    args: Sequence[str],
    *,
    stream: bool = True,
    extra_env: Mapping[str, str] | None = None,
) -> CommandResult:
    argv = build_child_argv(root, relative_script, args)
    env = {**os.environ, "RESEARCH_PROJECT_ROOT": str(root)}
    if extra_env:
        env.update({str(key): str(value) for key, value in extra_env.items()})
    completed = subprocess.run(argv, cwd=root, env=env, text=True, capture_output=True, check=False)
    result = CommandResult(
        tuple(argv),
        int(completed.returncode),
        completed.stdout or "",
        completed.stderr or "",
    )
    _record_protocol_child(result, relative_script, args)
    if result.returncode != 0:
        _capture_owner_failure(root, relative_script, result.returncode)
    if stream:
        stdout_emitted = emit_public_output(result.stdout, root)
        stderr_emitted = emit_public_output(result.stderr, root, error=True)
        if result.returncode != 0 and not stdout_emitted and not stderr_emitted:
            print("操作未完成；详细诊断已保留给 Agent。", file=sys.stderr)
    return result


def run_forwarded(
    root: Path,
    commands: Sequence[tuple[str, Sequence[str]]],
    *,
    stream: bool = True,
) -> int:
    for relative_script, args in commands:
        if stream:
            result = forward_command(root, relative_script, args)
        else:
            result = forward_command(root, relative_script, args, stream=False)
        if result.returncode != 0:
            return result.returncode
    return 0


def handle_help(args: argparse.Namespace, root: Path) -> int:
    del args, root
    print(render_help_menu(), end="")
    return 0


def _doctor_diagnostic_summary(root: Path) -> dict[str, object]:
    summary: dict[str, object] = {}
    policy_reader = _diagnostics_policy
    if policy_reader is None:
        summary["mode"] = "unavailable"
    else:
        try:
            raw_policy = policy_reader(root)
            policy = raw_policy if isinstance(raw_policy, Mapping) else {}
            raw_mode = str(policy.get("effective_mode") or policy.get("mode") or "").strip()
            summary["mode"] = raw_mode if raw_mode in _DIAGNOSTIC_MODES else "unknown"
            summary["local_only"] = bool(policy.get("local_only", True))
        except Exception:  # noqa: BLE001 - doctor remains useful if optional diagnostics fail
            summary["mode"] = "unavailable"
            _record_private_diagnostic_event("diagnostics-policy-read-failed", operation="doctor")

    audit_reader = _audit_workspace
    if audit_reader is None:
        summary["audit"] = {"available": False}
    else:
        try:
            raw_report = audit_reader(root)
            report = raw_report if isinstance(raw_report, Mapping) else {}
            raw_status = str(report.get("status") or "").upper()
            raw_counts = report.get("counts")
            counts = raw_counts if isinstance(raw_counts, Mapping) else {}
            safe_counts = {
                str(key): int(value)
                for key, value in counts.items()
                if str(key) in _AUDIT_COUNT_KEYS
                and isinstance(value, int)
                and not isinstance(value, bool)
                and value >= 0
            }
            summary["audit"] = {
                "available": True,
                "status": raw_status if raw_status in _AUDIT_STATUSES else "UNKNOWN",
                "counts": safe_counts,
            }
        except Exception:  # noqa: BLE001 - optional audit cannot break public doctor
            summary["audit"] = {"available": False}
            _record_private_diagnostic_event("workspace-audit-failed", operation="doctor")
    return summary


def handle_doctor(args: argparse.Namespace, root: Path) -> int:
    del args
    capabilities = current_runtime_capabilities()
    modules = capabilities.get("modules", {})
    venv_dir = managed_venv_dir(DEFAULT_PROJECT_ROOT)
    venv_py = managed_venv_python(DEFAULT_PROJECT_ROOT)
    yaml_ready = bool(capabilities.get("yaml_support"))
    markdown_ready = bool(capabilities.get("markdown_support"))
    pdf_backend = str(capabilities.get("pdf_backend") or "").strip()
    runtime_kind = "受管项目运行环境" if is_current_python(venv_py) else "当前已配置运行环境"
    raw_package_version = updater.read_local_version(DEFAULT_PROJECT_ROOT)
    public_version = _public_display_text(
        raw_package_version,
        root,
        "版本信息需由 Agent 安全解释",
        64,
    )
    print(f"研究能力包版本为 {public_version}。")
    print(f"{runtime_kind}可用；配置读写能力{'正常' if yaml_ready else '缺失'}。")
    print(f"材料 Markdown 阅读层转换能力{'已就绪' if markdown_ready else '尚未就绪'}。")
    if pdf_backend:
        print("论文解析能力已就绪。")
    else:
        print("论文解析能力尚未就绪；文本和网页资料仍可正常使用。")
    protocol_details: dict[str, object] = {
        "runtime": {
            "python": capabilities.get("python") or "",
            "version": capabilities.get("version") or "",
            "modules": modules if isinstance(modules, dict) else {},
            "yaml_support": yaml_ready,
            "markdown_support": markdown_ready,
            "pdf_backend": pdf_backend,
            "package_version": raw_package_version,
            "managed_runtime": {
                "directory": str(venv_dir),
                "python": str(venv_py),
                "exists": venv_py.exists(),
                "current": is_current_python(venv_py),
            },
        }
    }
    if _ACTIVE_PROTOCOL is not None:
        protocol_details["diagnostics"] = _doctor_diagnostic_summary(root)
    set_protocol_status("completed" if yaml_ready and markdown_ready else "runtime_incomplete", **protocol_details)
    return 0


def update_cache_dir() -> Path:
    return Path.home() / ".cache" / "research-skills"


def handle_update(args: argparse.Namespace, root: Path) -> int:
    cache_dir = update_cache_dir()
    if args.apply:
        result = updater.apply(root, cache_dir)
        if result.get("status") == "updated":
            before = _public_display_text(result.get("before", "0.0.0"), root, "未知", 64)
            after = _public_display_text(result.get("after", "0.0.0"), root, "未知", 64)
            print(f"研究能力包更新完成：{before} → {after}。")
            set_protocol_status("completed", update=result)
            return 0
        if result.get("status") == "up_to_date":
            print("当前研究能力包已是最新版本，无需更新。")
            set_protocol_status("completed", update=result)
            return 0
        if result.get("status") == "needs_source_choice":
            print("更新源尚未确认；请告诉我应继续使用哪个源码仓或本地检出。")
            set_protocol_status("needs_user_input", update=result)
            add_agent_action(
                "choose_update_source",
                fields=["source_origin", "source_checkout"],
                reason=str(result.get("message") or "missing update provenance"),
            )
            return 2
        print("研究能力包更新未完成；详细诊断已保留给 Agent。")
        set_protocol_status("error", update=result)
        return 1

    result = updater.check(root, cache_dir)
    set_protocol_status("completed", update=result)
    local = _public_display_text(result.get("local") or "0.0.0", root, "未知", 64)
    remote = _public_display_text(result.get("remote") or "unknown", root, "未知", 64)
    print(f"当前研究能力包版本：{local}。")
    if result.get("status") == "needs_source_choice":
        print("更新源尚未确认；请告诉我应继续使用哪个源码仓或本地检出。")
        set_protocol_status("needs_user_input", update=result)
        add_agent_action(
            "choose_update_source",
            fields=["source_origin", "source_checkout"],
            reason=str(result.get("message") or "missing update provenance"),
        )
        return 0
    if result.get("status") == "unknown":
        print("更新源中的研究能力包版本：未知。")
        print("暂时无法从更新源检查更新；当前安装未做任何改动。")
        return 0
    print(f"更新源中的研究能力包版本：{remote}。")
    if result.get("status") == "update_available":
        print("发现可用更新；确认前不会修改当前安装。")
        print("如果你同意，我可以继续完成更新。")
        set_protocol_status("needs_user_authorization", update=result)
        add_agent_action("request_update_authorization", then={"verb": "update", "apply": True})
    else:
        print("当前研究能力包已是最新版本。")
    return 0


def handle_obsidian(args: argparse.Namespace, root: Path) -> int:
    action = str(args.action or "")
    if action == "status":
        report = obsidian_projection_status(root)
        set_protocol_status("completed" if report["status"] != "FAIL" else "attention_required", obsidian=report)
        codes = {str(item.get("code") or "") for item in report.get("findings", [])}
        if report["status"] == "PASS":
            if int(report["counts"].get("records") or 0) == 0 and not report.get("generated_at"):
                print("知识库目前为空；Obsidian 视图无需生成。")
            else:
                print("Obsidian 知识网络视图已是最新状态。")
            return 0
        if report["status"] == "WARN" and codes <= {
            "OBSIDIAN_PROJECTION_NOT_GENERATED",
            "OBSIDIAN_PROJECTION_STALE",
            "OBSIDIAN_LEGACY_REVERSE_LINK",
        }:
            print("Obsidian 知识网络视图需要刷新；可运行 kb obsidian update。")
            return 0
        print("Obsidian 知识网络视图存在需要处理的链接或文件问题；详细诊断已保留给 Agent。")
        return 1 if report["status"] == "FAIL" else 0

    try:
        result = update_obsidian_projection(root)
    except SystemExit as exc:
        set_protocol_status("error", obsidian={"error": str(exc)})
        print("Obsidian 知识网络视图未更新；检测到可能覆盖人工内容或不安全路径，详细诊断已保留给 Agent。")
        return 1
    report = result["status"]
    set_protocol_status("completed" if report["status"] != "FAIL" else "attention_required", obsidian=result)
    if result["changed"]:
        print("Obsidian 知识网络视图已更新，可直接在 Obsidian 中查看。")
    else:
        print("Obsidian 知识网络视图已是最新状态，无需更新。")
    if report["status"] == "FAIL":
        print("视图已保留，但其中有无法解析的知识链接；详细诊断已保留给 Agent。")
    elif report["status"] == "WARN":
        print("视图已生成；部分旧式关系仍以兼容方式展示，详细诊断已保留给 Agent。")
    return 0


def _public_program_label(program_id: object, root: Path) -> str:
    raw_program_id = str(program_id or "").strip()
    if not raw_program_id:
        return ""
    if "loose:" in raw_program_id.casefold():
        return "名称需由 Agent 安全解释"
    return _public_display_text(raw_program_id, root, "名称需由 Agent 安全解释", 100)


def handle_status(args: argparse.Namespace, root: Path) -> int:
    public_program = _public_program_label(args.program, root)
    current = forward_command(
        root,
        SCRIPT_BY_VERB["status_current"],
        ["current-state"],
        stream=False,
    )
    if current.returncode != 0:
        print("知识库状态暂时无法读取；详细诊断已保留给 Agent。", file=sys.stderr)
        return current.returncode

    program_state: dict[str, object] = {}
    if args.program:
        program_result = forward_command(
            root,
            SCRIPT_BY_VERB["status_program"],
            ["status", "--program-id", args.program],
            stream=False,
        )
        if program_result.returncode != 0:
            print(f"没有找到研究计划「{public_program}」；请检查名称后重试。", file=sys.stderr)
            return program_result.returncode
        loaded_state = load_yaml(kb_root(root) / "programs" / args.program / "state.yaml", default={})
        program_state = loaded_state if isinstance(loaded_state, dict) else {}

    all_records = iter_records(root)
    rejected_records = [record for record in all_records if _record_is_rejected(record)]
    records = [record for record in all_records if not _record_is_rejected(record)]
    kind_counts = {
        kind: len([record for record in records if str(record.get("kind") or "") == kind])
        for kind in PUBLIC_KIND_LABELS
    }
    count_parts = [
        f"{count} {PUBLIC_KIND_COUNT_PHRASES[kind]}"
        for kind, count in kind_counts.items()
        if count
    ]
    if records:
        print(f"知识库目前收录 {len(records)} 条资料：{'、'.join(count_parts)}。")
    else:
        print("知识库尚未收录资料。")
    ready_count = len([record for record in records if is_ready_for_human_review(record)])
    if ready_count:
        print(f"其中有 {ready_count} 条经过核验的判断等待你确认，可使用 kb review 查看。")

    if args.program:
        raw_focus = str(program_state.get("goal") or program_state.get("question") or "").strip()
        focus = _public_display_text(raw_focus, root, "研究重点需由 Agent 安全解释", 180) if raw_focus else ""
        if focus:
            print(f"研究计划「{public_program}」当前围绕“{focus}”推进。")
        else:
            print(f"研究计划「{public_program}」的状态已读取。")
        counts = program_state.get("counts") if isinstance(program_state.get("counts"), dict) else {}
        open_questions = _natural_count(counts.get("open_questions"))
        evidence_requests = _natural_count(counts.get("evidence_requests"))
        if open_questions or evidence_requests:
            print(f"目前还有 {open_questions} 个待处理问题和 {evidence_requests} 项待补证据。")

    program_ids = [path.parent.name for path in sorted((kb_root(root) / "programs").glob("*/state.yaml"))]
    set_protocol_status(
        "completed",
        record_count=len(records),
        rejected_count=len(rejected_records),
        total_record_count=len(all_records),
        ready_review_count=ready_count,
        kind_counts=kind_counts,
        program_ids=program_ids,
        selected_program=program_state,
    )
    return 0


def _next_item_needs_human(item: dict[str, object]) -> bool:
    return str(item.get("step_type") or "") == "human-decision"


_NEXT_LOOSE_UNIT_STEP_TYPES = frozenset(
    {"agent-fill", "agent-verify", "generate-note", "human-decision", "refresh", "screen"}
)


def _next_item_record_id(item: Mapping[str, object]) -> str:
    """Return identity only for an explicit synthetic loose-unit item."""
    record_id = str(item.get("record_id") or "").strip()
    program_id = str(item.get("program_id") or "")
    step_type = str(item.get("step_type") or "")
    stage = str(item.get("stage") or "")
    if (
        record_id
        and program_id.startswith("loose:")
        and stage == "loose-unit"
        and step_type in _NEXT_LOOSE_UNIT_STEP_TYPES
    ):
        return record_id
    return ""


def _next_public_reason(item: dict[str, object], root: Path) -> str:
    step_type = str(item.get("step_type") or "")
    action_kind = str(item.get("action_kind") or "")
    if _next_item_needs_human(item):
        return "已有经过核验的判断，等待你确认。"
    if step_type == "agent-fill":
        return "Agent 需要补全有逐字证据的分析。"
    if step_type == "agent-verify":
        return "Agent 需要核验分析与逐字证据。"
    if step_type == "screen":
        return "Agent 需要先做初步筛选。"
    if step_type == "generate-note":
        return "Agent 需要整理有逐字证据支持的摘要。" if action_kind == "blog" else "Agent 需要整理完整分析。"
    if step_type == "refresh":
        return "Agent 需要刷新资料结构或分析。"
    next_action = str(item.get("next_action") or "").strip()
    known_prefixes = {
        "Resolve blocking evidence: ": "需要补充关键证据：",
        "Answer high-priority question: ": "需要回答高优先级问题：",
        "Review pending confirmation: ": "有一条经过核验的判断等待你确认：",
        "Review program stage and next actions.": "需要检查当前研究阶段并确定下一步。",
    }
    for prefix, replacement in known_prefixes.items():
        if next_action.startswith(prefix):
            translated = replacement + next_action[len(prefix) :]
            if not any(
                marker.casefold() in translated.casefold() for marker in _NEXT_INTERNAL_MARKERS
            ):
                return _public_display_text(
                    translated,
                    root,
                    "Agent 可以继续推进当前研究事项。",
                    180,
                )
            return "Agent 可以继续推进当前研究事项。"
    if (
        not next_action
        or not _public_line_is_safe(next_action, root)
        or any(marker.casefold() in next_action.casefold() for marker in _NEXT_INTERNAL_MARKERS)
    ):
        return "Agent 可以继续推进当前研究事项。"
    return _public_display_text(next_action, root, "Agent 可以继续推进当前研究事项。", 180)


def _print_next_items(items: list[dict[str, object]], *, has_records: bool, root: Path) -> None:
    if not items:
        if has_records:
            print("知识库已有资料，但目前没有待处理事项。")
        else:
            print("知识库还是空的。请告诉我一篇论文、一个代码仓或一篇博客的来源，或使用 kb ingest 添加资料。")
        return
    print("接下来最值得推进的是：")
    for item in items:
        program_id = str(item.get("program_id") or "")
        record_id = _next_item_record_id(item)
        if record_id:
            title = str(item.get("title") or item.get("goal") or record_id)
            public_record_id = _public_display_text(record_id, root, "编号已隐藏", 100)
            public_title = _public_display_text(title, root, "标题需由 Agent 安全解释", 160)
            subject = f"资料「{public_title}」（{public_record_id}）"
        else:
            public_program = _public_program_label(program_id, root)
            subject = f"研究计划「{public_program}」"
        print(f"- {subject}：{_next_public_reason(item, root)}")
    if any(_next_item_needs_human(item) for item in items):
        print("请直接用自然语言告诉我你的决定；其他事项可以交给 Agent 继续推进。")
    else:
        print("可以直接告诉 Agent 继续推进这些事项。")


def handle_next(args: argparse.Namespace, root: Path) -> int:
    forwarded_args = ["next", "--json"]
    if args.program:
        forwarded_args.extend(["--program-id", args.program])
    result = forward_command(root, SCRIPT_BY_VERB["next"], forwarded_args, stream=False)
    if result.returncode != 0:
        if args.program:
            public_program = _public_program_label(args.program, root)
            print(f"没有找到研究计划「{public_program}」；请检查名称后重试。", file=sys.stderr)
        else:
            print("暂时无法判断下一步；详细诊断已保留给 Agent。", file=sys.stderr)
        return result.returncode
    try:
        payload = json.loads(result.stdout)
    except (json.JSONDecodeError, TypeError):
        print("暂时无法判断下一步；详细诊断已保留给 Agent。", file=sys.stderr)
        set_protocol_status("error", reason="invalid orchestrator protocol")
        return 1
    raw_items = payload.get("items") if isinstance(payload, dict) else []
    items = [dict(item) for item in raw_items if isinstance(item, dict)] if isinstance(raw_items, list) else []
    has_records = bool(payload.get("has_records")) if isinstance(payload, dict) else False
    workspace_records = iter_records(root)
    rejected_records = [record for record in workspace_records if _record_is_rejected(record)]
    rejected_ids = {str(record.get("id") or "").strip() for record in rejected_records}
    rejected_ids.discard("")
    if rejected_records:
        active_records = [record for record in workspace_records if not _record_is_rejected(record)]
        has_records = bool(active_records)
        items = [item for item in items if _next_item_record_id(item) not in rejected_ids]
    human_gate = any(_next_item_needs_human(item) for item in items)
    set_protocol_status(
        "needs_user_authorization" if human_gate else ("agent_action_required" if items else "completed"),
        has_records=has_records,
        item_count=len(items),
        items=items,
        rejected_count=len(rejected_records),
    )
    for item in items:
        add_agent_action(
            "request_user_decision" if _next_item_needs_human(item) else "continue_research_work",
            item=item,
        )
    _print_next_items(items, has_records=has_records, root=root)
    return 0


def _protocol_record_summary(record: dict[str, object]) -> dict[str, object]:
    return {
        "id": str(record.get("id") or ""),
        "kind": str(record.get("kind") or ""),
        "title": str(record.get("title") or ""),
        "summary": str(record.get("summary") or ""),
        "workflow_state": record_workflow_state(record),
    }


def handle_find(args: argparse.Namespace, root: Path) -> int:
    query = " ".join(args.keywords).strip()
    if not query:
        raise SystemExit("kb find requires at least one keyword.")
    result = forward_command(
        root,
        SCRIPT_BY_VERB["find"],
        ["query", "--query", query],
        stream=False,
    )
    if result.returncode != 0:
        print("检索暂时未完成；详细诊断已保留给 Agent。", file=sys.stderr)
        return result.returncode
    matched_records = search_records(root, query)
    rejected_records = [record for record in matched_records if _record_is_rejected(record)]
    records = [record for record in matched_records if not _record_is_rejected(record)]
    summaries = [_protocol_record_summary(record) for record in records]
    set_protocol_status(
        "completed",
        query=query,
        result_count=len(summaries),
        rejected_count=len(rejected_records),
        records=summaries,
    )
    if not records:
        print("没有找到匹配的知识条目。")
        return 0
    print(f"找到 {len(records)} 条相关资料：")
    for record in records:
        raw_unit_id = str(record.get("id") or "")
        raw_title = str(record.get("title") or raw_unit_id)
        unit_id = _public_display_text(raw_unit_id, root, "编号已隐藏", 100)
        title = _public_display_text(raw_title, root, "标题需由 Agent 安全解释", 160)
        kind = PUBLIC_KIND_LABELS.get(str(record.get("kind") or ""), "知识")
        print(f"- {kind}「{title}」（{unit_id}）")
        raw_summary = str(record.get("summary") or "").strip()
        if raw_summary:
            summary = _public_display_text(
                raw_summary,
                root,
                "摘要包含不适合直接展示的内容，请让 Agent 安全解释。",
                240,
            )
            print(f"  摘要：{summary}")
        workflow_state = record_workflow_state(record)
        if workflow_state == "ready_for_review":
            print("  这条判断已经核验，等待你确认；可使用 kb review 查看。")
        elif workflow_state in {"source_ready", "awaiting_agent_fill", "ready_to_verify", "failed_retryable"}:
            print("  Agent 还需要继续整理或核验这条资料。")
    return 0


def handle_recall(args: argparse.Namespace, root: Path) -> int:
    kind = args.kind or "all"
    owner_kind = "prefs" if kind == "habits" else kind
    result = forward_command(
        root,
        SCRIPT_BY_VERB["recall"],
        ["recall", "--kind", owner_kind],
        stream=False,
    )
    if result.returncode != 0:
        print("回忆信息暂时无法读取；详细诊断已保留给 Agent。", file=sys.stderr)
        return result.returncode
    print(render_public_recall(result.stdout, kind, root), end="")
    return 0


_RECALL_OWNER_SECTIONS = {
    "Known habits": "habits",
    "Known gotchas": "gotchas",
    "Pending skill defects": "defects",
}

_RECALL_PUBLIC_LABELS = {
    "habits": "已确认的习惯",
    "gotchas": "已确认的已知坑",
    "defects": "待审能力问题",
}


def _public_recall_entry(line: str) -> str:
    payload = re.sub(r"^-\s*`[^`]+`\s*", "", line.strip())
    payload = re.sub(r"\s*\[skill:\s*[^\]]*\]\s*$", "", payload)
    occurrence = re.search(r"\s*\(x(\d+)\)\s*$", payload)
    if occurrence:
        payload = payload[: occurrence.start()].rstrip()
        return f"{payload}（出现 {occurrence.group(1)} 次）"
    return payload.strip()


def _recall_sections(owner_text: str) -> tuple[dict[str, list[str]], int]:
    sections = {key: [] for key in _RECALL_PUBLIC_LABELS}
    current = ""
    pending_defect_count = 0
    for raw_line in owner_text.splitlines():
        line = raw_line.strip()
        if line in _RECALL_OWNER_SECTIONS:
            current = _RECALL_OWNER_SECTIONS[line]
            continue
        pending_match = re.fullmatch(r"Pending skill defects:\s*(\d+)", line)
        if pending_match:
            pending_defect_count = int(pending_match.group(1))
            current = ""
            continue
        if not current or not line.startswith("-") or line == "- none":
            continue
        entry = _public_recall_entry(line)
        if entry:
            sections[current].append(entry)
    if sections["defects"]:
        pending_defect_count = len(sections["defects"])
    return sections, pending_defect_count


def render_public_recall(owner_text: str, kind: str, root: Path) -> str:
    sections, pending_defect_count = _recall_sections(owner_text)
    selected = ("habits", "gotchas", "defects") if kind == "all" else (kind,)
    lines: list[str] = []
    for section in selected:
        label = _RECALL_PUBLIC_LABELS[section]
        entries = sections[section]
        if entries:
            lines.append(f"{label}：")
            lines.extend(
                f"- {_public_display_text(entry, root, '该条回忆需由 Agent 安全解释', 200)}"
                for entry in entries
            )
        elif section == "defects" and pending_defect_count:
            lines.append(f"{label}：{pending_defect_count} 条。")
        else:
            lines.append(f"{label}：暂无。")
    return "\n".join(lines) + "\n"


def _run_public_recovery(root: Path, action: str, action_args: Sequence[str]) -> int:
    result = forward_command(
        root,
        SCRIPT_BY_VERB["recovery"],
        [action, *action_args],
        stream=False,
    )
    if result.returncode != 0:
        private_diagnostic = f"{result.stdout}\n{result.stderr}"
        if action == "restore" and "Unknown operation:" in private_diagnostic:
            message = "没有找到对应的知识库操作；请检查编号后重试。"
        elif action == "undo" and "没有可撤销的已提交操作" in private_diagnostic:
            message = "目前没有可撤销的知识库操作。"
        elif action == "undo":
            message = "知识库撤销未完成；详细诊断已保留给 Agent。"
        else:
            message = "知识库恢复未完成；详细诊断已保留给 Agent。"
        print(message, file=sys.stderr)
        return result.returncode

    if action == "resume":
        if "没有未完成操作需要恢复" in result.stdout:
            print("目前没有未完成操作需要恢复。")
        else:
            print("未完成的知识库操作已安全恢复。")
    elif action == "undo":
        print("最近一次知识库操作已撤销。若还需要，可再次使用 kb undo 撤销更早的操作。")
    else:
        print("知识库已恢复到指定操作之前的状态。")
    return 0


def handle_undo(args: argparse.Namespace, root: Path) -> int:
    del args
    return _run_public_recovery(root, "undo", [])


def handle_resume(args: argparse.Namespace, root: Path) -> int:
    del args
    return _run_public_recovery(root, "resume", [])


def handle_restore(args: argparse.Namespace, root: Path) -> int:
    return _run_public_recovery(root, "restore", [args.op_id])


def handle_reject(args: argparse.Namespace, root: Path) -> int:
    """Mark a mis-created / not-adopted unit as rejected (F1 cleanup exit).

    Pure dispatch: forwards to knowledge-base-manager's existing
    `promote --confirmation-status rejected` (the same reject path `kb review`
    uses). No reject logic is reimplemented here.
    """
    reject_args = ["promote", "--id", args.id, "--confirmation-status", "rejected"]
    reason = str(getattr(args, "reason", "") or "").strip()
    if reason:
        reject_args.extend(["--evidence", reason])
    result = forward_command(root, SCRIPT_BY_VERB["review"], reject_args, stream=False)
    public_id = _public_display_text(args.id, root, "编号已隐藏", 100)
    if result.returncode != 0:
        print(f"未能拒绝知识条目「{public_id}」；请检查编号后重试。", file=sys.stderr)
        return result.returncode
    set_protocol_status("completed", rejected_id=args.id)
    add_agent_action("undo_rejection", apply={"verb": "undo"})
    print(f"知识条目「{public_id}」已拒绝。若这是误操作，可使用 kb undo 撤销。")
    return 0


def _looks_like_repo_dir(path: Path) -> bool:
    """A local directory is a code checkout (repo), not a blog.

    Treat any directory as a repo; strengthen the signal when it carries a `.git`
    marker or a README alongside a source/config structure. The mere fact that a
    local reference resolves to a directory is enough to prefer `repo` over the
    `blog` fallback (F1: a cloned repo dir was mis-created as a blog unit).
    """
    try:
        if not path.is_dir():
            return False
    except OSError:
        return False
    return True


def infer_add_kind(source: str, root: Path | None = None) -> str:
    normalized = source.strip()
    lowered = normalized.lower()
    path_part = lowered.split("#", 1)[0].split("?", 1)[0]
    # Remote URLs / git refs: decide from the URL shape, never touch the filesystem.
    if lowered.startswith(("http://", "https://")):
        if "arxiv.org" in lowered or path_part.endswith(".pdf"):
            return "paper"
        if "huggingface.co/datasets/" in lowered:
            return "dataset"
        if "github.com" in lowered or "gitlab.com" in lowered or "bitbucket.org" in lowered:
            return "repo"
        return "blog"
    if lowered.startswith("git@") or lowered.endswith(".git"):
        return "repo"
    # Local reference: a directory (git checkout / source tree) is a repo, not a blog.
    candidate = Path(normalized).expanduser()
    probes = [candidate]
    if root is not None and not candidate.is_absolute():
        probes.insert(0, root / candidate)
    for probe in probes:
        if _looks_like_repo_dir(probe):
            return "repo"
        try:
            if probe.is_file():
                return "paper" if probe.suffix.lower() == ".pdf" else "blog"
        except OSError:
            continue
    # Unresolved local string: fall back to arxiv/pdf hints, else blog.
    if "arxiv.org" in lowered or path_part.endswith(".pdf"):
        return "paper"
    return "blog"


def _unsafe_local_source_result(source: str, root: Path) -> int | None:
    """Fail closed before an owner process can create identities or snapshots."""
    if source.strip().lower().startswith(("http://", "https://", "git@")):
        return None
    try:
        validate_local_source(root, source)
    except UnsafeLocalSourceError as exc:
        print("这份本地资料包含不安全的链接或文件类型，已停止入库；请改用不含符号链接的普通文件或目录。", file=sys.stderr)
        set_protocol_status("rejected_unsafe_source", reason=str(exc), source=source)
        return 2
    return None


def handle_add(args: argparse.Namespace, root: Path) -> int:
    unsafe_result = _unsafe_local_source_result(args.source, root)
    if unsafe_result is not None:
        return unsafe_result
    kind = args.kind or infer_add_kind(args.source, root)
    result = forward_command(
        root,
        SCRIPT_BY_VERB["add"],
        ["add", "--kind", kind, "--source", args.source],
        stream=False,
    )
    if result.returncode != 0:
        print("资料未能加入知识库；详细诊断已保留给 Agent。", file=sys.stderr)
        return result.returncode
    emitted = emit_public_output(result.stdout, root)
    emitted = emit_public_output(result.stderr, root, error=True) or emitted
    if not emitted:
        print("资料已加入知识库。")
    return 0


# --------------------------------------------------------------------------- #
# ingest: chain the scriptable prefix of the ingestion pipeline (SSOT §7).      #
#                                                                              #
# `kb ingest <src>` runs intake add -> first analyzer prepare and STOPS there.  #
# For papers that first prepare is screening: the session agent must verify the #
# agent-authored paper_type before preparing the type-specific note. Scripts     #
# never auto-run verify because they cannot fill understanding.                  #
# --------------------------------------------------------------------------- #

# Governance ceiling for ingest safe auto-steps, mirroring research-orchestrator's
# GOVERNANCE_MAX_AUTO_STEPS. runtime-preferences.autonomy.auto_execute_scope may
# NARROW this but can never widen it; verify/confirm are never in the set.
INGEST_GOVERNANCE_MAX_AUTO_STEPS = frozenset({"screen", "build-index", "refresh", "generate-note"})

# Ordered ingest chain: (step, gating scope token). intake landing is a
# "screen"-class safe step; prepare (fillable skeleton) is a "generate-note"-class
# safe step. Walk in order; a narrowed scope stops the chain at the first gap.
INGEST_ANALYZER: dict[str, tuple[str, str, str]] = {
    "paper": (".agents/skills/paper-analyst/scripts/paper.py", "screen", "--paper-id"),
    "repo": (".agents/skills/repo-analyst/scripts/repo.py", "map-capability", "--repo-id"),
    "dataset": (".agents/skills/dataset-analyst/scripts/dataset.py", "profile", "--dataset-id"),
    "blog": (".agents/skills/blog-analyst/scripts/blog.py", "complete-note", "--blog-id"),
}


def effective_ingest_scope(root: Path) -> set[str]:
    """Configured auto_execute_scope intersected with the governance ceiling."""
    try:
        configured = load_runtime_preferences(root).get("autonomy", {}).get("auto_execute_scope", [])
    except Exception:  # noqa: BLE001
        configured = sorted(INGEST_GOVERNANCE_MAX_AUTO_STEPS)
    if not isinstance(configured, list):
        configured = sorted(INGEST_GOVERNANCE_MAX_AUTO_STEPS)
    return {str(item).strip() for item in configured if str(item).strip()} & set(INGEST_GOVERNANCE_MAX_AUTO_STEPS)


def _extract_ingest_unit_id(stdout: str) -> tuple[str, str]:
    """Parse (unit_id, status) from intake add stdout.

    status is "created" | "duplicate" | "unknown". A duplicate must NOT be
    re-prepared (re-scaffolding would blank an agent's in-progress fill), so the
    caller stops and reports it.
    """
    created = re.search(r"\[ok\] created\s+.*?/([^/\s]+)/record\.yaml", stdout)
    if created:
        return created.group(1), "created"
    duplicate = re.search(r"\[ok\] duplicate detected:\s*(\S+)", stdout)
    if duplicate:
        return duplicate.group(1), "duplicate"
    return "", "unknown"


def handle_ingest(args: argparse.Namespace, root: Path) -> int:
    unsafe_result = _unsafe_local_source_result(args.source, root)
    if unsafe_result is not None:
        return unsafe_result
    kind = args.kind or infer_add_kind(args.source, root)
    if kind not in INGEST_ANALYZER:
        print("暂时无法判断资料类型；请告诉我是论文、代码仓还是技术文章。")
        set_protocol_status("needs_user_input", inferred_kind=kind)
        add_agent_action("choose_source_kind", choices=list(INGEST_ANALYZER))
        return 2
    scope = effective_ingest_scope(root)

    # Step 1: intake add (safe step gated by "screen") — the scriptable half before
    # the agent fills. RESEARCH_INGEST_CHAIN tells intake the chain auto-continues.
    if "screen" not in scope:
        print("当前自动化偏好暂停了这次入库；如果你愿意，我可以继续。")
        set_protocol_status("paused_by_autonomy", source_kind=kind)
        add_agent_action(
            "run_owner_step_after_authorization",
            owner=SCRIPT_BY_VERB["add"],
            arguments=["add", "--kind", kind, "--source", args.source],
        )
        return 0

    intake = forward_command(
        root,
        SCRIPT_BY_VERB["add"],
        ["add", "--kind", kind, "--source", args.source],
        stream=False,
        extra_env={"RESEARCH_INGEST_CHAIN": "1"},
    )
    if intake.returncode != 0:
        print("资料未能加入知识库；详细诊断已保留给 Agent。", file=sys.stderr)
        return intake.returncode

    unit_id, status = _extract_ingest_unit_id(intake.stdout)
    public_unit_id = _public_display_text(unit_id, root, "编号已隐藏", 100) if unit_id else ""
    if status == "duplicate":
        print(f"知识条目 {public_unit_id} 已存在；为保护已有工作，本次没有重新生成骨架。")
        set_protocol_status("duplicate", unit_id=unit_id, source_kind=kind)
        return 0
    if not unit_id:
        print("资料已交给入库流程，但暂时无法确认新条目编号；Agent 会检查详细结果。")
        set_protocol_status("error", source_kind=kind, reason="created unit id was not returned")
        return 1

    # Step 2: analyzer prepare (safe step gated by "generate-note") — produces the
    # fillable skeleton. NEVER verify (a script cannot fill understanding).
    if "generate-note" not in scope:
        paused_stage = "初筛准备" if kind == "paper" else "深读准备"
        print(f"资料已入库为 {public_unit_id}；当前自动化偏好暂停了{paused_stage}。")
        relative_script, verb, id_flag = INGEST_ANALYZER[kind]
        set_protocol_status("paused_by_autonomy", unit_id=unit_id, source_kind=kind)
        add_agent_action(
            "prepare_unit_after_authorization",
            owner=relative_script,
            arguments=[verb, id_flag, unit_id, "--phase", "prepare"],
        )
        return 0

    relative_script, verb, id_flag = INGEST_ANALYZER[kind]
    prepare = forward_command(
        root,
        relative_script,
        [verb, id_flag, unit_id, "--phase", "prepare"],
        stream=False,
    )
    if prepare.returncode != 0:
        failed_stage = "初筛准备" if kind == "paper" else "深读准备"
        print(f"资料已入库，但{failed_stage}未完成；详细诊断已保留给 Agent。")
        set_protocol_status("error", unit_id=unit_id, source_kind=kind, stage="prepare")
        return prepare.returncode

    if kind == "paper":
        print(
            f"资料已入库并备好初筛骨架，条目编号是 {public_unit_id}。"
            "Agent 接下来会先用逐字证据确定论文类型，再生成对应的深读笔记；需要判断时再请你拍板。"
        )
    else:
        print(f"资料已入库并备好深读骨架，条目编号是 {public_unit_id}。Agent 接下来会补全逐字证据并校验；需要判断时再请你拍板。")
    verify_arguments = [verb, id_flag, unit_id, "--phase", "verify"]
    if kind == "paper":
        note_prepare_arguments = ["complete-note", id_flag, unit_id, "--phase", "prepare"]
        note_verify_arguments = ["complete-note", id_flag, unit_id, "--phase", "verify"]
        remaining_steps: list[dict[str, object]] = [
            {
                "step": "fill_grounded_screening",
                "source": "parse_cache",
                "requirements": [
                    "paper_type",
                    "worth_deep_reading",
                    "judgement_reason",
                    "relevance_to_current_research",
                    "verbatim_quote",
                    "locator",
                ],
            },
            {"step": "verify_screening", "owner": relative_script, "arguments": verify_arguments},
            {
                "step": "prepare_type_specific_note",
                "owner": relative_script,
                "arguments": note_prepare_arguments,
                "requires": "verified_screening",
            },
            {
                "step": "fill_grounded_elements",
                "source": "parse_cache",
                "element_set_source": "verified_screening.paper_type_or_method_system_fallback",
                "requirements": ["verbatim_quote", "locator"],
            },
            {
                "step": "verify_note",
                "owner": relative_script,
                "arguments": note_verify_arguments,
                "includes_configured_post_note_actions": True,
            },
        ]
    else:
        remaining_steps = [
            {
                "step": "fill_grounded_elements",
                "source": "parse_cache",
                "requirements": ["verbatim_quote", "locator"],
            },
            {"step": "verify", "owner": relative_script, "arguments": verify_arguments},
        ]
    remaining_steps.append(
        {
            "step": "request_user_confirmation",
            "fields": ["user_authorization", "authorization_source", "evidence"],
            "authorization_source": "user_message",
        }
    )
    set_protocol_status("agent_action_required", unit_id=unit_id, source_kind=kind)
    add_agent_action(
        "complete_grounded_ingest",
        unit_id=unit_id,
        source_kind=kind,
        prepare_output=prepare.stdout,
        steps=remaining_steps,
    )
    return 0


def bool_text(value: object, default: str = "true") -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    text = str(value or "").strip().lower()
    return text if text in AUTO_SCREEN_CHOICES else default


def language_text(value: object, default: str = "zh") -> str:
    text = str(value or "").strip().lower()
    if text.startswith("zh"):
        return "zh"
    if text.startswith("en"):
        return "en"
    return default


def runtime_pref_defaults(root: Path) -> dict[str, object]:
    preferences = load_runtime_preferences(root)
    identity = preferences.get("identity", {}) if isinstance(preferences.get("identity"), dict) else {}
    paper = preferences.get("paper", {}) if isinstance(preferences.get("paper"), dict) else {}
    versioning = preferences.get("versioning", {}) if isinstance(preferences.get("versioning"), dict) else {}
    profile = load_yaml(config_root(root) / "user-profile.yaml", default={})
    profile_preferences = profile.get("preferences", {}) if isinstance(profile, dict) and isinstance(profile.get("preferences"), dict) else {}
    personalization = profile.get("personalization", {}) if isinstance(profile, dict) and isinstance(profile.get("personalization"), dict) else {}
    profile_resources = profile.get("resources", {}) if isinstance(profile, dict) else {}
    resources = dict(profile_resources) if isinstance(profile_resources, dict) else {}
    raw_constraints = profile.get("constraints", []) if isinstance(profile, dict) else []
    constraints = list(raw_constraints) if isinstance(raw_constraints, list) else []
    terminology_style = str(
        personalization.get("term_style")
        or profile_preferences.get("terminology_style")
        or "keep-en"
    ).strip()
    research_focus = str(
        personalization.get("research_focus")
        or profile_preferences.get("research_focus")
        or ""
    ).strip()
    resource_statement = str(
        resources.get("quick_setup")
        or personalization.get("resources")
        or ""
    ).strip()
    return {
        "name": str(identity.get("default_confirmed_by") or "").strip(),
        "lang": language_text(profile_preferences.get("language_preference", "zh")),
        "terminology_style": terminology_style,
        "research_focus": research_focus,
        "resource_statement": resource_statement,
        "resources": resources,
        "constraints": constraints,
        "resources_and_constraints": {
            "resource_statement": resource_statement,
            "resources": resources,
            "constraints": constraints,
        },
        "auto_commit": str(versioning.get("auto_commit_mode") or "milestone").strip().lower(),
        "auto_screen": bool_text(paper.get("auto_screen_on_intake", True)),
    }


def public_init_defaults_summary(defaults: Mapping[str, object]) -> str:
    """Describe only allowlisted init defaults; never echo configuration text."""
    language_label = {
        "zh": "中文",
        "en": "英文",
    }.get(str(defaults.get("lang") or "").strip().lower(), "保留现有语言设置")
    commit_label = {
        "manual": "手动版本记录",
        "milestone": "里程碑版本记录",
        "aggressive": "高频版本记录",
    }.get(str(defaults.get("auto_commit") or "").strip().lower(), "保留现有版本记录设置")
    screening_label = {
        "true": "论文自动初筛开启",
        "false": "论文自动初筛关闭",
    }.get(str(defaults.get("auto_screen") or "").strip().lower(), "保留现有论文初筛设置")
    return f"选择“默认即可”会保留当前设置：{language_label}、{commit_label}、{screening_label}。"


def config_set_profile_command(key: str, value: str) -> tuple[str, Sequence[str]]:
    return (SCRIPT_BY_VERB["init_config"], ["set", "--key", key, "--value", value])


def config_set_runtime_pref_command(section: str, key: str, value: str) -> tuple[str, Sequence[str]]:
    return (
        SCRIPT_BY_VERB["init_config"],
        ["set-runtime-pref", "--section", section, "--key", key, "--value", value],
    )


def build_init_pref_commands(*, name: str, lang: str, auto_commit: str, auto_screen: str) -> list[tuple[str, Sequence[str]]]:
    return [
        config_set_runtime_pref_command("identity", "default_confirmed_by", name),
        config_set_profile_command("preferences.language_preference", lang),
        config_set_runtime_pref_command("versioning", "auto_commit_mode", auto_commit),
        config_set_runtime_pref_command("paper", "auto_screen_on_intake", auto_screen),
    ]


def build_headless_init_pref_commands(
    args: argparse.Namespace,
    root: Path,
) -> list[tuple[str, Sequence[str]]] | None:
    persona_values = [
        ("personalization.research_focus", getattr(args, "persona_focus", None)),
        ("personalization.resources", getattr(args, "persona_resources", None)),
        ("personalization.reporting_style", getattr(args, "persona_report", None)),
        ("personalization.collaboration_boundaries", getattr(args, "persona_boundaries", None)),
        ("personalization.term_style", getattr(args, "persona_term", None)),
    ]
    if (
        args.name is None
        and args.lang is None
        and args.auto_commit is None
        and args.auto_screen is None
        and getattr(args, "quick_resource", None) is None
        and getattr(args, "quick_constraints", None) is None
        and all(value is None for _, value in persona_values)
    ):
        return None
    commands: list[tuple[str, Sequence[str]]] = []
    if args.name is not None:
        name = str(args.name or "").strip()
        if not name:
            raise SystemExit("确认人姓名不能为空。")
        if is_ai_signer(name):
            raise SystemExit("确认人必须是真实用户，不能使用 AI 工具名称。")
        commands.append(config_set_runtime_pref_command("identity", "default_confirmed_by", name))
    if args.lang is not None:
        commands.append(config_set_profile_command("preferences.language_preference", args.lang))
    if args.auto_commit is not None:
        commands.append(config_set_runtime_pref_command("versioning", "auto_commit_mode", args.auto_commit))
    if args.auto_screen is not None:
        commands.append(config_set_runtime_pref_command("paper", "auto_screen_on_intake", args.auto_screen))
    if getattr(args, "quick_resource", None) is not None:
        resource_statement = str(args.quick_resource or "").strip()
        if not resource_statement:
            raise SystemExit("资源说明不能为空。")
        commands.append(config_set_profile_command("resources.quick_setup", resource_statement))
    quick_constraints = getattr(args, "quick_constraints", None)
    if quick_constraints is not None:
        profile = load_yaml(config_root(root) / "user-profile.yaml", default={})
        raw_existing = profile.get("constraints", []) if isinstance(profile, dict) else []
        existing = list(raw_existing) if isinstance(raw_existing, list) else []
        merged = list(existing)
        seen = {
            str(value).strip()
            for value in existing
            if isinstance(value, str) and str(value).strip()
        }
        for raw_constraint in quick_constraints:
            constraint = str(raw_constraint or "").strip()
            if not constraint:
                raise SystemExit("重要约束不能为空。")
            if constraint not in seen:
                merged.append(constraint)
                seen.add(constraint)
        if merged != existing:
            commands.append(
                config_set_profile_command(
                    "constraints",
                    json.dumps(merged, ensure_ascii=False),
                )
            )
    for key, value in persona_values:
        if value is not None:
            commands.append(config_set_profile_command(key, value))
    return commands


def _mapping_has_shape(payload: object, required: object) -> bool:
    if not isinstance(payload, dict) or not isinstance(required, dict):
        return False
    return all(
        key in payload
        and (
            not isinstance(required_value, dict)
            or _mapping_has_shape(payload[key], required_value)
        )
        for key, required_value in required.items()
    )


def _readable_mapping(path: Path) -> dict[str, object] | None:
    try:
        payload = load_yaml(path, default=None)
    except Exception:  # noqa: BLE001 - malformed config means init must repair
        return None
    return payload if isinstance(payload, dict) and payload else None


def _readable_text(path: Path) -> bool:
    try:
        return path.is_file() and bool(path.read_text(encoding="utf-8").strip())
    except (OSError, UnicodeError):
        return False


def workspace_init_complete(root: Path) -> bool:
    """Return whether plain ``kb init`` can be a strict no-churn no-op."""
    kb = kb_root(root)
    required_directories = [
        kb / "units" / unit_dir
        for unit_dir in ("papers", "repos", "datasets", "blogs", "ideas", "experiments")
    ] + [
        kb / "programs",
        kb / "user" / "reading-lists",
        kb / "user" / "report-materials",
        kb / "config",
        kb / "synthesis" / "source-search",
        kb / "raw",
        kb / "output",
        kb / ".runtime",
    ]
    if not all(path.is_dir() for path in required_directories):
        return False

    required_text_files = [
        kb / ".gitignore",
        kb / "index.md",
        kb / "config" / "research-settings.md",
        kb / "user" / "navigation.md",
        kb / "user" / "current-state.md",
    ]
    if not all(_readable_text(path) for path in required_text_files):
        return False

    index_payload = _readable_mapping(kb / "index.yaml")
    taxonomy = _readable_mapping(kb / "config" / "topic-taxonomy.yaml")
    pools = _readable_mapping(kb / "config" / "candidate-pools.yaml")
    runtime = _readable_mapping(kb / "config" / "runtime-preferences.yaml")
    profile = _readable_mapping(kb / "config" / "user-profile.yaml")
    if None in (index_payload, taxonomy, pools, runtime, profile):
        return False
    if not _mapping_has_shape(runtime, default_runtime_preferences()):
        return False
    required_profile_shape = {
        "id": None,
        "status": None,
        "generated_by": None,
        "generated_at": None,
        "inputs": None,
        "confidence": None,
        "preferences": {"language_preference": None},
        "resources": None,
        "constraints": None,
        "governance": {
            "default_candidate_pools": None,
            "topic_overrides": None,
            "tag_overrides": None,
        },
        "history": None,
    }
    return _mapping_has_shape(profile, required_profile_shape)


def run_init_prerequisites(root: Path) -> int:
    return run_forwarded(
        root,
        [
            (SCRIPT_BY_VERB["init_kb"], ["init"]),
            (SCRIPT_BY_VERB["init_config"], ["init"]),
        ],
        stream=False,
    )


def handle_init(args: argparse.Namespace, root: Path) -> int:
    commands = build_headless_init_pref_commands(args, root)
    initialized = 0 if workspace_init_complete(root) else run_init_prerequisites(root)
    if initialized != 0:
        print("知识库初始化未完成；详细诊断已保留给 Agent。", file=sys.stderr)
        return initialized

    if commands is not None:
        written = run_forwarded(root, commands, stream=False)
        if written != 0:
            print("基础偏好未能保存；详细诊断已保留给 Agent。", file=sys.stderr)
            return written

    if args.git_init:
        git_initialized = run_forwarded(
            root,
            [(SCRIPT_BY_VERB["init_kb"], ["git-init"])],
            stream=False,
        )
        if git_initialized != 0:
            print("版本记录未能启用；详细诊断已保留给 Agent。", file=sys.stderr)
            return git_initialized

    defaults = runtime_pref_defaults(root)
    if not defaults["name"] or is_ai_signer(defaults["name"]):
        print(
            "知识库基础结构已准备好，现在可以开始使用。是否花约 1 分钟完成快速设置？"
            "请回复“现在设置”（推荐）或“先跳过”；以后也可以直接说“补充我的研究偏好”。"
            f"{public_init_defaults_summary(defaults)}"
            "第一次确认研究判断前仍会询问真实署名。"
        )
        set_protocol_status("ready_with_optional_setup", initialized=True)
        add_agent_action(
            "offer_init_preferences",
            choices=[
                {"id": "configure_now", "label": "现在设置", "recommended": True},
                {"id": "defer", "label": "先跳过", "writes_preferences": False},
            ],
            quick_fields=[
                "human_name",
                "language_and_terminology",
                "research_focus",
                "resources_and_constraints",
            ],
            defaults=defaults,
            required_before={"judgement_confirmation": ["human_name"]},
            apply={
                "verb": "init",
                "mode": "headless",
                "field_inputs": {
                    "human_name": {"input": "--name"},
                    "language": {"input": "--lang", "choices": list(LANG_CHOICES)},
                    "terminology_style": {
                        "input": "--persona-term",
                        "choices": list(PERSONA_TERM_CHOICES),
                    },
                    "research_focus": {"input": "--persona-focus"},
                    "resource_statement": {"input": "--quick-resource"},
                    "constraints": {
                        "input": "--quick-constraint",
                        "repeatable": True,
                        "merge": "append_deduplicate",
                    },
                },
            },
            defer={
                "continue_with_defaults": True,
                "writes_preferences": False,
                "resume_phrases": ["补充我的研究偏好", "kb init"],
            },
        )
    else:
        print("知识库和基础偏好已准备好。")
        set_protocol_status("completed", initialized=True, preferences=defaults)
    if not args.git_init:
        add_agent_action("offer_version_history", apply={"verb": "init", "git_init": True})
    return 0


def build_review_list_args(fuzzy: str | None) -> list[str]:
    fuzzy_text = (fuzzy or "").strip()
    fuzzy_kind = fuzzy_text.lower()
    if not fuzzy_text:
        return ["review-queue"]
    if fuzzy_kind in REVIEW_KIND_CHOICES:
        return ["review-queue", "--kind", fuzzy_kind]
    return ["query", "--query", fuzzy_text, "--confirmation-status", "pending_user_confirmation"]


def load_review_records(root: Path, fuzzy: str | None) -> list[dict]:
    fuzzy_text = (fuzzy or "").strip()
    fuzzy_kind = fuzzy_text.lower()
    if fuzzy_kind in REVIEW_KIND_CHOICES:
        return search_records(root, "", kind=fuzzy_kind, confirmation_status="pending_user_confirmation")
    return search_records(root, fuzzy_text, confirmation_status="pending_user_confirmation")


_PUBLIC_CLAIM_TYPE_LABELS = {
    "fact": "事实",
    "inference": "推断",
    "evaluation": "评价",
    "user_opinion": "用户观点",
}


def public_review_projection(record: dict, root: Path) -> dict[str, object]:
    """Project the full confirmation receipt scope, classifying any block."""
    payload = record.get("payload")
    payload = payload if isinstance(payload, dict) else {}
    raw_claims = payload.get("claims")
    track = confirmation_track(record)
    fact_track = track == "fact"
    if raw_claims in (None, []):
        if not fact_track:
            return {"status": "invalid", "track": track, "claims": []}
        kind = PUBLIC_KIND_LABELS.get(str(record.get("kind") or ""), "知识资料")
        raw_summary = str(record.get("summary") or "").strip()
        if raw_summary:
            fallback = "该事实信息需由 Agent 安全解释"
            fact_summary = _public_display_text(raw_summary, root, fallback, 240)
            if fact_summary == fallback:
                return {"status": "unsafe", "track": "fact", "claims": []}
        else:
            fallback = "该事实信息需由 Agent 安全解释"
            title = _public_display_text(record.get("title") or "", root, fallback, 160)
            if title == fallback:
                return {"status": "unsafe", "track": "fact", "claims": []}
            fact_summary = f"资料标题为「{title}」，类型为{kind}。"
        return {
            "status": "ready",
            "track": "fact",
            "claims": [],
            "fact_summary": fact_summary,
        }
    if not isinstance(raw_claims, list) or any(not isinstance(item, dict) for item in raw_claims):
        return {"status": "invalid", "track": "judgement", "claims": []}

    canonical_claims = confirmation_claims(record)
    if len(canonical_claims) != len(raw_claims):
        return {"status": "invalid", "track": track, "claims": []}
    if validate_claims(canonical_claims):
        return {"status": "invalid", "track": track, "claims": []}
    judgement_track = track == "judgement"
    projected: list[dict[str, object]] = []
    unsafe_placeholder = "该内容需由 Agent 安全解释"
    structurally_invalid = False
    unsafe = False
    for claim in canonical_claims:
        status = str(claim.get("confirmation_status") or "").strip().lower()
        claim_id = str(claim.get("id") or "").strip()
        claim_type = str(claim.get("claim_type") or "").strip()
        raw_text = str(claim.get("text") or "").strip()
        refs = claim.get("evidence_refs")
        if (
            status not in CLAIM_CONFIRMATION_VALUES
            or not claim_id
            or claim_type not in _PUBLIC_CLAIM_TYPE_LABELS
            or not raw_text
            or not isinstance(refs, list)
            or any(not isinstance(ref, dict) for ref in refs)
        ):
            structurally_invalid = True
            continue
        quotes = [str(ref.get("quote") or "").strip() for ref in refs]
        if (judgement_track and not quotes) or any(not quote for quote in quotes):
            structurally_invalid = True
            continue
        text = _render_public_claim_text(raw_text, root)
        evidence_text = _sanitize_public_text(quotes[0], root) if quotes else ""
        if (
            text is None
            or len(text) > _PUBLIC_CLAIM_TEXT_HARD_CAP
            or (quotes and evidence_text is None)
        ):
            unsafe = True
            continue
        evidence = _bounded_public_text(evidence_text, 160) if evidence_text else ""
        projected.append(
            {
                "type_label": _PUBLIC_CLAIM_TYPE_LABELS[claim_type],
                "text": text,
                "evidence": evidence,
                "extra_evidence_count": len(quotes) - 1,
            }
        )
    if structurally_invalid:
        return {"status": "invalid", "track": track, "claims": []}
    if unsafe:
        return {"status": "unsafe", "track": track, "claims": []}
    if len(projected) != len(canonical_claims):
        return {"status": "invalid", "track": track, "claims": []}
    return {"status": "ready", "track": track, "claims": projected, "fact_summary": ""}


def print_review_item(record: dict, projection: Mapping[str, object], root: Path) -> None:
    raw_unit_id = str(record.get("id") or "-")
    unit_id = _public_display_text(raw_unit_id, root, "编号已隐藏", 100)
    kind = {
        "paper": "论文",
        "repo": "代码仓",
        "dataset": "数据集",
        "blog": "博客",
        "idea": "研究想法",
        "experiment": "实验",
    }.get(str(record.get("kind") or ""), "知识条目")
    title = _public_display_text(record.get("title") or "-", root, "标题需由 Agent 安全解释", 160)
    print(f"- {kind}「{title}」（{unit_id}）")
    fact_summary = str(projection.get("fact_summary") or "")
    if fact_summary:
        print(f"  待确认的事实信息：{fact_summary}")
    claims = projection.get("claims")
    claims = claims if isinstance(claims, list) else []
    if claims:
        print("  待确认内容：")
    for claim in claims:
        print(f"  - {claim['type_label']}：{claim['text']}")
        if claim.get("evidence"):
            print(f"    证据摘录（安全显示）：“{claim['evidence']}”")
        extra_count = _natural_count(claim.get("extra_evidence_count"))
        if extra_count:
            print(f"    另有 {extra_count} 条已核验证据。")


def build_review_apply_commands(
    root: Path,
    confirm_ids: Sequence[str],
    reject_ids: Sequence[str],
    evidence: str,
    *,
    user_authorization: str = "",
    authorization_source: str = "user_message",
) -> list[tuple[str, Sequence[str]]]:
    commands: list[tuple[str, Sequence[str]]] = []
    if confirm_ids:
        confirm_args: list[str] = ["confirm"]
        for unit_id in confirm_ids:
            confirm_args.extend(["--id", unit_id])
        actor = default_confirmed_by(root)
        if actor:
            confirm_args.extend(["--confirmed-by", actor])
        confirm_args.extend(["--evidence", evidence])
        if user_authorization:
            confirm_args.extend(["--user-authorization", user_authorization])
            confirm_args.extend(["--authorization-source", authorization_source])
        commands.append((SCRIPT_BY_VERB["review"], confirm_args))
    for unit_id in reject_ids:
        commands.append((SCRIPT_BY_VERB["review"], ["promote", "--id", unit_id, "--confirmation-status", "rejected"]))
    return commands


def handle_review(args: argparse.Namespace, root: Path) -> int:
    result = forward_command(
        root,
        SCRIPT_BY_VERB["review"],
        build_review_list_args(args.fuzzy),
        stream=False,
    )
    if result.returncode != 0:
        print("确认收件箱暂时无法读取；详细诊断已保留给 Agent。", file=sys.stderr)
        return result.returncode
    records = [record for record in load_review_records(root, args.fuzzy) if not _record_is_rejected(record)]
    ready_candidates = [record for record in records if is_ready_for_human_review(record)]
    pending: list[dict] = []
    projection_by_id: dict[str, dict[str, object]] = {}
    structurally_blocked: list[dict] = []
    unsafe_blocked: list[dict] = []
    for record in ready_candidates:
        projection = public_review_projection(record, root)
        if projection.get("status") == "invalid":
            structurally_blocked.append(record)
            continue
        if projection.get("status") == "unsafe":
            unsafe_blocked.append(record)
            continue
        pending.append(record)
        projection_by_id[str(record.get("id") or "")] = projection
    blocked = [*structurally_blocked, *unsafe_blocked]
    if pending:
        pending_ids = [str(record.get("id") or "") for record in pending]
        configured_actor = default_confirmed_by(root)
        confirmation_identity_required = not configured_actor or is_ai_signer(configured_actor)
        set_protocol_status(
            "needs_user_authorization",
            review_count=len(pending),
            record_ids=pending_ids,
            blocked_review_count=len(blocked),
            blocked_review_records=blocked,
            invalid_review_count=len(structurally_blocked),
            unsafe_review_count=len(unsafe_blocked),
            confirmation_identity_required=confirmation_identity_required,
        )
        add_agent_action(
            "present_review_items",
            records=pending,
            decision_fields=["decision", "user_authorization", "authorization_source", "evidence"],
            authorization_source="user_message",
        )
        if confirmation_identity_required:
            add_agent_action(
                "collect_confirmation_identity",
                when="user_confirms",
                required_fields=["human_name"],
                required_before="apply_confirmation",
                apply={
                    "verb": "init",
                    "mode": "headless",
                    "fields": ["human_name"],
                    "field_inputs": {"human_name": {"input": "--name"}},
                },
                then="apply_review_decision",
            )
        print(f"有 {len(pending)} 条待确认内容已经准备好：")
        for record in pending:
            print_review_item(record, projection_by_id[str(record.get("id") or "")], root)
        print("以上待确认内容已经过当前流程核验；以上内容需要你用自然语言确认或拒绝，在你拍板前不会写成已确认结论。")
        if confirmation_identity_required:
            print("如果你选择确认，确认前还需要你的真实署名。")
        if structurally_blocked:
            add_agent_action("repair_review_claims", records=structurally_blocked)
            print("另有判断缺少可确认的文本或证据，Agent 会先补全。")
        if unsafe_blocked:
            add_agent_action("explain_review_items_safely", records=unsafe_blocked)
            print("另有已核验内容不适合直接显示，请先让 Agent 安全解释。")
    elif blocked:
        set_protocol_status(
            "agent_action_required",
            review_count=0,
            blocked_review_count=len(blocked),
            blocked_review_records=blocked,
            invalid_review_count=len(structurally_blocked),
            unsafe_review_count=len(unsafe_blocked),
        )
        if structurally_blocked:
            add_agent_action("repair_review_claims", records=structurally_blocked)
        if unsafe_blocked:
            add_agent_action("explain_review_items_safely", records=unsafe_blocked)
        if structurally_blocked and unsafe_blocked:
            print("目前没有可供你安全确认的判断；请先让 Agent 安全解释相关内容，并补全缺失的判断文本或证据。")
        elif unsafe_blocked:
            print("目前没有可供你安全确认的判断；请先让 Agent 安全解释这些已核验内容。")
        else:
            print("目前没有可供你安全确认的判断；Agent 需要先补全判断文本或证据。")
    else:
        set_protocol_status(
            "completed",
            review_count=0,
            blocked_review_count=0,
            blocked_review_records=[],
            invalid_review_count=0,
            unsafe_review_count=0,
        )
        print("目前没有需要你确认的判断。")
    return 0


class ConversationalArgumentParser(argparse.ArgumentParser):
    """Keep parser mechanics private while preserving discoverable ``kb`` verbs."""

    def __init__(self, *args: object, **kwargs: object) -> None:
        include_help = bool(kwargs.pop("add_help", True))
        kwargs.setdefault("usage", argparse.SUPPRESS)
        super().__init__(*args, add_help=False, **kwargs)
        if include_help:
            self.add_argument("-h", "--help", action="help", help=argparse.SUPPRESS)

    def error(self, message: str) -> None:
        del message
        self.exit(2, "我没能理解这条 kb 请求。请使用 kb help 查看可用动词和示例。\n")

    def format_help(self) -> str:
        return render_help_menu()


def register_help(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("help", help="打印分组能力菜单")
    parser.set_defaults(handler=handle_help)


