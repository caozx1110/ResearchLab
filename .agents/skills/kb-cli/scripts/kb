#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from collections.abc import Callable, Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path

SCRIPT_PATH = Path(__file__).resolve()
for candidate in [SCRIPT_PATH.parent, *SCRIPT_PATH.parents]:
    lib = candidate / ".agents" / "lib"
    if lib.exists():
        sys.path.insert(0, str(lib))
        DEFAULT_PROJECT_ROOT = candidate
        break
else:
    raise SystemExit("Could not locate .agents/lib")

from research.bootstrap import ensure_managed_runtime, is_current_python, managed_venv_dir, managed_venv_python

if __name__ == "__main__":
    ensure_managed_runtime(DEFAULT_PROJECT_ROOT)

from research.common import add_project_root_argument, current_runtime_capabilities, find_project_root, load_yaml
from research.core import config_root, default_confirmed_by, is_ai_signer, load_runtime_preferences, search_records


