def register_next(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("next", help="查看下一步建议")
    parser.add_argument("program", nargs="?", metavar="<研究计划>", help="可选的研究计划名称或编号")
    parser.set_defaults(handler=handle_next)


def register_find(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("find", help="检索知识库")
    parser.add_argument("keywords", nargs="+", metavar="<关键词>", help="一个或多个检索关键词")
    parser.set_defaults(handler=handle_find)


def register_recall(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("recall", help="回忆习惯 / 已知坑 / skill 问题")
    parser.add_argument(
        "kind",
        nargs="?",
        choices=["all", "habits", "gotchas", "defects"],
        default="all",
        metavar="<回忆范围>",
        help="可选：全部、习惯、已知坑或待审问题",
    )
    parser.set_defaults(handler=handle_recall)


def register_undo(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("undo", help="撤销最近一次已提交的知识库操作")
    parser.set_defaults(handler=handle_undo)


def register_update(subparsers: argparse._SubParsersAction[argparse.ArgumentParser]) -> None:
    parser = subparsers.add_parser("update", help="检查并在确认后更新研究能力包")
    parser.add_argument("--apply", action="store_true", help=argparse.SUPPRESS)
